<Window x:Class="LeadManagement.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LeadManagement.Desktop"
        xmlns:views="clr-namespace:LeadManagement.Desktop.Views"
        xmlns:viewmodels="clr-namespace:LeadManagement.Desktop.ViewModels"
        mc:Ignorable="d"
        Title="Leads Management System" 
        Height="800" Width="1240"
        MinHeight="650" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource AppFontFamily}"
        Background="{StaticResource WindowBgBrush}">

    <Window.DataContext>
        <viewmodels:MainViewModel />
    </Window.DataContext>

    <Grid>
        <!-- 1. LOGIN SCREEN (Active when IsLoggedIn is False) -->
        <views:LoginView Loaded="LoginView_Loaded"
                         Visibility="{Binding IsLoginViewVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                         d:Visibility="Collapsed" />

        <!-- 2. ADMIN APPLICATION SHELL (Active when IsLoggedIn is True AND role is Admin) -->
        <Grid Visibility="{Binding IsAdminShellVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
              d:Visibility="Visible">

            <Grid.RowDefinitions>
                <RowDefinition Height="60" /> <!-- Fixed Top Navigation Bar -->
                <RowDefinition Height="*" />  <!-- Main Workspace (Sidebar + Content) -->
            </Grid.RowDefinitions>

            <!-- FIXED TOP NAVIGATION BAR -->
            <Border Grid.Row="0" Background="{StaticResource TopbarBgBrush}" BorderBrush="#334155" BorderThickness="0,0,0,1" Padding="20,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Application Branding, Sidebar Toggle & Title -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Sidebar Collapse/Expand Toggle Button (Hamburger) -->
                        <Button Command="{Binding ToggleSidebarCommand}"
                                Style="{StaticResource NavToggleButtonStyle}"
                                ToolTip="Toggle Sidebar (Expand / Collapse)"
                                Margin="0,0,14,0">
                            <TextBlock Text="☰" FontSize="16" Foreground="#CBD5E1" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Button>

                        <Border 
                            CornerRadius="8"
                            Width="48"
                            Height="42"
                            Background="Transparent"
                            HorizontalAlignment="Center"
                            Margin="0,0,10,0"
                            ClipToBounds="True">

                            <Image Source="/Assets/vas-logo-nobg.png"
                                   Stretch="UniformToFill" Height="42" VerticalAlignment="Top" />   
                        </Border>
                        <TextBlock Text="Leads Management System" FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />

                        <!-- Admin Badge -->
                        <Border Background="#1E3A8A" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="10" Padding="8,2" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="👑 ADMINISTRATOR" FontSize="10.5" FontWeight="Bold" Foreground="#93C5FD" />
                        </Border>
                    </StackPanel>

                    <!-- Right Top Navigation: Status & User Session -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- User Profile Chip -->
                        <Border Background="#334155" CornerRadius="6" Padding="10,6" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="👤 " FontSize="12" Foreground="#F8FAFC" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ActiveUser}" Foreground="#F8FAFC" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Sign Out Button -->
                        <Button Content="Sign Out" 
                                Command="{Binding LogoutCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Foreground="#CBD5E1"
                                BorderBrush="#475569"
                                Padding="12,6"
                                FontSize="12" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- MAIN WORKSPACE: SIDEBAR + CONTENT REGION -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" /> <!-- Responsive Navigation Sidebar -->
                    <ColumnDefinition Width="*" />    <!-- Main Content Area -->
                </Grid.ColumnDefinitions>

                <!-- LEFT NAVIGATION SIDEBAR (BUTTON STACK) -->
                <Border Grid.Column="0" 
                        Width="{Binding SidebarWidth}"
                        Background="{StaticResource SidebarBgBrush}" 
                        BorderBrush="#334155" 
                        BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Navigation Section Title (Hidden when sidebar is collapsed) -->
                        <TextBlock Grid.Row="0" 
                                   Text="MAIN NAVIGATION" 
                                   FontSize="11" 
                                   FontWeight="SemiBold" 
                                   Foreground="#64748B" 
                                   Margin="20,20,20,10">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Sidebar Button Stack -->
                        <StackPanel Grid.Row="1">
                            <!-- 1. Dashboard Button -->
                            <Button Command="{Binding NavigateCommand}" 
                                    CommandParameter="Dashboard"
                                    ToolTip="Dashboard (Live Performance &amp; KPIs)">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentView}" Value="Dashboard">
                                                <Setter Property="Tag" Value="Active" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="📊" FontSize="15" Width="26" TextAlignment="Center" VerticalAlignment="Center" />
                                    <TextBlock Text="Dashboard" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Button>

                            <!-- 2. Lead Masterlist Button -->
                            <Button Command="{Binding NavigateCommand}" 
                                    CommandParameter="LeadMasterlist"
                                    ToolTip="Lead Masterlist (Search &amp; Manage Records)">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentView}" Value="LeadMasterlist">
                                                <Setter Property="Tag" Value="Active" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="📋" FontSize="15" Width="26" TextAlignment="Center" VerticalAlignment="Center" />
                                    <TextBlock Text="Leads Masterlist" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Button>

                            <!-- 3. Import Leads Button -->
                            <Button Command="{Binding NavigateCommand}" 
                                    CommandParameter="ImportLeads"
                                    ToolTip="Import Leads (CSV / Excel Upload)">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentView}" Value="ImportLeads">
                                                <Setter Property="Tag" Value="Active" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="📥" FontSize="15" Width="26" TextAlignment="Center" VerticalAlignment="Center" />
                                    <TextBlock Text="Import Leads" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Button>

                            <!-- 4. Import History Button -->
                            <Button Command="{Binding NavigateCommand}" 
                                    CommandParameter="ImportHistory"
                                    ToolTip="Import History (Audit Trail &amp; Batches)">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentView}" Value="ImportHistory">
                                                <Setter Property="Tag" Value="Active" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="📜" FontSize="15" Width="26" TextAlignment="Center" VerticalAlignment="Center" />
                                    <TextBlock Text="Import History" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Button>

                            <!-- 5. Manage Clients Button -->
                            <Button Command="{Binding NavigateCommand}" 
                                    CommandParameter="ManageClients"
                                    ToolTip="Manage Clients (Add Clients &amp; Upload Lead Files)">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentView}" Value="ManageClients">
                                                <Setter Property="Tag" Value="Active" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="📂" FontSize="15" Width="26" TextAlignment="Center" VerticalAlignment="Center" />
                                    <TextBlock Text="Manage Clients" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Button>

                            <!-- 6. User Management Button -->
                            <Button Command="{Binding NavigateCommand}" 
                                    CommandParameter="UserManagement"
                                    ToolTip="User Management (Add &amp; Manage Accounts)">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentView}" Value="UserManagement">
                                                <Setter Property="Tag" Value="Active" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="👥" FontSize="15" Width="26" TextAlignment="Center" VerticalAlignment="Center" />
                                    <TextBlock Text="User Accounts" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Button>

                            <!-- Subtle Divider -->
                            <Rectangle Height="1" Fill="#1E293B" Margin="14,14" />

                            <!-- 6. Settings Button -->
                            <Button Command="{Binding NavigateCommand}" 
                                    CommandParameter="Settings"
                                    ToolTip="System Settings &amp; Configuration">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentView}" Value="Settings">
                                                <Setter Property="Tag" Value="Active" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="⚙️" FontSize="15" Width="26" TextAlignment="Center" VerticalAlignment="Center" />
                                    <TextBlock Text="Settings" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Sidebar Footer Info -->
                        <Border Grid.Row="2" Background="#0A0F1D" Padding="14,12">
                            <Grid>
                                <!-- Expanded footer details -->
                                <StackPanel>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="Virtual Assistant Services Outsourcing" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" />
                                    <TextBlock Text="2026" FontSize="10" Foreground="#475569" Margin="0,2,0,0" />
                                </StackPanel>

                                <!-- Collapsed footer mini badge -->
                                <TextBlock Text="⚡" 
                                           FontSize="13" 
                                           Foreground="#64748B" 
                                           HorizontalAlignment="Center"
                                           ToolTip="Lead Management System • .NET 10">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- MAIN CONTENT AREA (DYNAMIC VIEW HOST) -->
                <Grid Grid.Column="1" Background="{StaticResource WindowBgBrush}">
                    <!-- 1. Dashboard View -->
                    <views:DashboardView Loaded="DashboardView_Loaded">
                        <views:DashboardView.Style>
                            <Style TargetType="UserControl">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentView}" Value="Dashboard">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </views:DashboardView.Style>
                    </views:DashboardView>

                    <!-- 2. Lead Masterlist View -->
                    <views:LeadMasterlistView DataContext="{Binding Masterlist}">
                        <views:LeadMasterlistView.Style>
                            <Style TargetType="UserControl">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.CurrentView, RelativeSource={RelativeSource AncestorType=Window}}" Value="LeadMasterlist">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </views:LeadMasterlistView.Style>
                    </views:LeadMasterlistView>

                    <!-- 3. Import Leads View -->
                    <views:ImportLeadsView DataContext="{Binding ImportLeads}">
                        <views:ImportLeadsView.Style>
                            <Style TargetType="UserControl">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.CurrentView, RelativeSource={RelativeSource AncestorType=Window}}" Value="ImportLeads">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </views:ImportLeadsView.Style>
                    </views:ImportLeadsView>

                    <!-- 4. Import History View -->
                    <views:ImportHistoryView DataContext="{Binding ImportHistory}">
                        <views:ImportHistoryView.Style>
                            <Style TargetType="UserControl">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.CurrentView, RelativeSource={RelativeSource AncestorType=Window}}" Value="ImportHistory">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </views:ImportHistoryView.Style>
                    </views:ImportHistoryView>

                    <!-- 5. User Management View -->
                    <views:UserManagementView DataContext="{Binding UserManagement}">
                        <views:UserManagementView.Style>
                            <Style TargetType="UserControl">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.CurrentView, RelativeSource={RelativeSource AncestorType=Window}}" Value="UserManagement">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </views:UserManagementView.Style>
                    </views:UserManagementView>

                    <!-- 6. Manage Clients View -->
                    <views:ManageClientsView DataContext="{Binding ManageClients}">
                        <views:ManageClientsView.Style>
                            <Style TargetType="UserControl">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.CurrentView, RelativeSource={RelativeSource AncestorType=Window}}" Value="ManageClients">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </views:ManageClientsView.Style>
                    </views:ManageClientsView>

                    <!-- 7. Settings View -->
                    <views:SettingsView>
                        <views:SettingsView.Style>
                            <Style TargetType="UserControl">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentView}" Value="Settings">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </views:SettingsView.Style>
                    </views:SettingsView>
                </Grid>
            </Grid>
        </Grid>

        <!-- 3. USER / AGENT APPLICATION SHELL (Active when IsLoggedIn is True AND role is User) -->
        <views:UserShellView Visibility="{Binding IsUserShellVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                             d:Visibility="Collapsed" />

    </Grid>
</Window>
