<UserControl x:Class="LeadManagement.Desktop.Views.LeadMasterlistView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodels="clr-namespace:LeadManagement.Desktop.ViewModels"
             xmlns:controls="clr-namespace:LeadManagement.Desktop.Controls"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=viewmodels:LeadMasterlistViewModel, IsDesignTimeCreatable=True}"
             d:DesignHeight="800" d:DesignWidth="1200"
             FontFamily="{StaticResource AppFontFamily}">

    <!-- FIXED VIEWPORT GRID: Row 0 Header/Filters, Row 1 Scrollable Table, Row 2 Inspection Footer -->
    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Header & Search/Filters Toolbar (Fixed) -->
            <RowDefinition Height="*" />    <!-- Main Leads Table (Scrolls Internally) -->
            <RowDefinition Height="Auto" /> <!-- Selected Lead Inspection Drawer / Status (Fixed) -->
        </Grid.RowDefinitions>

        <!-- ========================================== -->
        <!-- ROW 0: PAGE HEADER & SEARCH / FILTER CARD  -->
        <!-- ========================================== -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <!-- Top Action Header -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Title & Meta Badges -->
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Lead Masterlist" 
                                   FontSize="24" 
                                   FontWeight="Bold" 
                                   Foreground="{StaticResource TextPrimaryBrush}" 
                                   VerticalAlignment="Center" />

                        <!-- Dynamic Record Counter Badge -->
                        <Border Background="#E0F2FE" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="10" Padding="10,3" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ShowingCountText}" FontSize="11.5" Foreground="#0284C7" FontWeight="SemiBold" />
                        </Border>
                    </StackPanel>

                    <TextBlock Text="Central database of all verified business accounts, contacts, and inquiry statuses." 
                               FontSize="13" 
                               Foreground="{StaticResource TextSecondaryBrush}" 
                               Margin="0,4,0,0" />
                </StackPanel>

                <!-- Quick Action Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="⟳ Refresh" 
                            Command="{Binding RefreshCommand}" 
                            Style="{StaticResource SecondaryButtonStyle}" 
                            Padding="14,8" 
                            Margin="0,0,8,0"
                            ToolTip="Reload leads from database" />

                    <Button Content="{Binding ExportFilteredButtonText}" 
                            Command="{Binding ExportFilteredCommand}" 
                            Style="{StaticResource PrimaryButtonStyle}"
                            Padding="14,8" 
                            Margin="0,0,8,0"
                            ToolTip="Export currently filtered leads to Excel (.xlsx)" />

                    <Button Content="{Binding ExportAllButtonText}" 
                            Command="{Binding ExportAllCommand}" 
                            Style="{StaticResource PrimaryButtonStyle}"
                            Padding="14,8" 
                            ToolTip="Export all leads in the master database to Excel (.xlsx)" />
                </StackPanel>
            </Grid>

            <!-- Search & Multi-Filter Card -->
            <Border Style="{StaticResource CardBorderStyle}" Padding="16,14">
                <StackPanel>
                    <!-- Row 1: Search Bar & Reset Button -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- 1. Real-time Search Box -->
                        <Grid Grid.Column="0" Margin="0,0,12,0">
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource ModernTextBoxStyle}" 
                                     Padding="36,9,12,9" />
                            <!-- Search Icon -->
                            <TextBlock Text="🔍" 
                                       Foreground="#94A3B8" 
                                       FontSize="13" 
                                       VerticalAlignment="Center" 
                                       HorizontalAlignment="Left" 
                                       Margin="12,0,0,0" 
                                       IsHitTestVisible="False" />
                            <!-- Ghost Placeholder Text when empty -->
                            <TextBlock Text="Search by business name, contact, phone, city, county, NAICS, title..." 
                                       Foreground="#94A3B8" 
                                       FontSize="13" 
                                       VerticalAlignment="Center" 
                                       Margin="38,0,0,0" 
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SearchText}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SearchText}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <!-- Reset Filters Button -->
                        <Button Grid.Column="1" 
                                Content="✕ Reset Filters" 
                                Command="{Binding ClearFiltersCommand}" 
                                Style="{StaticResource SecondaryButtonStyle}" 
                                Padding="14,8"
                                ToolTip="Clear all search terms and reset all dropdown filters" />
                    </Grid>

                    <!-- Row 2: Location & Status Filters (4 Columns) — Multi-Select Checkboxes -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- City (multi-select) -->
                        <controls:MultiSelectDropdown Grid.Column="0"
                                  ItemsSource="{Binding CityItems}"
                                  HeaderText="All Cities"
                                  Margin="0,0,8,0"
                                  ToolTip="Filter by City — select multiple cities" />

                        <!-- County (multi-select) -->
                        <controls:MultiSelectDropdown Grid.Column="1"
                                  ItemsSource="{Binding CountyItems}"
                                  HeaderText="All Counties"
                                  Margin="0,0,8,0"
                                  ToolTip="Filter by County — select multiple counties" />

                        <!-- State (multi-select) -->
                        <controls:MultiSelectDropdown Grid.Column="2"
                                  ItemsSource="{Binding StateItems}"
                                  HeaderText="All States"
                                  Margin="0,0,8,0"
                                  ToolTip="Filter by State — select multiple states" />

                        <!-- Status (multi-select) -->
                        <controls:MultiSelectDropdown Grid.Column="3"
                                  ItemsSource="{Binding StatusItems}"
                                  HeaderText="All Statuses"
                                  ToolTip="Filter by Lead Status — select multiple statuses" />
                    </Grid>

                    <!-- Row 3: Demographics & Classification Filters (4 Columns) — Multi-Select Checkboxes -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Industry / SIC Description (multi-select) -->
                        <controls:MultiSelectDropdown Grid.Column="0"
                                  ItemsSource="{Binding IndustryItems}"
                                  HeaderText="All Industries"
                                  Margin="0,0,8,0"
                                  ToolTip="Filter by Industry (SIC Description) — select multiple" />

                        <!-- Annual Sales (multi-select) -->
                        <controls:MultiSelectDropdown Grid.Column="1"
                                  ItemsSource="{Binding AnnualSalesItems}"
                                  HeaderText="All Sales Ranges"
                                  Margin="0,0,8,0"
                                  ToolTip="Filter by Annual Sales Range — select multiple" />

                        <!-- NAICS Code (multi-select) -->
                        <controls:MultiSelectDropdown Grid.Column="2"
                                  ItemsSource="{Binding NaicsCodeItems}"
                                  HeaderText="All NAICS Codes"
                                  Margin="0,0,8,0"
                                  ToolTip="Filter by NAICS Code — select multiple" />

                        <!-- NAICS Description (multi-select) -->
                        <controls:MultiSelectDropdown Grid.Column="3"
                                  ItemsSource="{Binding NaicsDescItems}"
                                  HeaderText="All NAICS Descriptions"
                                  ToolTip="Filter by NAICS Description — select multiple" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ============================================================= -->
        <!-- ROW 1: MASTER TABLE (Fixed in page, scrollable inside)       -->
        <!-- ============================================================= -->
        <Border Grid.Row="1" 
                Style="{StaticResource CardBorderStyle}" 
                Padding="0" 
                ClipToBounds="True">
            <DataGrid ItemsSource="{Binding FilteredLeads}"     
                      SelectedItem="{Binding SelectedLead, Mode=TwoWay}"
                      Style="{StaticResource ModernDataGridStyle}"
                      EnableRowVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      GridLinesVisibility="None"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto">
                <DataGrid.Columns>

                    <!-- Status Column (Retained & Highlighted) -->
                    <DataGridTemplateColumn Header="STATUS" Width="120" CanUserSort="True" SortMemberPath="Status">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="12" Padding="10,4" BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#EFF6FF" />
                                            <Setter Property="BorderBrush" Value="#BFDBFE" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Qualified">
                                                    <Setter Property="Background" Value="#ECFDF5" />
                                                    <Setter Property="BorderBrush" Value="#A7F3D0" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Follow-up">
                                                    <Setter Property="Background" Value="#FFFBEB" />
                                                    <Setter Property="BorderBrush" Value="#FDE68A" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Contacted">
                                                    <Setter Property="Background" Value="#F5F3FF" />
                                                    <Setter Property="BorderBrush" Value="#DDD6FE" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#1D4ED8" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Qualified">
                                                        <Setter Property="Foreground" Value="#047857" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Follow-up">
                                                        <Setter Property="Foreground" Value="#B45309" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Contacted">
                                                        <Setter Property="Foreground" Value="#6D28D9" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Column A: Business Name -->
                    <DataGridTemplateColumn Header="BUSINESS NAME" Width="220" CanUserSort="True" SortMemberPath="BusinessName">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding BusinessName}" 
                                           FontWeight="SemiBold" 
                                           Foreground="{StaticResource TextPrimaryBrush}" 
                                           FontSize="12.5" 
                                           VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Column B: Address -->
                    <DataGridTextColumn Header="ADDRESS" 
                                        Binding="{Binding Address}" 
                                        Width="190" 
                                        CanUserSort="True" />

                    <!-- Column C: City -->
                    <DataGridTextColumn Header="CITY" 
                                        Binding="{Binding City}" 
                                        Width="125" 
                                        CanUserSort="True" />

                    <!-- Column D: County -->
                    <DataGridTextColumn Header="COUNTY" 
                                        Binding="{Binding County}" 
                                        Width="125" 
                                        CanUserSort="True" />

                    <!-- Column E: State -->
                    <DataGridTextColumn Header="STATE" 
                                        Binding="{Binding State}" 
                                        Width="75" 
                                        CanUserSort="True" />

                    <!-- Column F: Zip Code -->
                    <DataGridTextColumn Header="ZIP CODE" 
                                        Binding="{Binding ZipCode}" 
                                        Width="95" 
                                        CanUserSort="True" />

                    <!-- Column G: Cell Number -->
                    <DataGridTemplateColumn Header="CELL NUMBER" Width="140" CanUserSort="True" SortMemberPath="CellNumber">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="📞 " FontSize="10" Foreground="#64748B" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding FormattedPhone}" 
                                               FontFamily="Consolas, Segoe UI" 
                                               Foreground="{StaticResource TextPrimaryBrush}" 
                                               FontSize="12" 
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Column H: FAX -->
                    <DataGridTextColumn Header="FAX" 
                                        Binding="{Binding Fax}" 
                                        Width="110" 
                                        CanUserSort="True" />

                    <!-- Column I: Annual Sales -->
                    <DataGridTextColumn Header="ANNUAL SALES" 
                                        Binding="{Binding AnnualSales}" 
                                        Width="145" 
                                        CanUserSort="True" />

                    <!-- Column J: Number Of Employee -->
                    <DataGridTextColumn Header="NUMBER OF EMPLOYEE" 
                                        Binding="{Binding NumberOfEmployees}" 
                                        Width="165" 
                                        CanUserSort="True" />

                    <!-- Column K: Title -->
                    <DataGridTextColumn Header="TITLE" 
                                        Binding="{Binding Title}" 
                                        Width="150" 
                                        CanUserSort="True" />

                    <!-- Column L: Contact Name -->
                    <DataGridTextColumn Header="CONTACT NAME" 
                                        Binding="{Binding ContactName}" 
                                        Width="180" 
                                        CanUserSort="True" />

                    <!-- Column M: Website -->
                    <DataGridTemplateColumn Header="WEBSITE" Width="160" CanUserSort="True" SortMemberPath="Website">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid VerticalAlignment="Center">
                                    <TextBlock x:Name="LinkBlock" FontSize="12" TextTrimming="CharacterEllipsis">
                                        <Hyperlink Foreground="#2563EB" TextDecorations="None">
                                            <Run Text="{Binding Website}" />
                                        </Hyperlink>
                                    </TextBlock>
                                    <TextBlock x:Name="DashBlock" Text="—" Foreground="#94A3B8" FontSize="12" Visibility="Collapsed" />
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Website}" Value="">
                                        <Setter TargetName="LinkBlock" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="DashBlock" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Website}" Value="{x:Null}">
                                        <Setter TargetName="LinkBlock" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="DashBlock" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Column N: SIC Code -->
                    <DataGridTextColumn Header="SIC CODE" 
                                        Binding="{Binding SicCode}" 
                                        Width="110" 
                                        CanUserSort="True" />

                    <!-- Column O: SIC Description -->
                    <DataGridTextColumn Header="SIC DESCRIPTION" 
                                        Binding="{Binding SicDescription}" 
                                        Width="200" 
                                        CanUserSort="True" />

                    <!-- Column P: NAICS Code -->
                    <DataGridTextColumn Header="NAICS CODE" 
                                        Binding="{Binding NaicsCode}" 
                                        Width="110" 
                                        CanUserSort="True" />

                    <!-- Column Q: NAICS Description -->
                    <DataGridTextColumn Header="NAICS DESCRIPTION" 
                                        Binding="{Binding NaicsDescription}" 
                                        Width="220" 
                                        CanUserSort="True" />

                </DataGrid.Columns>
            </DataGrid>
        </Border>
 

    </Grid>
</UserControl>
