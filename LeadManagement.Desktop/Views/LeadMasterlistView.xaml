<UserControl x:Class="LeadManagement.Desktop.Views.LeadMasterlistView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodels="clr-namespace:LeadManagement.Desktop.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=viewmodels:LeadMasterlistViewModel, IsDesignTimeCreatable=True}"
             d:DesignHeight="800" d:DesignWidth="1200"
             FontFamily="{StaticResource AppFontFamily}">

    <!-- FIXED VIEWPORT GRID: Row 0 Header/Filters, Row 1 Scrollable Table, Row 2 Inspection Footer -->
    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Header & Search/Filters Toolbar (Fixed) -->
            <RowDefinition Height="*" />    <!-- Main Leads Table (Scrolls Internally) -->
            <RowDefinition Height="Auto" /> <!-- Selected Lead Inspection Drawer / Status (Fixed) -->
        </Grid.RowDefinitions>

        <!-- ========================================== -->
        <!-- ROW 0: PAGE HEADER & SEARCH / FILTER CARD  -->
        <!-- ========================================== -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <!-- Top Action Header -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Title & Meta Badges -->
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Lead Masterlist" 
                                   FontSize="24" 
                                   FontWeight="Bold" 
                                   Foreground="{StaticResource TextPrimaryBrush}" 
                                   VerticalAlignment="Center" />

                         
                    </StackPanel>

                    <TextBlock Text="Central database of all verified business accounts, contacts, and inquiry statuses." 
                               FontSize="13" 
                               Foreground="{StaticResource TextSecondaryBrush}" 
                               Margin="0,4,0,0" />
                </StackPanel>

                <!-- Quick Action Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="⟳ Refresh" 
                            Command="{Binding RefreshCommand}" 
                            Style="{StaticResource SecondaryButtonStyle}" 
                            Padding="14,8" 
                            Margin="0,0,8,0"
                            ToolTip="Reload leads from local database" />

                    <Button Content="⤓ Export CSV" 
                            Command="{Binding ExportCommand}" 
                            Style="{StaticResource SecondaryButtonStyle}" 
                            Padding="14,8" 
                            Margin="0,0,8,0"
                            ToolTip="Export filtered table to CSV file" />

                    <Button Content="+ New Lead" 
                            Style="{StaticResource PrimaryButtonStyle}" 
                            Padding="16,8"
                            ToolTip="Register a new lead manually" />
                </StackPanel>
            </Grid>

            <!-- Search & Multi-Filter Card -->
            <Border Style="{StaticResource CardBorderStyle}" Padding="16,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />   <!-- Search Bar -->
                        <ColumnDefinition Width="140" />  <!-- City Filter -->
                        <ColumnDefinition Width="160" />  <!-- Industry Filter -->
                        <ColumnDefinition Width="140" />  <!-- Status Filter -->
                        <ColumnDefinition Width="Auto" /> <!-- Reset Button -->
                    </Grid.ColumnDefinitions>

                    <!-- 1. Real-time Search Box -->
                    <Grid Grid.Column="0" Margin="0,0,12,0">
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource ModernTextBoxStyle}" 
                                 Padding="36,9,12,9" />
                        <!-- Search Icon -->
                        <TextBlock Text="🔍" 
                                   Foreground="#94A3B8" 
                                   FontSize="13" 
                                   VerticalAlignment="Center" 
                                   HorizontalAlignment="Left" 
                                   Margin="12,0,0,0" 
                                   IsHitTestVisible="False" />
                        <!-- Ghost Placeholder Text when empty -->
                        <TextBlock Text="Search by business name, contact, phone, city, title..." 
                                   Foreground="#94A3B8" 
                                   FontSize="13" 
                                   VerticalAlignment="Center" 
                                   Margin="38,0,0,0" 
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchText}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SearchText}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <!-- 2. City Filter Dropdown -->
                    <ComboBox Grid.Column="1" 
                              ItemsSource="{Binding Cities}" 
                              SelectedItem="{Binding SelectedCity}" 
                              Style="{StaticResource ModernComboBoxStyle}" 
                              Margin="0,0,12,0" 
                              ToolTip="Filter by City" />

                    <!-- 3. Industry / SIC Filter Dropdown -->
                    <ComboBox Grid.Column="2" 
                              ItemsSource="{Binding Industries}" 
                              SelectedItem="{Binding SelectedIndustry}" 
                              Style="{StaticResource ModernComboBoxStyle}" 
                              Margin="0,0,12,0" 
                              ToolTip="Filter by Industry" />

                    <!-- 4. Status Filter Dropdown -->
                    <ComboBox Grid.Column="3" 
                              ItemsSource="{Binding Statuses}" 
                              SelectedItem="{Binding SelectedStatus}" 
                              Style="{StaticResource ModernComboBoxStyle}" 
                              Margin="0,0,12,0" 
                              ToolTip="Filter by Lead Status" />

                    <!-- 5. Reset Filters Button -->
                    <Button Grid.Column="4" 
                            Content="✕ Reset" 
                            Command="{Binding ClearFiltersCommand}" 
                            Style="{StaticResource SecondaryButtonStyle}" 
                            Padding="12,8"
                            ToolTip="Clear all search terms and dropdown filters" />
                </Grid>
            </Border>
        </StackPanel>

        <!-- ============================================================= -->
        <!-- ROW 1: MASTER TABLE (Fixed in page, scrollable inside)       -->
        <!-- ============================================================= -->
        <Border Grid.Row="1" 
                Style="{StaticResource CardBorderStyle}" 
                Padding="0" 
                ClipToBounds="True">
            <DataGrid ItemsSource="{Binding FilteredLeads}"     
                      SelectedItem="{Binding SelectedLead, Mode=TwoWay}"
                      Style="{StaticResource ModernDataGridStyle}"
                      GridLinesVisibility="None"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto" SelectionChanged="DataGrid_SelectionChanged">
                <DataGrid.Columns>

                    <!-- Status Column (Retained & Highlighted) -->
                    <DataGridTemplateColumn Header="STATUS" Width="120" CanUserSort="True" SortMemberPath="Status">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="12" Padding="10,4" BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#EFF6FF" />
                                            <Setter Property="BorderBrush" Value="#BFDBFE" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Qualified">
                                                    <Setter Property="Background" Value="#ECFDF5" />
                                                    <Setter Property="BorderBrush" Value="#A7F3D0" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Follow-up">
                                                    <Setter Property="Background" Value="#FFFBEB" />
                                                    <Setter Property="BorderBrush" Value="#FDE68A" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Contacted">
                                                    <Setter Property="Background" Value="#F5F3FF" />
                                                    <Setter Property="BorderBrush" Value="#DDD6FE" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#1D4ED8" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Qualified">
                                                        <Setter Property="Foreground" Value="#047857" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Follow-up">
                                                        <Setter Property="Foreground" Value="#B45309" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Contacted">
                                                        <Setter Property="Foreground" Value="#6D28D9" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Column A: Business Name -->
                    <DataGridTemplateColumn Header="BUSINESS NAME" Width="220" CanUserSort="True" SortMemberPath="BusinessName">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding BusinessName}" 
                                           FontWeight="SemiBold" 
                                           Foreground="{StaticResource TextPrimaryBrush}" 
                                           FontSize="12.5" 
                                           VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Column B: Address -->
                    <DataGridTextColumn Header="ADDRESS" 
                                        Binding="{Binding Address}" 
                                        Width="190" 
                                        CanUserSort="True" />

                    <!-- Column C: City -->
                    <DataGridTextColumn Header="CITY" 
                                        Binding="{Binding City}" 
                                        Width="125" 
                                        CanUserSort="True" />

                    <!-- Column D: County -->
                    <DataGridTextColumn Header="COUNTY" 
                                        Binding="{Binding County}" 
                                        Width="125" 
                                        CanUserSort="True" />

                    <!-- Column E: State -->
                    <DataGridTextColumn Header="STATE" 
                                        Binding="{Binding State}" 
                                        Width="75" 
                                        CanUserSort="True" />

                    <!-- Column F: Zip Code -->
                    <DataGridTextColumn Header="ZIP CODE" 
                                        Binding="{Binding ZipCode}" 
                                        Width="95" 
                                        CanUserSort="True" />

                    <!-- Column G: Cell Number -->
                    <DataGridTemplateColumn Header="CELL NUMBER" Width="140" CanUserSort="True" SortMemberPath="CellNumber">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="📞 " FontSize="10" Foreground="#64748B" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding FormattedPhone}" 
                                               FontFamily="Consolas, Segoe UI" 
                                               Foreground="{StaticResource TextPrimaryBrush}" 
                                               FontSize="12" 
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Column H: FAX -->
                    <DataGridTextColumn Header="FAX" 
                                        Binding="{Binding Fax}" 
                                        Width="110" 
                                        CanUserSort="True" />

                    <!-- Column I: Annual Sales -->
                    <DataGridTextColumn Header="ANNUAL SALES" 
                                        Binding="{Binding AnnualSales}" 
                                        Width="145" 
                                        CanUserSort="True" />

                    <!-- Column J: Number Of Employee -->
                    <DataGridTextColumn Header="NUMBER OF EMPLOYEE" 
                                        Binding="{Binding NumberOfEmployees}" 
                                        Width="165" 
                                        CanUserSort="True" />

                    <!-- Column K: Title -->
                    <DataGridTextColumn Header="TITLE" 
                                        Binding="{Binding Title}" 
                                        Width="150" 
                                        CanUserSort="True" />

                    <!-- Column L: Contact Name -->
                    <DataGridTextColumn Header="CONTACT NAME" 
                                        Binding="{Binding ContactName}" 
                                        Width="180" 
                                        CanUserSort="True" />

                    <!-- Column M: Website -->
                    <DataGridTemplateColumn Header="WEBSITE" Width="160" CanUserSort="True" SortMemberPath="Website">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock VerticalAlignment="Center">
                                    <Hyperlink Foreground="#2563EB" TextDecorations="None">
                                        <TextBlock Text="{Binding Website}" FontSize="12" />
                                    </Hyperlink>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Website}" Value="">
                                                    <Setter Property="Text" Value="—" />
                                                    <Setter Property="Foreground" Value="#94A3B8" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Website}" Value="{x:Null}">
                                                    <Setter Property="Text" Value="—" />
                                                    <Setter Property="Foreground" Value="#94A3B8" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Column N: SIC Code -->
                    <DataGridTextColumn Header="SIC CODE" 
                                        Binding="{Binding SicCode}" 
                                        Width="110" 
                                        CanUserSort="True" />

                    <!-- Column O: SIC Description -->
                    <DataGridTextColumn Header="SIC DESCRIPTION" 
                                        Binding="{Binding SicDescription}" 
                                        Width="200" 
                                        CanUserSort="True" />

                    <!-- Column P: NAICS Code -->
                    <DataGridTextColumn Header="NAICS CODE" 
                                        Binding="{Binding NaicsCode}" 
                                        Width="110" 
                                        CanUserSort="True" />

                    <!-- Column Q: NAICS Description -->
                    <DataGridTextColumn Header="NAICS DESCRIPTION" 
                                        Binding="{Binding NaicsDescription}" 
                                        Width="220" 
                                        CanUserSort="True" />

                </DataGrid.Columns>
            </DataGrid>
        </Border>
 

    </Grid>
</UserControl>
