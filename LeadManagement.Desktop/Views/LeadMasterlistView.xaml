<UserControl x:Class="LeadManagement.Desktop.Views.LeadMasterlistView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodels="clr-namespace:LeadManagement.Desktop.ViewModels"
             xmlns:models="clr-namespace:LeadManagement.Desktop.Models"
             xmlns:controls="clr-namespace:LeadManagement.Desktop.Controls"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=viewmodels:LeadMasterlistViewModel, IsDesignTimeCreatable=True}"
             d:DesignHeight="800" d:DesignWidth="1200"
             FontFamily="{StaticResource AppFontFamily}">

    <UserControl.Resources>
        <!-- Zoom Call icon button style (Green dial button) -->
        <Style x:Key="CallIconButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Background" Value="#10B981"/>
            <Setter Property="BorderBrush" Value="#059669"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip" Value="Call via Zoom Phone"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#059669"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#047857"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#047857"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- FIXED VIEWPORT GRID: Row 0 Header/Filters, Row 1 Scrollable Table, Row 2 Inspection Footer -->
    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Header & Search/Filters Toolbar (Fixed) -->
            <RowDefinition Height="*" />    <!-- Main Leads Table (Scrolls Internally) -->
            <RowDefinition Height="Auto" /> <!-- Selected Lead Inspection Drawer / Status (Fixed) -->
        </Grid.RowDefinitions>

        <!-- ========================================== -->
        <!-- ROW 0: PAGE HEADER & SEARCH / FILTER CARD  -->
        <!-- ========================================== -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <!-- Top Action Header -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Title & Meta Badges -->
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Lead Masterlist" 
                                   FontSize="24" 
                                   FontWeight="Bold" 
                                   Foreground="{StaticResource TextPrimaryBrush}" 
                                   VerticalAlignment="Center" />

                        <!-- Dynamic Record Counter Badge -->
                        <Border Background="#E0F2FE" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="10" Padding="10,3" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ShowingCountText}" FontSize="11.5" Foreground="#0284C7" FontWeight="SemiBold" />
                        </Border>
                    </StackPanel>

                    <TextBlock Text="Central database of all verified business accounts, contacts, and inquiry statuses." 
                               FontSize="13" 
                               Foreground="{StaticResource TextSecondaryBrush}" 
                               Margin="0,4,0,0" />
                </StackPanel>

                <!-- Quick Action Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="⟳ Refresh" 
                            Command="{Binding RefreshCommand}" 
                            Style="{StaticResource SecondaryButtonStyle}" 
                            Padding="14,8" 
                            Margin="0,0,8,0"
                            ToolTip="Reload leads from database" />

                    <!-- Assign Filtered Leads to Client -->
                    <Button Content="{Binding AssignToClientButtonText}" 
                            Command="{Binding OpenAssignClientModalCommand}" 
                            Style="{StaticResource PrimaryButtonStyle}"
                            Background="#4F46E5"
                            BorderBrush="#4338CA"
                            Padding="14,8" 
                            Margin="0,0,8,0"
                            ToolTip="Assign currently filtered leads directly to a client" />

                    <Button Content="{Binding ExportFilteredButtonText}" 
                            Command="{Binding ExportFilteredCommand}" 
                            Style="{StaticResource PrimaryButtonStyle}"
                            Padding="14,8" 
                            Margin="0,0,8,0"
                            ToolTip="Export currently filtered leads to Excel (.xlsx)" />

                    <Button Content="{Binding ExportAllButtonText}" 
                            Command="{Binding ExportAllCommand}" 
                            Style="{StaticResource PrimaryButtonStyle}"
                            Padding="14,8" 
                            ToolTip="Export all leads in the master database to Excel (.xlsx)" />
                </StackPanel>
            </Grid>

            <!-- Search & Multi-Filter Card -->
            <Border Style="{StaticResource CardBorderStyle}" Padding="16,14">
                <StackPanel>
                    <!-- Row 1: Search Bar & Reset Button -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- 1. Real-time Search Box -->
                        <Grid Grid.Column="0" Margin="0,0,12,0">
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource ModernTextBoxStyle}" 
                                     Padding="36,9,12,9" />
                            <!-- Search Icon -->
                            <TextBlock Text="🔍" 
                                       Foreground="#94A3B8" 
                                       FontSize="13" 
                                       VerticalAlignment="Center" 
                                       HorizontalAlignment="Left" 
                                       Margin="12,0,0,0" 
                                       IsHitTestVisible="False" />
                            <!-- Ghost Placeholder Text when empty -->
                            <TextBlock Text="Search by business name, contact, phone, city, county, NAICS, title..." 
                                       Foreground="#94A3B8" 
                                       FontSize="13" 
                                       VerticalAlignment="Center" 
                                       Margin="38,0,0,0" 
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SearchText}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SearchText}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <!-- Reset Filters Button -->
                        <Button Grid.Column="1" 
                                Content="✕ Reset Filters" 
                                Command="{Binding ClearFiltersCommand}" 
                                Style="{StaticResource SecondaryButtonStyle}" 
                                Padding="14,8"
                                ToolTip="Clear all search terms and reset all dropdown filters" />
                    </Grid>

                    <!-- Row 2: Client, Location & Sales Filters (5 Columns) — Multi-Select Checkboxes -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Client (multi-select) -->
                        <controls:MultiSelectDropdown Grid.Column="0"
                                  ItemsSource="{Binding ClientItems}"
                                  HeaderText="Clients"
                                  Margin="0,0,8,0"
                                  ToolTip="Filter by Client or Unassigned" />

                        <!-- City (multi-select) -->
                        <controls:MultiSelectDropdown Grid.Column="1"
                                  ItemsSource="{Binding CityItems}"
                                  HeaderText="Cities"
                                  Margin="0,0,8,0"
                                  ToolTip="Filter by City — select multiple cities" />

                        <!-- County (multi-select) -->
                        <controls:MultiSelectDropdown Grid.Column="2"
                                  ItemsSource="{Binding CountyItems}"
                                  HeaderText="Counties"
                                  Margin="0,0,8,0"
                                  ToolTip="Filter by County — select multiple counties" />

                        <!-- State (multi-select) -->
                        <controls:MultiSelectDropdown Grid.Column="3"
                                  ItemsSource="{Binding StateItems}"
                                  HeaderText="States"
                                  Margin="0,0,8,0"
                                  ToolTip="Filter by State — select multiple states" />

                        <!-- Annual Sales (multi-select) -->
                        <controls:MultiSelectDropdown Grid.Column="4"
                                  ItemsSource="{Binding AnnualSalesItems}"
                                  HeaderText="Sales Ranges"
                                  ToolTip="Filter by Annual Sales Range — select multiple sales ranges" />
                    </Grid>

                    <!-- Row 3: SIC & NAICS Filters (4 Columns) — Multi-Select Checkboxes -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- SIC Code (multi-select) -->
                        <controls:MultiSelectDropdown Grid.Column="0"
                                  ItemsSource="{Binding SicCodeItems}"
                                  HeaderText="SIC Codes"
                                  Margin="0,0,8,0"
                                  ToolTip="Filter by SIC Code — select multiple SIC codes" />

                        <!-- SIC Description (multi-select) -->
                        <controls:MultiSelectDropdown Grid.Column="1"
                                  ItemsSource="{Binding SicDescItems}"
                                  HeaderText="SIC Descriptions"
                                  Margin="0,0,8,0"
                                  ToolTip="Filter by SIC Description — select multiple SIC descriptions" />

                        <!-- NAICS Code (multi-select) -->
                        <controls:MultiSelectDropdown Grid.Column="2"
                                  ItemsSource="{Binding NaicsCodeItems}"
                                  HeaderText="NAICS Codes"
                                  Margin="0,0,8,0"
                                  ToolTip="Filter by NAICS Code — select multiple NAICS codes" />

                        <!-- NAICS Description (multi-select) -->
                        <controls:MultiSelectDropdown Grid.Column="3"
                                  ItemsSource="{Binding NaicsDescItems}"
                                  HeaderText="NAICS Descriptions"
                                  ToolTip="Filter by NAICS Description — select multiple NAICS descriptions" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ============================================================= -->
        <!-- ROW 1: MASTER TABLE (Fixed in page, scrollable inside)       -->
        <!-- ============================================================= -->
        <Border Grid.Row="1" 
                Style="{StaticResource CardBorderStyle}" 
                Padding="0" 
                ClipToBounds="True">
            <Grid>
                <DataGrid ItemsSource="{Binding FilteredLeads}"     
                          SelectedItem="{Binding SelectedLead, Mode=TwoWay}"
                          Style="{StaticResource ModernDataGridStyle}"
                          EnableRowVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          GridLinesVisibility="None"
                          ClipboardCopyMode="ExcludeHeader"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto"
                          Sorting="OnDataGridSorting" SelectionChanged="DataGrid_SelectionChanged">
                <DataGrid.Columns>

                    <!-- 1. DATE with Calendar Picker (Editable) -->
                    <DataGridTemplateColumn Header="DATE" Width="135" CanUserSort="True" SortMemberPath="SelectedDate">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <DatePicker SelectedDate="{Binding SelectedDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            Height="28" VerticalAlignment="Center" VerticalContentAlignment="Center"
                                            BorderBrush="#CBD5E1" Background="White" Padding="4,1"
                                            ToolTip="Pick a date for this call"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- 2. CALL DISPOSITION Dropdown with Color Coding (Editable) -->
                    <DataGridTemplateColumn Header="CALL DISPOSITION" Width="185" CanUserSort="True" SortMemberPath="CallDisposition">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding Source={x:Static models:CallDispositionHelper.Dispositions}}"
                                          SelectedValue="{Binding CallDisposition, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          SelectedValuePath="Name"
                                          Height="30" VerticalAlignment="Center"
                                          BorderBrush="#CBD5E1" Background="White">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding BackgroundHex}"
                                                    BorderBrush="{Binding BorderHex}"
                                                    BorderThickness="1" CornerRadius="8"
                                                    Padding="8,3" Margin="0,1" HorizontalAlignment="Stretch">
                                                <TextBlock Text="{Binding Name}"
                                                           Foreground="{Binding ForegroundHex}"
                                                           FontWeight="SemiBold" FontSize="11.5"/>
                                            </Border>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- 3. AGENT Assigned Dropdown (Editable) -->
                    <DataGridTemplateColumn Header="AGENT" Width="150" CanUserSort="True" SortMemberPath="AssignedAgent">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding AvailableAgentOptions}"
                                          SelectedItem="{Binding AssignedAgent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Height="30" VerticalAlignment="Center"
                                          BorderBrush="#CBD5E1" Background="White">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="👤"/>
                                                            <Setter Property="Foreground" Value="#64748B"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding}" Value="">
                                                                    <Setter Property="Text" Value="—"/>
                                                                    <Setter Property="Foreground" Value="#94A3B8"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock FontSize="12" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="{Binding}"/>
                                                            <Setter Property="Foreground" Value="#0F172A"/>
                                                            <Setter Property="FontWeight" Value="Medium"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding}" Value="">
                                                                    <Setter Property="Text" Value="Unassigned"/>
                                                                    <Setter Property="Foreground" Value="#94A3B8"/>
                                                                    <Setter Property="FontStyle" Value="Italic"/>
                                                                    <Setter Property="FontWeight" Value="Normal"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- 4. NOTES (Editable) -->
                    <DataGridTemplateColumn Header="NOTES" Width="200" CanUserSort="True" SortMemberPath="Notes">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding Notes, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                         Height="28" VerticalContentAlignment="Center"
                                         Padding="6,2" BorderBrush="#CBD5E1" BorderThickness="1"
                                         Background="White" FontSize="12"
                                         ToolTip="{Binding Notes}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- 5. # OF CALL (Auto-incremented on Dial / Editable) -->
                    <DataGridTemplateColumn Header="# OF CALL" Width="95" CanUserSort="True" SortMemberPath="CallCount">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="5"
                                        Height="28" Width="48" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CallCount}" 
                                               FontWeight="Bold" FontSize="12" Foreground="#0F172A"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               ToolTip="Total calls dialed to this lead (auto-increments upon calling)"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- 6. CELL NUMBER (with Zoom Phone Call Button) -->
                    <DataGridTemplateColumn Header="CELL NUMBER" Width="180" CanUserSort="True" SortMemberPath="CellNumber">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Call Button: Dials number in Zoom & increments # of call -->
                                    <Button Grid.Column="0"
                                            Command="{Binding DataContext.CallLeadCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource CallIconButtonStyle}"
                                            Margin="0,0,5,0"
                                            ToolTip="Call this number via Zoom Phone (auto-increments # OF CALL)">
                                        <Path Data="M3.654 1.328a.678.678 0 0 0-1.015-.063L1.605 2.3c-.483.484-.661 1.169-.45 1.77a17.6 17.6 0 0 0 4.168 6.608 17.6 17.6 0 0 0 6.608 4.168c.601.211 1.286.033 1.77-.45l1.034-1.034a.678.678 0 0 0-.063-1.015l-2.307-1.794a.68.68 0 0 0-.58-.122l-2.19.547a1.75 1.75 0 0 1-1.657-.459L5.482 8.062a1.75 1.75 0 0 1-.46-1.657l.548-2.19a.68.68 0 0 0-.122-.58z"
                                              Fill="White" Stretch="Uniform" Width="12" Height="12"/>
                                    </Button>

                                    <!-- Cell Number TextBox (Editable) -->
                                    <TextBox Grid.Column="1"
                                             Text="{Binding CellNumber, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                             Height="28" VerticalContentAlignment="Center"
                                             Padding="6,2" BorderBrush="#CBD5E1" BorderThickness="1"
                                             Background="White" FontSize="12"
                                             ToolTip="{Binding CellNumber}"/>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- 7. ASSIGNED CLIENT Column -->
                    <DataGridTemplateColumn Header="ASSIGNED CLIENT" Width="150" CanUserSort="True" SortMemberPath="ClientName">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="6" Padding="8,3" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock FontSize="11.5" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding ClientName}"/>
                                                <Setter Property="Foreground" Value="#0F172A"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ClientName}" Value="">
                                                        <Setter Property="Text" Value="— Unassigned —"/>
                                                        <Setter Property="Foreground" Value="#94A3B8"/>
                                                        <Setter Property="FontStyle" Value="Italic"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ClientName}" Value="{x:Null}">
                                                        <Setter Property="Text" Value="— Unassigned —"/>
                                                        <Setter Property="Foreground" Value="#94A3B8"/>
                                                        <Setter Property="FontStyle" Value="Italic"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Column A: Business Name -->
                    <DataGridTemplateColumn Header="BUSINESS NAME" Width="220" CanUserSort="True" SortMemberPath="BusinessName">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding BusinessName, Mode=OneWay}" 
                                         Style="{StaticResource SelectableTextStyle}"
                                         FontWeight="SemiBold" 
                                         VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Column B: Address -->
                    <DataGridTemplateColumn Header="ADDRESS" Width="190" CanUserSort="True" SortMemberPath="Address">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding Address, Mode=OneWay}" 
                                         Style="{StaticResource SelectableTextStyle}" 
                                         VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Column C: City -->
                    <DataGridTemplateColumn Header="CITY" Width="125" CanUserSort="True" SortMemberPath="City">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding City, Mode=OneWay}" 
                                         Style="{StaticResource SelectableTextStyle}" 
                                         VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Column D: County -->
                    <DataGridTemplateColumn Header="COUNTY" Width="125" CanUserSort="True" SortMemberPath="County">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding County, Mode=OneWay}" 
                                         Style="{StaticResource SelectableTextStyle}" 
                                         VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Column E: State -->
                    <DataGridTemplateColumn Header="STATE" Width="75" CanUserSort="True" SortMemberPath="State">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding State, Mode=OneWay}" 
                                         Style="{StaticResource SelectableTextStyle}" 
                                         VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Column F: Zip Code -->
                    <DataGridTemplateColumn Header="ZIP CODE" Width="95" CanUserSort="True" SortMemberPath="ZipCode">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding ZipCode, Mode=OneWay}" 
                                         Style="{StaticResource SelectableTextStyle}" 
                                         VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Column G: Email -->
                    <DataGridTemplateColumn Header="EMAIL" Width="170" CanUserSort="True" SortMemberPath="Email">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding Email, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" 
                                         Style="{StaticResource SelectableTextStyle}" 
                                         VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Column H: FAX -->
                    <DataGridTemplateColumn Header="FAX" Width="110" CanUserSort="True" SortMemberPath="Fax">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding Fax, Mode=OneWay}" 
                                         Style="{StaticResource SelectableTextStyle}" 
                                         VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Column I: Annual Sales -->
                    <DataGridTemplateColumn Header="ANNUAL SALES" Width="145" CanUserSort="True" SortMemberPath="AnnualSales">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding AnnualSales, Mode=OneWay}" 
                                         Style="{StaticResource SelectableTextStyle}" 
                                         VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Column J: Number Of Employee -->
                    <DataGridTemplateColumn Header="NUMBER OF EMPLOYEE" Width="165" CanUserSort="True" SortMemberPath="NumberOfEmployees">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding NumberOfEmployees, Mode=OneWay}" 
                                         Style="{StaticResource SelectableTextStyle}" 
                                         VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Column K: Title -->
                    <DataGridTemplateColumn Header="TITLE" Width="150" CanUserSort="True" SortMemberPath="Title">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding Title, Mode=OneWay}" 
                                         Style="{StaticResource SelectableTextStyle}" 
                                         VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Column L: Contact Name -->
                    <DataGridTemplateColumn Header="CONTACT NAME" Width="180" CanUserSort="True" SortMemberPath="ContactName">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding ContactName, Mode=OneWay}" 
                                         Style="{StaticResource SelectableTextStyle}" 
                                         VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Column M: Website -->
                    <DataGridTemplateColumn Header="WEBSITE" Width="160" CanUserSort="True" SortMemberPath="Website">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid VerticalAlignment="Center">
                                    <TextBox x:Name="LinkBlock"
                                             Text="{Binding Website, Mode=OneWay}"
                                             Style="{StaticResource SelectableTextStyle}"
                                             Foreground="#2563EB"
                                             FontSize="12"
                                             VerticalAlignment="Center" />
                                    <TextBlock x:Name="DashBlock" Text="—" Foreground="#94A3B8" FontSize="12" Visibility="Collapsed" />
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Website}" Value="">
                                        <Setter TargetName="LinkBlock" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="DashBlock" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Website}" Value="{x:Null}">
                                        <Setter TargetName="LinkBlock" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="DashBlock" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Column N: SIC Code -->
                    <DataGridTemplateColumn Header="SIC CODE" Width="110" CanUserSort="True" SortMemberPath="SicCode">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding SicCode, Mode=OneWay}" 
                                         Style="{StaticResource SelectableTextStyle}" 
                                         VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Column O: SIC Description -->
                    <DataGridTemplateColumn Header="SIC DESCRIPTION" Width="200" CanUserSort="True" SortMemberPath="SicDescription">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding SicDescription, Mode=OneWay}" 
                                         Style="{StaticResource SelectableTextStyle}" 
                                         VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Column P: NAICS Code -->
                    <DataGridTemplateColumn Header="NAICS CODE" Width="110" CanUserSort="True" SortMemberPath="NaicsCode">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding NaicsCode, Mode=OneWay}" 
                                         Style="{StaticResource SelectableTextStyle}" 
                                         VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Column Q: NAICS Description -->
                    <DataGridTemplateColumn Header="NAICS DESCRIPTION" Width="220" CanUserSort="True" SortMemberPath="NaicsDescription">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding NaicsDescription, Mode=OneWay}" 
                                         Style="{StaticResource SelectableTextStyle}" 
                                         VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>

            <!-- Loading Overlay inside Table -->
            <Border Background="#F8FAFC" 
                    Opacity="0.94"
                    Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Panel.ZIndex="100">
                <Border Background="White" 
                        CornerRadius="14" 
                        BorderBrush="#E2E8F0" 
                        BorderThickness="1" 
                        Padding="32,28"
                        HorizontalAlignment="Center" 
                        VerticalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.12" Color="#0F172A" />
                    </Border.Effect>
                    <StackPanel Width="340" HorizontalAlignment="Center">
                        <!-- Spinner / Icon & Title -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,14">
                            <Border Background="#EFF6FF" CornerRadius="8" Width="36" Height="36" Margin="0,0,10,0">
                                <TextBlock Text="⏳" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Loading Masterlist" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="Fetching leads from database..." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Indeterminate Progress Bar -->
                        <ProgressBar Height="6" 
                                     IsIndeterminate="True" 
                                     Foreground="{StaticResource PrimaryBrush}" 
                                     Background="#E2E8F0" 
                                     BorderThickness="0" 
                                     Margin="0,0,0,12" />

                        <TextBlock Text="Loading records, please wait a moment..." 
                                   FontSize="12" 
                                   Foreground="{StaticResource TextSecondaryBrush}" 
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Border>

    <!-- ============================================================= -->
    <!-- ROW 2: PAGINATION BAR & NAVIGATION CONTROLS                  -->
    <!-- ============================================================= -->
    <Border Grid.Row="2" 
            Background="White" 
            BorderBrush="#E2E8F0" 
            BorderThickness="1" 
            CornerRadius="8" 
            Padding="16,10" 
            Margin="0,12,0,0">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Left: Record summary (e.g., Showing 1 - 500 of 270,186 records) + Rows per page selector -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding PaginationSummary}" 
                           FontSize="13" 
                           FontWeight="SemiBold" 
                           Foreground="{StaticResource TextPrimaryBrush}" 
                           VerticalAlignment="Center" />

                <!-- Rows per page selector -->
                <StackPanel Orientation="Horizontal" Margin="24,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Rows per page:" 
                               FontSize="12.5" 
                               Foreground="{StaticResource TextSecondaryBrush}" 
                               VerticalAlignment="Center" 
                               Margin="0,0,8,0" />
                    <ComboBox ItemsSource="{Binding PageSizeOptions}" 
                              SelectedItem="{Binding PageSize, Mode=TwoWay}"
                              Style="{StaticResource ModernComboBoxStyle}"
                              Width="85" 
                              Height="32" 
                              FontSize="12" />
                </StackPanel>
            </StackPanel>

            <!-- Right: Navigation Pagination Buttons -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- First Page -->
                <Button Content="⏮ First" 
                        Command="{Binding FirstPageCommand}" 
                        IsEnabled="{Binding HasPreviousPage}"
                        Style="{StaticResource SecondaryButtonStyle}" 
                        Padding="10,6" 
                        FontSize="12"
                        Margin="0,0,6,0"
                        ToolTip="Go to first page" />

                <!-- Previous Page -->
                <Button Content="◀ Prev" 
                        Command="{Binding PreviousPageCommand}" 
                        IsEnabled="{Binding HasPreviousPage}"
                        Style="{StaticResource SecondaryButtonStyle}" 
                        Padding="12,6" 
                        FontSize="12"
                        Margin="0,0,10,0"
                        ToolTip="Go to previous page" />

                <!-- Current Page Display Badge -->
                <Border Background="#F1F5F9" 
                        BorderBrush="#CBD5E1" 
                        BorderThickness="1" 
                        CornerRadius="6" 
                        Padding="14,5" 
                        Margin="0,0,10,0" 
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding PageNumberText}" 
                               FontSize="12.5" 
                               FontWeight="SemiBold" 
                               Foreground="{StaticResource TextPrimaryBrush}" />
                </Border>

                <!-- Next Page -->
                <Button Content="Next ▶" 
                        Command="{Binding NextPageCommand}" 
                        IsEnabled="{Binding HasNextPage}"
                        Style="{StaticResource PrimaryButtonStyle}" 
                        Padding="14,6" 
                        FontSize="12"
                        Margin="0,0,6,0"
                        ToolTip="Go to next page" />

                <!-- Last Page -->
                <Button Content="Last ⏭" 
                        Command="{Binding LastPageCommand}" 
                        IsEnabled="{Binding HasNextPage}"
                        Style="{StaticResource SecondaryButtonStyle}" 
                        Padding="10,6" 
                        FontSize="12"
                        ToolTip="Go to last page" />
            </StackPanel>
        </Grid>
    </Border>

        <!-- ======================================================== -->
        <!-- MODAL OVERLAY: Assign Leads to Client                    -->
        <!-- ======================================================== -->
        <Grid Grid.Row="0"
              Grid.Column="0"
              Grid.RowSpan="3"
              Grid.ColumnSpan="3"
              Background="#990F172A"
              Margin="-24,-20,-24,-20"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              Visibility="{Binding IsAssignClientModalOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
              Panel.ZIndex="9998">
            <Border Background="White"
                    CornerRadius="14"
                    Width="480"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="32,28"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="36" ShadowDepth="6" Opacity="0.22" Color="#000000" />
                </Border.Effect>
                <StackPanel>
                    <!-- Header -->
                    <Grid Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="👥 Assign Leads to Client"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="{Binding AssignModalSummary}"
                                       FontSize="12.5"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                        <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                                Command="{Binding CloseAssignClientModalCommand}"
                                Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="6">
                            <TextBlock Text="✕" FontSize="14" Foreground="#94A3B8" />
                        </Button>
                    </Grid>

                    <!-- Error Alert -->
                    <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1"
                            CornerRadius="8" Padding="12,8" Margin="0,0,0,14"
                            Visibility="{Binding HasAssignError, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{Binding AssignErrorMessage}" Foreground="#DC2626" FontSize="12" TextWrapping="Wrap"/>
                    </Border>

                    <!-- Client Selector -->
                    <TextBlock Text="Choose Client" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                    <ComboBox ItemsSource="{Binding AvailableClients}"
                              SelectedItem="{Binding SelectedTargetClient, Mode=TwoWay}"
                              DisplayMemberPath="FullName"
                              Height="38"
                              Margin="0,0,0,24"
                              FontSize="13"
                              VerticalContentAlignment="Center"
                              Style="{StaticResource {x:Type ComboBox}}" />

                    <!-- Action Buttons -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Content="Cancel"
                                Command="{Binding CloseAssignClientModalCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="16,9" />

                        <Button Grid.Column="2"
                                Command="{Binding ConfirmAssignClientCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Background="#4F46E5"
                                BorderBrush="#4338CA"
                                Padding="16,9">
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="✓ Confirm Assignment"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAssigning}" Value="True">
                                                <Setter Property="Text" Value="Assigning…"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ======================================================== -->
        <!-- TOAST BANNER NOTIFICATION                                 -->
        <!-- ======================================================== -->
        <Border Grid.Row="0" Grid.Column="0" Grid.RowSpan="3"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,16,16,0"
                CornerRadius="8" Padding="16,10"
                BorderThickness="1"
                Panel.ZIndex="10000"
                Visibility="{Binding IsBannerVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#F0FDF4"/>
                    <Setter Property="BorderBrush" Value="#BBF7D0"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsBannerError}" Value="True">
                            <Setter Property="Background" Value="#FEF2F2"/>
                            <Setter Property="BorderBrush" Value="#FECACA"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="✓ " FontWeight="Bold" Foreground="#15803D" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#15803D"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBannerError}" Value="True">
                                    <Setter Property="Text" Value="⚠ "/>
                                    <Setter Property="Foreground" Value="#DC2626"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding StatusBannerMessage}" FontSize="12.5" FontWeight="SemiBold" Foreground="#15803D" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#15803D"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBannerError}" Value="True">
                                    <Setter Property="Foreground" Value="#DC2626"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Button Command="{Binding DismissBannerCommand}" Background="Transparent" BorderThickness="0" Margin="12,0,0,0" Cursor="Hand">
                    <TextBlock Text="✕" FontSize="11" Foreground="#94A3B8"/>
                </Button>
            </StackPanel>
        </Border>

        <!-- ======================================================== -->
        <!-- MODAL OVERLAY: Exporting Leads Progress & Cancel         -->
        <!-- ======================================================== -->
        <Grid Grid.Row="0"
                Grid.Column="0"
                Grid.RowSpan="3"
                Grid.ColumnSpan="3"
                Background="#CC000000"
                Margin="-24,-20,-24,-20"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Visibility="{Binding IsExportModalOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
                Panel.ZIndex="9999">
            <Border Background="White"
                    CornerRadius="14"
                    Width="500"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="28,24"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity="0.3" Color="#000000" />
                </Border.Effect>
                <StackPanel>
                    <!-- Header Icon & Title -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14" VerticalAlignment="Center">
                        <Border Background="#EFF6FF" CornerRadius="10" Width="44" Height="44" Margin="0,0,14,0">
                            <TextBlock Text="📊" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding ExportModalTitle}"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="{Binding ExportModalSubtitle}"
                                       FontSize="12.5"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="400"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Status description message -->
                    <TextBlock Text="{Binding ExportModalStatus}"
                               FontSize="13"
                               Foreground="#334155"
                               Margin="0,4,0,12" />

                    <!-- Progress Bar -->
                    <ProgressBar Height="8"
                                 IsIndeterminate="{Binding IsExportIndeterminate}"
                                 Value="{Binding ExportProgressPercentage}"
                                 Maximum="100"
                                 Foreground="#2563EB"
                                 Background="#E2E8F0"
                                 BorderThickness="0"
                                 Margin="0,0,0,20" />

                    <!-- Action Footer with Cancel Button -->
                    <Button Content="✕ Cancel Export"
                            Command="{Binding CancelExportCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            HorizontalAlignment="Right"
                            Padding="20,8"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            ToolTip="Cancel Excel file generation" />
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</UserControl>
