<UserControl x:Class="LeadManagement.Desktop.Views.LeadMasterlistView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodels="clr-namespace:LeadManagement.Desktop.ViewModels"
             xmlns:controls="clr-namespace:LeadManagement.Desktop.Controls"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=viewmodels:LeadMasterlistViewModel, IsDesignTimeCreatable=True}"
             d:DesignHeight="800" d:DesignWidth="1200"
             FontFamily="{StaticResource AppFontFamily}">

    <!-- FIXED VIEWPORT GRID: Row 0 Header/Filters, Row 1 Scrollable Table, Row 2 Inspection Footer -->
    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Header & Search/Filters Toolbar (Fixed) -->
            <RowDefinition Height="*" />    <!-- Main Leads Table (Scrolls Internally) -->
            <RowDefinition Height="Auto" /> <!-- Selected Lead Inspection Drawer / Status (Fixed) -->
        </Grid.RowDefinitions>

        <!-- ========================================== -->
        <!-- ROW 0: PAGE HEADER & SEARCH / FILTER CARD  -->
        <!-- ========================================== -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <!-- Top Action Header -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Title & Meta Badges -->
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Lead Masterlist" 
                                   FontSize="24" 
                                   FontWeight="Bold" 
                                   Foreground="{StaticResource TextPrimaryBrush}" 
                                   VerticalAlignment="Center" />

                        <!-- Dynamic Record Counter Badge -->
                        <Border Background="#E0F2FE" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="10" Padding="10,3" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ShowingCountText}" FontSize="11.5" Foreground="#0284C7" FontWeight="SemiBold" />
                        </Border>
                    </StackPanel>

                    <TextBlock Text="Central database of all verified business accounts, contacts, and inquiry statuses." 
                               FontSize="13" 
                               Foreground="{StaticResource TextSecondaryBrush}" 
                               Margin="0,4,0,0" />
                </StackPanel>

                <!-- Quick Action Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="⟳ Refresh" 
                            Command="{Binding RefreshCommand}" 
                            Style="{StaticResource SecondaryButtonStyle}" 
                            Padding="14,8" 
                            Margin="0,0,8,0"
                            ToolTip="Reload leads from database" />

                    <Button Content="{Binding ExportFilteredButtonText}" 
                            Command="{Binding ExportFilteredCommand}" 
                            Style="{StaticResource PrimaryButtonStyle}"
                            Padding="14,8" 
                            Margin="0,0,8,0"
                            ToolTip="Export currently filtered leads to Excel (.xlsx)" />

                    <Button Content="{Binding ExportAllButtonText}" 
                            Command="{Binding ExportAllCommand}" 
                            Style="{StaticResource PrimaryButtonStyle}"
                            Padding="14,8" 
                            ToolTip="Export all leads in the master database to Excel (.xlsx)" />
                </StackPanel>
            </Grid>

            <!-- Search & Multi-Filter Card -->
            <Border Style="{StaticResource CardBorderStyle}" Padding="16,14">
                <StackPanel>
                    <!-- Row 1: Search Bar & Reset Button -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- 1. Real-time Search Box -->
                        <Grid Grid.Column="0" Margin="0,0,12,0">
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource ModernTextBoxStyle}" 
                                     Padding="36,9,12,9" />
                            <!-- Search Icon -->
                            <TextBlock Text="🔍" 
                                       Foreground="#94A3B8" 
                                       FontSize="13" 
                                       VerticalAlignment="Center" 
                                       HorizontalAlignment="Left" 
                                       Margin="12,0,0,0" 
                                       IsHitTestVisible="False" />
                            <!-- Ghost Placeholder Text when empty -->
                            <TextBlock Text="Search by business name, contact, phone, city, county, NAICS, title..." 
                                       Foreground="#94A3B8" 
                                       FontSize="13" 
                                       VerticalAlignment="Center" 
                                       Margin="38,0,0,0" 
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SearchText}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SearchText}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <!-- Reset Filters Button -->
                        <Button Grid.Column="1" 
                                Content="✕ Reset Filters" 
                                Command="{Binding ClearFiltersCommand}" 
                                Style="{StaticResource SecondaryButtonStyle}" 
                                Padding="14,8"
                                ToolTip="Clear all search terms and reset all dropdown filters" />
                    </Grid>

                    <!-- Row 2: Location & Status Filters (4 Columns) — Multi-Select Checkboxes -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- City (multi-select) -->
                        <controls:MultiSelectDropdown Grid.Column="0"
                                  ItemsSource="{Binding CityItems}"
                                  HeaderText="All Cities"
                                  Margin="0,0,8,0"
                                  ToolTip="Filter by City — select multiple cities" />

                        <!-- County (multi-select) -->
                        <controls:MultiSelectDropdown Grid.Column="1"
                                  ItemsSource="{Binding CountyItems}"
                                  HeaderText="All Counties"
                                  Margin="0,0,8,0"
                                  ToolTip="Filter by County — select multiple counties" />

                        <!-- State (multi-select) -->
                        <controls:MultiSelectDropdown Grid.Column="2"
                                  ItemsSource="{Binding StateItems}"
                                  HeaderText="All States"
                                  Margin="0,0,8,0"
                                  ToolTip="Filter by State — select multiple states" />

                        <!-- Status (multi-select) -->
                        <controls:MultiSelectDropdown Grid.Column="3"
                                  ItemsSource="{Binding StatusItems}"
                                  HeaderText="All Statuses"
                                  ToolTip="Filter by Lead Status — select multiple statuses" />
                    </Grid>

                    <!-- Row 3: Demographics & Classification Filters (4 Columns) — Multi-Select Checkboxes -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Industry / SIC Description (multi-select) -->
                        <controls:MultiSelectDropdown Grid.Column="0"
                                  ItemsSource="{Binding IndustryItems}"
                                  HeaderText="All Industries"
                                  Margin="0,0,8,0"
                                  ToolTip="Filter by Industry (SIC Description) — select multiple" />

                        <!-- Annual Sales (multi-select) -->
                        <controls:MultiSelectDropdown Grid.Column="1"
                                  ItemsSource="{Binding AnnualSalesItems}"
                                  HeaderText="All Sales Ranges"
                                  Margin="0,0,8,0"
                                  ToolTip="Filter by Annual Sales Range — select multiple" />

                        <!-- NAICS Code (multi-select) -->
                        <controls:MultiSelectDropdown Grid.Column="2"
                                  ItemsSource="{Binding NaicsCodeItems}"
                                  HeaderText="All NAICS Codes"
                                  Margin="0,0,8,0"
                                  ToolTip="Filter by NAICS Code — select multiple" />

                        <!-- NAICS Description (multi-select) -->
                        <controls:MultiSelectDropdown Grid.Column="3"
                                  ItemsSource="{Binding NaicsDescItems}"
                                  HeaderText="All NAICS Descriptions"
                                  ToolTip="Filter by NAICS Description — select multiple" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ============================================================= -->
        <!-- ROW 1: MASTER TABLE (Fixed in page, scrollable inside)       -->
        <!-- ============================================================= -->
        <Border Grid.Row="1" 
                Style="{StaticResource CardBorderStyle}" 
                Padding="0" 
                ClipToBounds="True">
            <Grid>
                <DataGrid ItemsSource="{Binding FilteredLeads}"     
                          SelectedItem="{Binding SelectedLead, Mode=TwoWay}"
                          Style="{StaticResource ModernDataGridStyle}"
                          EnableRowVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          GridLinesVisibility="None"
                          ClipboardCopyMode="ExcludeHeader"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto"
                          Sorting="OnDataGridSorting">
                <DataGrid.Columns>

                    <!-- Status Column (Retained & Highlighted) -->
                    <DataGridTemplateColumn Header="STATUS" Width="120" CanUserSort="True" SortMemberPath="Status">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="12" Padding="10,4" BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#EFF6FF" />
                                            <Setter Property="BorderBrush" Value="#BFDBFE" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Qualified">
                                                    <Setter Property="Background" Value="#ECFDF5" />
                                                    <Setter Property="BorderBrush" Value="#A7F3D0" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Follow-up">
                                                    <Setter Property="Background" Value="#FFFBEB" />
                                                    <Setter Property="BorderBrush" Value="#FDE68A" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Contacted">
                                                    <Setter Property="Background" Value="#F5F3FF" />
                                                    <Setter Property="BorderBrush" Value="#DDD6FE" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBox Text="{Binding Status, Mode=OneWay}" 
                                             FontSize="11" 
                                             FontWeight="SemiBold">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox" BasedOn="{StaticResource SelectableTextStyle}">
                                                <Setter Property="Foreground" Value="#1D4ED8" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Qualified">
                                                        <Setter Property="Foreground" Value="#047857" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Follow-up">
                                                        <Setter Property="Foreground" Value="#B45309" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Contacted">
                                                        <Setter Property="Foreground" Value="#6D28D9" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Column A: Business Name -->
                    <DataGridTemplateColumn Header="BUSINESS NAME" Width="220" CanUserSort="True" SortMemberPath="BusinessName">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding BusinessName, Mode=OneWay}" 
                                         Style="{StaticResource SelectableTextStyle}"
                                         FontWeight="SemiBold" 
                                         VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Column B: Address -->
                    <DataGridTemplateColumn Header="ADDRESS" Width="190" CanUserSort="True" SortMemberPath="Address">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding Address, Mode=OneWay}" 
                                         Style="{StaticResource SelectableTextStyle}" 
                                         VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Column C: City -->
                    <DataGridTemplateColumn Header="CITY" Width="125" CanUserSort="True" SortMemberPath="City">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding City, Mode=OneWay}" 
                                         Style="{StaticResource SelectableTextStyle}" 
                                         VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Column D: County -->
                    <DataGridTemplateColumn Header="COUNTY" Width="125" CanUserSort="True" SortMemberPath="County">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding County, Mode=OneWay}" 
                                         Style="{StaticResource SelectableTextStyle}" 
                                         VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Column E: State -->
                    <DataGridTemplateColumn Header="STATE" Width="75" CanUserSort="True" SortMemberPath="State">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding State, Mode=OneWay}" 
                                         Style="{StaticResource SelectableTextStyle}" 
                                         VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Column F: Zip Code -->
                    <DataGridTemplateColumn Header="ZIP CODE" Width="95" CanUserSort="True" SortMemberPath="ZipCode">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding ZipCode, Mode=OneWay}" 
                                         Style="{StaticResource SelectableTextStyle}" 
                                         VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Column G: Cell Number -->
                    <DataGridTemplateColumn Header="CELL NUMBER" Width="140" CanUserSort="True" SortMemberPath="CellNumber">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="📞 " FontSize="10" Foreground="#64748B" VerticalAlignment="Center" />
                                    <TextBox Text="{Binding FormattedPhone, Mode=OneWay}" 
                                             Style="{StaticResource SelectableTextStyle}"
                                             FontFamily="Consolas, Segoe UI" 
                                             FontSize="12" 
                                             VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Column H: FAX -->
                    <DataGridTemplateColumn Header="FAX" Width="110" CanUserSort="True" SortMemberPath="Fax">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding Fax, Mode=OneWay}" 
                                         Style="{StaticResource SelectableTextStyle}" 
                                         VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Column I: Annual Sales -->
                    <DataGridTemplateColumn Header="ANNUAL SALES" Width="145" CanUserSort="True" SortMemberPath="AnnualSales">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding AnnualSales, Mode=OneWay}" 
                                         Style="{StaticResource SelectableTextStyle}" 
                                         VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Column J: Number Of Employee -->
                    <DataGridTemplateColumn Header="NUMBER OF EMPLOYEE" Width="165" CanUserSort="True" SortMemberPath="NumberOfEmployees">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding NumberOfEmployees, Mode=OneWay}" 
                                         Style="{StaticResource SelectableTextStyle}" 
                                         VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Column K: Title -->
                    <DataGridTemplateColumn Header="TITLE" Width="150" CanUserSort="True" SortMemberPath="Title">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding Title, Mode=OneWay}" 
                                         Style="{StaticResource SelectableTextStyle}" 
                                         VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Column L: Contact Name -->
                    <DataGridTemplateColumn Header="CONTACT NAME" Width="180" CanUserSort="True" SortMemberPath="ContactName">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding ContactName, Mode=OneWay}" 
                                         Style="{StaticResource SelectableTextStyle}" 
                                         VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Column M: Website -->
                    <DataGridTemplateColumn Header="WEBSITE" Width="160" CanUserSort="True" SortMemberPath="Website">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid VerticalAlignment="Center">
                                    <TextBox x:Name="LinkBlock"
                                             Text="{Binding Website, Mode=OneWay}"
                                             Style="{StaticResource SelectableTextStyle}"
                                             Foreground="#2563EB"
                                             FontSize="12"
                                             VerticalAlignment="Center" />
                                    <TextBlock x:Name="DashBlock" Text="—" Foreground="#94A3B8" FontSize="12" Visibility="Collapsed" />
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Website}" Value="">
                                        <Setter TargetName="LinkBlock" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="DashBlock" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Website}" Value="{x:Null}">
                                        <Setter TargetName="LinkBlock" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="DashBlock" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Column N: SIC Code -->
                    <DataGridTemplateColumn Header="SIC CODE" Width="110" CanUserSort="True" SortMemberPath="SicCode">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding SicCode, Mode=OneWay}" 
                                         Style="{StaticResource SelectableTextStyle}" 
                                         VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Column O: SIC Description -->
                    <DataGridTemplateColumn Header="SIC DESCRIPTION" Width="200" CanUserSort="True" SortMemberPath="SicDescription">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding SicDescription, Mode=OneWay}" 
                                         Style="{StaticResource SelectableTextStyle}" 
                                         VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Column P: NAICS Code -->
                    <DataGridTemplateColumn Header="NAICS CODE" Width="110" CanUserSort="True" SortMemberPath="NaicsCode">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding NaicsCode, Mode=OneWay}" 
                                         Style="{StaticResource SelectableTextStyle}" 
                                         VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Column Q: NAICS Description -->
                    <DataGridTemplateColumn Header="NAICS DESCRIPTION" Width="220" CanUserSort="True" SortMemberPath="NaicsDescription">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding NaicsDescription, Mode=OneWay}" 
                                         Style="{StaticResource SelectableTextStyle}" 
                                         VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>

            <!-- Loading Overlay inside Table -->
            <Border Background="#F8FAFC" 
                    Opacity="0.94"
                    Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Panel.ZIndex="100">
                <Border Background="White" 
                        CornerRadius="14" 
                        BorderBrush="#E2E8F0" 
                        BorderThickness="1" 
                        Padding="32,28"
                        HorizontalAlignment="Center" 
                        VerticalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.12" Color="#0F172A" />
                    </Border.Effect>
                    <StackPanel Width="340" HorizontalAlignment="Center">
                        <!-- Spinner / Icon & Title -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,14">
                            <Border Background="#EFF6FF" CornerRadius="8" Width="36" Height="36" Margin="0,0,10,0">
                                <TextBlock Text="⏳" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Loading Masterlist" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="Fetching leads from database..." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Indeterminate Progress Bar -->
                        <ProgressBar Height="6" 
                                     IsIndeterminate="True" 
                                     Foreground="{StaticResource PrimaryBrush}" 
                                     Background="#E2E8F0" 
                                     BorderThickness="0" 
                                     Margin="0,0,0,12" />

                        <TextBlock Text="Loading records, please wait a moment..." 
                                   FontSize="12" 
                                   Foreground="{StaticResource TextSecondaryBrush}" 
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Border>

    <!-- ============================================================= -->
    <!-- ROW 2: PAGINATION BAR & NAVIGATION CONTROLS                  -->
    <!-- ============================================================= -->
    <Border Grid.Row="2" 
            Background="White" 
            BorderBrush="#E2E8F0" 
            BorderThickness="1" 
            CornerRadius="8" 
            Padding="16,10" 
            Margin="0,12,0,0">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Left: Record summary (e.g., Showing 1 - 500 of 270,186 records) + Rows per page selector -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding PaginationSummary}" 
                           FontSize="13" 
                           FontWeight="SemiBold" 
                           Foreground="{StaticResource TextPrimaryBrush}" 
                           VerticalAlignment="Center" />

                <!-- Rows per page selector -->
                <StackPanel Orientation="Horizontal" Margin="24,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Rows per page:" 
                               FontSize="12.5" 
                               Foreground="{StaticResource TextSecondaryBrush}" 
                               VerticalAlignment="Center" 
                               Margin="0,0,8,0" />
                    <ComboBox ItemsSource="{Binding PageSizeOptions}" 
                              SelectedItem="{Binding PageSize, Mode=TwoWay}"
                              Style="{StaticResource ModernComboBoxStyle}"
                              Width="85" 
                              Height="32" 
                              FontSize="12" />
                </StackPanel>
            </StackPanel>

            <!-- Right: Navigation Pagination Buttons -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- First Page -->
                <Button Content="⏮ First" 
                        Command="{Binding FirstPageCommand}" 
                        IsEnabled="{Binding HasPreviousPage}"
                        Style="{StaticResource SecondaryButtonStyle}" 
                        Padding="10,6" 
                        FontSize="12"
                        Margin="0,0,6,0"
                        ToolTip="Go to first page" />

                <!-- Previous Page -->
                <Button Content="◀ Prev" 
                        Command="{Binding PreviousPageCommand}" 
                        IsEnabled="{Binding HasPreviousPage}"
                        Style="{StaticResource SecondaryButtonStyle}" 
                        Padding="12,6" 
                        FontSize="12"
                        Margin="0,0,10,0"
                        ToolTip="Go to previous page" />

                <!-- Current Page Display Badge -->
                <Border Background="#F1F5F9" 
                        BorderBrush="#CBD5E1" 
                        BorderThickness="1" 
                        CornerRadius="6" 
                        Padding="14,5" 
                        Margin="0,0,10,0" 
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding PageNumberText}" 
                               FontSize="12.5" 
                               FontWeight="SemiBold" 
                               Foreground="{StaticResource TextPrimaryBrush}" />
                </Border>

                <!-- Next Page -->
                <Button Content="Next ▶" 
                        Command="{Binding NextPageCommand}" 
                        IsEnabled="{Binding HasNextPage}"
                        Style="{StaticResource PrimaryButtonStyle}" 
                        Padding="14,6" 
                        FontSize="12"
                        Margin="0,0,6,0"
                        ToolTip="Go to next page" />

                <!-- Last Page -->
                <Button Content="Last ⏭" 
                        Command="{Binding LastPageCommand}" 
                        IsEnabled="{Binding HasNextPage}"
                        Style="{StaticResource SecondaryButtonStyle}" 
                        Padding="10,6" 
                        FontSize="12"
                        ToolTip="Go to last page" />
            </StackPanel>
        </Grid>
    </Border>

        <!-- ======================================================== -->
        <!-- MODAL OVERLAY: Exporting Leads Progress & Cancel         -->
        <!-- ======================================================== -->
        <Grid Grid.Row="0"
                Grid.Column="0"
                Grid.RowSpan="3"
                Grid.ColumnSpan="3"
                Background="#CC000000"
                Margin="-24,-20,-24,-20"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Visibility="{Binding IsExportModalOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
                Panel.ZIndex="9999">
            <Border Background="White"
                    CornerRadius="14"
                    Width="500"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="28,24"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity="0.3" Color="#000000" />
                </Border.Effect>
                <StackPanel>
                    <!-- Header Icon & Title -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14" VerticalAlignment="Center">
                        <Border Background="#EFF6FF" CornerRadius="10" Width="44" Height="44" Margin="0,0,14,0">
                            <TextBlock Text="📊" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding ExportModalTitle}"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="{Binding ExportModalSubtitle}"
                                       FontSize="12.5"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="400"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Status description message -->
                    <TextBlock Text="{Binding ExportModalStatus}"
                               FontSize="13"
                               Foreground="#334155"
                               Margin="0,4,0,12" />

                    <!-- Progress Bar -->
                    <ProgressBar Height="8"
                                 IsIndeterminate="{Binding IsExportIndeterminate}"
                                 Value="{Binding ExportProgressPercentage}"
                                 Maximum="100"
                                 Foreground="#2563EB"
                                 Background="#E2E8F0"
                                 BorderThickness="0"
                                 Margin="0,0,0,20" />

                    <!-- Action Footer with Cancel Button -->
                    <Button Content="✕ Cancel Export"
                            Command="{Binding CancelExportCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            HorizontalAlignment="Right"
                            Padding="20,8"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            ToolTip="Cancel Excel file generation" />
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</UserControl>
