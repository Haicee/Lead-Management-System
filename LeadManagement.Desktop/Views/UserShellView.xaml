<UserControl x:Class="LeadManagement.Desktop.Views.UserShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodels="clr-namespace:LeadManagement.Desktop.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=viewmodels:MainViewModel, IsDesignTimeCreatable=True}"
             d:DesignHeight="850" d:DesignWidth="1240"
             FontFamily="{StaticResource AppFontFamily}"
             Background="{StaticResource WindowBgBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60" /> <!-- Top Bar -->
            <RowDefinition Height="*" />  <!-- Main Workspace -->
        </Grid.RowDefinitions>

        <!-- ========================================== -->
        <!-- FIXED TOP NAVIGATION BAR (USER PORTAL)     -->
        <!-- ========================================== -->
        <Border Grid.Row="0" Background="{StaticResource TopbarBgBrush}" BorderBrush="#334155" BorderThickness="0,0,0,1" Padding="20,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Branding & Agent Portal Badge -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Toggle Sidebar Button -->
                    <Button Command="{Binding UserDashboard.ToggleSidebarCommand}"
                            Style="{StaticResource NavToggleButtonStyle}"
                            ToolTip="Toggle Sidebar (Expand / Collapse)"
                            Margin="0,0,14,0">
                        <TextBlock Text="☰" FontSize="16" Foreground="#CBD5E1" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Button>

                    <Border CornerRadius="8" Width="44" Height="38" Background="Transparent" Margin="0,0,10,0" ClipToBounds="True">
                        <Image Source="/Assets/vas-logo-nobg.png" Stretch="UniformToFill" Height="38" VerticalAlignment="Top" />
                    </Border>

                    <TextBlock Text="Leads Management System" FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />

                    <!-- Distinctive Agent Portal Badge -->
                    <Border Background="#064E3B" BorderBrush="#059669" BorderThickness="1" CornerRadius="10" Padding="10,3" Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="👤 AGENT PORTAL" FontSize="11" FontWeight="Bold" Foreground="#6EE7B7" />
                    </Border>
                </StackPanel>

                <!-- Right: User Session & Sign Out -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- User Chip -->
                    <Border Background="#334155" CornerRadius="6" Padding="10,6" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="👤 " FontSize="12" Foreground="#F8FAFC" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ActiveUser}" Foreground="#F8FAFC" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Border Background="#10B981" CornerRadius="8" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Standard Agent" FontSize="10" FontWeight="Bold" Foreground="White" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Sign Out Button -->
                    <Button Content="Sign Out" 
                            Command="{Binding LogoutCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Foreground="#CBD5E1"
                            BorderBrush="#475569"
                            Padding="12,6"
                            FontSize="12" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========================================== -->
        <!-- WORKSPACE: SIDEBAR + AGENT CONTENT         -->
        <!-- ========================================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" /> <!-- Agent Sidebar -->
                <ColumnDefinition Width="*" />    <!-- Content Region -->
            </Grid.ColumnDefinitions>

            <!-- LEFT NAVIGATION SIDEBAR -->
            <Border Grid.Column="0" 
                    Width="{Binding UserDashboard.SidebarWidth}"
                    Background="{StaticResource SidebarBgBrush}" 
                    BorderBrush="#334155" 
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Section Header -->
                    <TextBlock Grid.Row="0" 
                               Text="AGENT WORKSPACE" 
                               FontSize="11" 
                               FontWeight="SemiBold" 
                               Foreground="#64748B" 
                               Margin="20,20,20,10">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding UserDashboard.IsSidebarCollapsed}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Nav Buttons -->
                    <StackPanel Grid.Row="1">
                        <!-- 1. My Dashboard -->
                        <Button Command="{Binding UserDashboard.NavigateUserCommand}" 
                                CommandParameter="UserDashboard"
                                ToolTip="Agent Dashboard">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding UserDashboard.CurrentUserView}" Value="UserDashboard">
                                            <Setter Property="Tag" Value="Active" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📊" FontSize="15" Width="26" TextAlignment="Center" VerticalAlignment="Center" />
                                <TextBlock Text="My Dashboard" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding UserDashboard.IsSidebarCollapsed}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button>

                        <!-- 2. My Assigned Leads -->
                        <Button Command="{Binding UserDashboard.NavigateUserCommand}" 
                                CommandParameter="MyLeads"
                                ToolTip="My Assigned Leads">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding UserDashboard.CurrentUserView}" Value="MyLeads">
                                            <Setter Property="Tag" Value="Active" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📞" FontSize="15" Width="26" TextAlignment="Center" VerticalAlignment="Center" />
                                <TextBlock Text="My Assigned Leads" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding UserDashboard.IsSidebarCollapsed}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button>

                        <!-- 3. Follow-up Tasks -->
                        <Button Command="{Binding UserDashboard.NavigateUserCommand}" 
                                CommandParameter="Tasks"
                                ToolTip="Follow-up Call Tasks">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding UserDashboard.CurrentUserView}" Value="Tasks">
                                            <Setter Property="Tag" Value="Active" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📝" FontSize="15" Width="26" TextAlignment="Center" VerticalAlignment="Center" />
                                <TextBlock Text="Follow-up Queue" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding UserDashboard.IsSidebarCollapsed}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button>

                        <Rectangle Height="1" Fill="#1E293B" Margin="14,14" />

                        <!-- 4. Profile / Settings -->
                        <Button Command="{Binding UserDashboard.NavigateUserCommand}" 
                                CommandParameter="Profile"
                                ToolTip="Agent Profile">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding UserDashboard.CurrentUserView}" Value="Profile">
                                            <Setter Property="Tag" Value="Active" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="⚙️" FontSize="15" Width="26" TextAlignment="Center" VerticalAlignment="Center" />
                                <TextBlock Text="My Profile" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding UserDashboard.IsSidebarCollapsed}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Sidebar Footer -->
                    <Border Grid.Row="2" Background="#0A0F1D" Padding="14,12">
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding UserDashboard.IsSidebarCollapsed}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="Virtual Assistant Services" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" />
                            <TextBlock Text="Agent Workspace • 2026" FontSize="10" Foreground="#475569" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- MAIN CONTENT AREA -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="32,28,32,32">

                    <!-- Welcome Hero Header -->
                    <Border Style="{StaticResource CardBorderStyle}" Padding="26,22" Margin="0,0,0,24" Background="#FFFFFF">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Welcome back, " FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding ActiveUser}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" />
                                    <TextBlock Text=" 👋" FontSize="22" />
                                </StackPanel>
                                <TextBlock Text="Here is your active outreach pipeline and assigned inquiries queue for today." 
                                           FontSize="13" 
                                           Foreground="{StaticResource TextSecondaryBrush}" 
                                           Margin="0,4,0,0" />
                            </StackPanel>

                            <Border Grid.Column="1" Background="#F1F5F9" CornerRadius="8" Padding="14,8" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="📅 Status: " FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="Ready for Outreach" FontSize="12" FontWeight="Bold" Foreground="#059669" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- 4 Summary KPI Cards for Agent -->
                    <Grid Margin="0,0,0,28">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Card 1: Assigned Leads -->
                        <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="20">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <TextBlock Text="ASSIGNED LEADS" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <Border Background="#EFF6FF" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right">
                                        <TextBlock Text="📋 Total" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" />
                                    </Border>
                                </Grid>
                                <TextBlock Text="{Binding UserDashboard.AssignedLeadsCount}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="Leads assigned in queue" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Card 2: Calls To Make -->
                        <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="20">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <TextBlock Text="CALLS TO MAKE" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <Border Background="#FEF3C7" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right">
                                        <TextBlock Text="⚡ Pending" FontSize="10.5" FontWeight="SemiBold" Foreground="#D97706" />
                                    </Border>
                                </Grid>
                                <TextBlock Text="{Binding UserDashboard.PendingCallsCount}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="Pending direct outreach" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Card 3: Qualified Today -->
                        <Border Grid.Column="4" Style="{StaticResource CardBorderStyle}" Padding="20">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <TextBlock Text="QUALIFIED TODAY" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <Border Background="#ECFDF5" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right">
                                        <TextBlock Text="🎯 Converted" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" />
                                    </Border>
                                </Grid>
                                <TextBlock Text="{Binding UserDashboard.QualifiedLeadsCount}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="Interest confirmed" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Card 4: Scheduled Follow-ups -->
                        <Border Grid.Column="6" Style="{StaticResource CardBorderStyle}" Padding="20">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <TextBlock Text="FOLLOW-UPS" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <Border Background="#F5F3FF" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right">
                                        <TextBlock Text="⏰ Scheduled" FontSize="10.5" FontWeight="SemiBold" Foreground="#7C3AED" />
                                    </Border>
                                </Grid>
                                <TextBlock Text="{Binding UserDashboard.FollowUpsCount}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="Callbacks scheduled" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Bottom Workspace: Calling Queue + Guidelines -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.2*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: Calling Queue Table Preview -->
                        <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="22">
                            <StackPanel>
                                <Grid Margin="0,0,0,16">
                                    <TextBlock Text="📞 Assigned Leads Calling Queue" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="Active Queue" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>

                                <DataGrid ItemsSource="{Binding UserDashboard.MockAssignedLeads}" 
                                          Style="{StaticResource ModernDataGridStyle}"
                                          GridLinesVisibility="None"
                                          MinHeight="220"
                                          AutoGenerateColumns="False">
                                    <DataGrid.Columns>
                                        <!-- Status -->
                                        <DataGridTemplateColumn Header="STATUS" Width="110">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border CornerRadius="10" Padding="8,3" BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#EFF6FF" />
                                                                <Setter Property="BorderBrush" Value="#BFDBFE" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Qualified">
                                                                        <Setter Property="Background" Value="#ECFDF5" />
                                                                        <Setter Property="BorderBrush" Value="#A7F3D0" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Follow-up">
                                                                        <Setter Property="Background" Value="#FFFBEB" />
                                                                        <Setter Property="BorderBrush" Value="#FDE68A" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Contacted">
                                                                        <Setter Property="Background" Value="#F5F3FF" />
                                                                        <Setter Property="BorderBrush" Value="#DDD6FE" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="#1D4ED8" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Status}" Value="Qualified">
                                                                            <Setter Property="Foreground" Value="#047857" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Status}" Value="Follow-up">
                                                                            <Setter Property="Foreground" Value="#B45309" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Status}" Value="Contacted">
                                                                            <Setter Property="Foreground" Value="#6D28D9" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <!-- Business Name -->
                                        <DataGridTextColumn Header="BUSINESS NAME" Binding="{Binding BusinessName}" Width="190" FontWeight="SemiBold" />

                                        <!-- Contact Name -->
                                        <DataGridTextColumn Header="CONTACT PERSON" Binding="{Binding ContactName}" Width="150" />

                                        <!-- Phone -->
                                        <DataGridTemplateColumn Header="PHONE NUMBER" Width="140">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding FormattedPhone}" FontFamily="Consolas, Segoe UI" FontSize="12" VerticalAlignment="Center" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <!-- City -->
                                        <DataGridTextColumn Header="CITY" Binding="{Binding City}" Width="110" />

                                        <!-- Action -->
                                        <DataGridTemplateColumn Header="ACTION" Width="110">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="📞 Call" 
                                                            Style="{StaticResource PrimaryButtonStyle}" 
                                                            Padding="10,4" 
                                                            FontSize="11" 
                                                            VerticalAlignment="Center" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <!-- Right: Agent Guidelines Card -->
                        <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="22">
                            <StackPanel>
                                <TextBlock Text="Agent Guidelines" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,14" />

                                <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="🎯 Standard Outreach Role" FontWeight="Bold" FontSize="12" Foreground="#1E40AF" />
                                        <TextBlock Text="You are logged in with the Standard Agent role. You have focused access to assigned leads and call queues without system administrative privileges." 
                                                   FontSize="11.5" 
                                                   Foreground="#1E40AF" 
                                                   TextWrapping="Wrap" 
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>

                                <Border Background="#F8FAFC" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="DISPOSITION CRITERIA" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Text="• Qualified: Lead confirmed interest and meets business criteria." FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                        <TextBlock Text="• Follow-up: Decision maker requested a specific callback." FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                        <TextBlock Text="• Contacted: Pitch completed, awaiting review." FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="6" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="⚡ Need More Leads?" FontWeight="Bold" FontSize="12" Foreground="#065F46" />
                                        <TextBlock Text="New leads are imported and assigned to your queue by administrators." 
                                                   FontSize="11.5" 
                                                   Foreground="#065F46" 
                                                   TextWrapping="Wrap" 
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>

