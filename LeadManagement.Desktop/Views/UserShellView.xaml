<UserControl x:Class="LeadManagement.Desktop.Views.UserShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodels="clr-namespace:LeadManagement.Desktop.ViewModels"
             xmlns:models="clr-namespace:LeadManagement.Desktop.Models"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=viewmodels:MainViewModel, IsDesignTimeCreatable=True}"
             d:DesignHeight="850" d:DesignWidth="1240"
             FontFamily="{StaticResource AppFontFamily}"
             Background="{StaticResource WindowBgBrush}">

    <UserControl.Resources>
        <!-- Ghost export button (Blue theme) -->
        <Style x:Key="ExportButtonStyle" TargetType="Button">
            <Setter Property="FontFamily"   Value="{StaticResource AppFontFamily}"/>
            <Setter Property="FontSize"     Value="12"/>
            <Setter Property="FontWeight"   Value="SemiBold"/>
            <Setter Property="Foreground"   Value="#2563EB"/>
            <Setter Property="Background"   Value="#EFF6FF"/>
            <Setter Property="BorderBrush"  Value="#BFDBFE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"      Value="10,5"/>
            <Setter Property="Cursor"       Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#DBEAFE"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#93C5FD"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#BFDBFE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Zoom Call icon button style (Green dial button) -->
        <Style x:Key="CallIconButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Background" Value="#10B981"/>
            <Setter Property="BorderBrush" Value="#059669"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip" Value="Call via Zoom Phone"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#059669"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#047857"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#047857"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger / Cancel button (red ghost) -->
        <Style x:Key="DangerButtonStyle" TargetType="Button">
            <Setter Property="FontFamily"      Value="{StaticResource AppFontFamily}"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Foreground"      Value="#DC2626"/>
            <Setter Property="Background"      Value="#FEF2F2"/>
            <Setter Property="BorderBrush"     Value="#FECACA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="10,5"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background"  Value="#FEE2E2"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#FCA5A5"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FECACA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Centered DataGrid cell style – eliminates cell underline and borders -->
        <Style x:Key="CenteredCellStyle" TargetType="DataGridCell">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="{x:Null}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                Padding="6,0"
                                SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#EFF6FF"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60" /> <!-- Top Bar -->
            <RowDefinition Height="*" />  <!-- Main Workspace -->
        </Grid.RowDefinitions>

        <!-- ========================================== -->
        <!-- FIXED TOP NAVIGATION BAR (USER PORTAL)     -->
        <!-- ========================================== -->
        <Border Grid.Row="0" Background="{StaticResource TopbarBgBrush}" BorderBrush="#334155" BorderThickness="0,0,0,1" Padding="20,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Branding & Agent Portal Badge -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Toggle Sidebar Button -->
                    <Button Command="{Binding UserDashboard.ToggleSidebarCommand}"
                            Style="{StaticResource NavToggleButtonStyle}"
                            ToolTip="Toggle Sidebar (Expand / Collapse)"
                            Margin="0,0,14,0">
                        <TextBlock Text="☰" FontSize="16" Foreground="#CBD5E1" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Button>

                    <Border CornerRadius="8" Width="44" Height="38" Background="Transparent" Margin="0,0,10,0" ClipToBounds="True">
                        <Image Source="/Assets/vas-logo-nobg.png" Stretch="UniformToFill" Height="38" VerticalAlignment="Top" />
                    </Border>

                    <TextBlock Text="Leads Management System" FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />

                     
                </StackPanel>

                <!-- Right: User Session & Sign Out -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- User Chip -->
                    <Border Background="#334155" CornerRadius="6" Padding="10,6" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="👤 " FontSize="12" Foreground="#F8FAFC" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ActiveUser}" Foreground="#F8FAFC" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                             
                        </StackPanel>
                    </Border>

                    <!-- Sign Out Button -->
                    <Button Content="Sign Out" 
                            Command="{Binding LogoutCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Foreground="#CBD5E1"
                            BorderBrush="#475569"
                            Padding="12,6"
                            FontSize="12" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========================================== -->
        <!-- WORKSPACE: SIDEBAR + AGENT CONTENT         -->
        <!-- ========================================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" /> <!-- Agent Sidebar -->
                <ColumnDefinition Width="*" />    <!-- Content Region -->
            </Grid.ColumnDefinitions>

            <!-- LEFT NAVIGATION SIDEBAR (Only 'My Assigned Leads') -->
            <Border Grid.Column="0" 
                    Width="{Binding UserDashboard.SidebarWidth}"
                    Background="{StaticResource SidebarBgBrush}" 
                    BorderBrush="#334155" 
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Section Header -->
                    <TextBlock Grid.Row="0" 
                               Text="AGENT WORKSPACE" 
                               FontSize="11" 
                               FontWeight="SemiBold" 
                               Foreground="#64748B" 
                               Margin="20,20,20,10">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding UserDashboard.IsSidebarCollapsed}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Nav Buttons (Only 'My Assigned Leads') -->
                    <StackPanel Grid.Row="1">
                        <Button ToolTip="My Assigned Leads"
                                Style="{StaticResource SidebarNavButtonStyle}"
                                Tag="Active">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📁" FontSize="15" Width="26" TextAlignment="Center" VerticalAlignment="Center" />
                                <TextBlock Text="My Assigned Leads" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding UserDashboard.IsSidebarCollapsed}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Sidebar Footer -->
                    <Border Grid.Row="2" Background="#0A0F1D" Padding="14,12">
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding UserDashboard.IsSidebarCollapsed}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="Virtual Assistant Services Outsourcing" FontSize="11" Foreground="#475569" FontWeight="SemiBold" />
                            <TextBlock Text="2026" FontSize="10" Foreground="#334155" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- MAIN CONTENT AREA: ASSIGNED CLIENTS OR FULL LEAD FILE VIEW -->
            <Grid Grid.Column="1" Background="#F8FAFC">
                <!-- ============================================================== -->
                <!-- PAGE 1: MY ASSIGNED CLIENTS LIST                              -->
                <!-- ============================================================== -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" 
                              HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding UserDashboard.IsPreviewOpen, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <StackPanel Margin="32,28,32,32">

                        <!-- Page Header -->
                        <Grid Margin="0,0,0,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="My Assigned Clients" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <Border Background="#EFF6FF" CornerRadius="10" Padding="10,3" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding UserDashboard.AssignedClients.Count, StringFormat={}{0} clients}"
                                                   FontSize="12" FontWeight="SemiBold" Foreground="#2563EB"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="View lead files, preview client data, and dial leads assigned to you by administrators."
                                           FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                            </StackPanel>

                            <!-- Refresh Button -->
                            <Button Grid.Column="1"
                                    Command="{Binding UserDashboard.RefreshCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="14,8" VerticalAlignment="Center">
                                <TextBlock Text="🔄 Refresh"/>
                            </Button>
                        </Grid>

                        <!-- Notification Banner -->
                        <Border BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,16"
                                Visibility="{Binding UserDashboard.IsBannerVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <!-- Default: success (green) -->
                                    <Setter Property="Background"  Value="#ECFDF5"/>
                                    <Setter Property="BorderBrush" Value="#A7F3D0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding UserDashboard.IsBannerError}" Value="True">
                                            <Setter Property="Background"  Value="#FEF2F2"/>
                                            <Setter Property="BorderBrush" Value="#FECACA"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding UserDashboard.StatusBannerMessage}"
                                           FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                           TextWrapping="Wrap" Margin="0,0,32,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#065F46"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding UserDashboard.IsBannerError}" Value="True">
                                                    <Setter Property="Foreground" Value="#DC2626"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Button Grid.Column="1" Command="{Binding UserDashboard.DismissBannerCommand}"
                                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                                        Content="✕" FontSize="12" Foreground="#94A3B8" Padding="4,2"
                                        HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Empty State (When no clients are assigned) -->
                        <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="12" Padding="48,40" Margin="0,8,0,0"
                                Visibility="{Binding UserDashboard.HasNoAssignedClients, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="📁" FontSize="44" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                <TextBlock Text="No Clients Assigned Yet" FontSize="17" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="You currently do not have any clients assigned to your account.&#x0a;When an administrator assigns clients and leads to you, they will appear here automatically."
                                           FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"
                                           TextAlignment="Center" Margin="0,8,0,20"/>
                                <Button Content="🔄 Check for New Assignments"
                                        Command="{Binding UserDashboard.RefreshCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="16,8" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- ASSIGNED CLIENTS LIST (Foldering Accordion) -->
                        <ItemsControl ItemsSource="{Binding UserDashboard.AssignedClients}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                            CornerRadius="10" Margin="0,0,0,12" SnapsToDevicePixels="True">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#0F172A" BlurRadius="8" ShadowDepth="1" Direction="270" Opacity="0.04"/>
                                        </Border.Effect>

                                        <StackPanel>
                                            <!-- Client Folder Header (Clickable anywhere to expand/collapse) -->
                                            <Border Background="Transparent" Padding="18,14" Cursor="Hand">
                                                <Border.InputBindings>
                                                    <MouseBinding MouseAction="LeftClick"
                                                                  Command="{Binding DataContext.UserDashboard.ToggleExpandCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                  CommandParameter="{Binding}"/>
                                                </Border.InputBindings>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/> <!-- Expand arrow -->
                                                        <ColumnDefinition Width="Auto"/> <!-- Folder icon -->
                                                        <ColumnDefinition Width="*"/>    <!-- Client Name & Badges -->
                                                        <ColumnDefinition Width="Auto"/> <!-- View Script Button (View-Only for Agents) -->
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Expand Arrow Button -->
                                                    <Button Grid.Column="0"
                                                            Command="{Binding DataContext.UserDashboard.ToggleExpandCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                            VerticalAlignment="Center" Margin="0,0,10,0" Padding="4">
                                                        <TextBlock FontSize="12" Foreground="#64748B" FontWeight="Bold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="▶"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                            <Setter Property="Text" Value="▼"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Button>

                                                    <!-- Folder Icon -->
                                                    <TextBlock Grid.Column="1" Text="📁" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0"/>

                                                    <!-- Client Name & Badges -->
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding FullName}" FontSize="15" FontWeight="Bold"
                                                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>

                                                        <!-- File count badge -->
                                                        <Border Background="#F1F5F9" CornerRadius="6" Padding="8,3" Margin="14,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding FileCount, StringFormat={}{0} files}" FontSize="11" Foreground="#475569" FontWeight="Medium"/>
                                                        </Border>

                                                        <!-- Leads count badge -->
                                                        <Border Background="#EFF6FF" CornerRadius="6" Padding="8,3" Margin="8,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding TotalLeads, StringFormat={}{0:N0} leads}" FontSize="11" Foreground="#2563EB" FontWeight="Medium"/>
                                                        </Border>

                                                        <!-- Assigned to you chip -->
                                                        <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="8,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="👤 Assigned to you" FontSize="11" Foreground="#047857" FontWeight="SemiBold"/>
                                                        </Border>
                                                    </StackPanel>

                                                    <!-- ACTION BUTTONS: SCRIPT & LEADS -->
                                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Command="{Binding DataContext.UserDashboard.ViewScriptCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Visibility="{Binding HasScript, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                Style="{StaticResource SecondaryButtonStyle}"
                                                                Padding="12,6" Margin="0,0,8,0" VerticalAlignment="Center" FontSize="12"
                                                                ToolTip="{Binding ScriptName, StringFormat='View calling script: {0}'}">
                                                            <TextBlock Text="📄 View Script"/>
                                                        </Button>

                                                        <Button Command="{Binding DataContext.UserDashboard.ViewClientLeadsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource PrimaryButtonStyle}"
                                                                Padding="12,6" VerticalAlignment="Center" FontSize="12"
                                                                ToolTip="Open leads workspace to call and update leads">
                                                            <TextBlock Text="📊 View Leads"/>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <!-- EXPANDED CONTENT: Client's Leads & Files -->
                                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,16" Background="#FAFAFA"
                                                    Visibility="{Binding IsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <StackPanel>
                                                    <!-- Client Leads Summary Card -->
                                                    <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                            CornerRadius="8" Padding="16,14" Margin="0,0,0,10">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="👥" FontSize="24" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding FullName, StringFormat='{}{0}\'s Assigned Leads'}"
                                                                               FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                                    <Border Background="#EFF6FF" CornerRadius="6" Padding="8,2" Margin="10,0,0,0">
                                                                        <TextBlock Text="{Binding TotalLeads, StringFormat='{}{0:N0} leads'}"
                                                                                   FontSize="11.5" Foreground="#2563EB" FontWeight="Bold"/>
                                                                    </Border>
                                                                </StackPanel>
                                                                <TextBlock Text="Synchronized directly with the centralized Lead Masterlist."
                                                                           FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0"/>
                                                            </StackPanel>
                                                            <Button Grid.Column="2"
                                                                    Command="{Binding DataContext.UserDashboard.ViewClientLeadsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Style="{StaticResource PrimaryButtonStyle}"
                                                                    Padding="14,7" FontSize="12"
                                                                    ToolTip="Open leads workspace to view, call, and update leads">
                                                                <TextBlock Text="👁 Open Leads Workspace"/>
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                    <TextBlock Text="Client Leads Files" FontSize="12" FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10"/>

                                                    <!-- Files List -->
                                                    <ItemsControl ItemsSource="{Binding Files}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                                        CornerRadius="8" Padding="14,10" Margin="0,0,0,8">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto"/> <!-- File Icon -->
                                                                            <ColumnDefinition Width="*"/>    <!-- Name, Size, Date -->
                                                                            <ColumnDefinition Width="Auto"/> <!-- Leads Badge -->
                                                                            <ColumnDefinition Width="Auto"/> <!-- Preview Button -->
                                                                            <ColumnDefinition Width="Auto"/> <!-- Export Button -->
                                                                        </Grid.ColumnDefinitions>

                                                                        <TextBlock Grid.Column="0" Text="📄" FontSize="20" VerticalAlignment="Center" Margin="0,0,12,0"/>

                                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding FileName}" FontSize="13" FontWeight="SemiBold"
                                                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                                                <TextBlock Text="{Binding FileSize}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                                                <TextBlock Text=" · " FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                                                <TextBlock Text="{Binding FormattedDate}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                                            </StackPanel>
                                                                        </StackPanel>

                                                                        <!-- Leads badge -->
                                                                        <Border Grid.Column="2" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1"
                                                                                CornerRadius="6" Padding="8,4" VerticalAlignment="Center" Margin="0,0,12,0">
                                                                            <TextBlock FontSize="11.5" Foreground="#2563EB" FontWeight="SemiBold">
                                                                                <Run Text="{Binding TotalLeads, Mode=OneWay, StringFormat={}{0:N0}}"/>
                                                                                <Run Text=" leads"/>
                                                                            </TextBlock>
                                                                        </Border>

                                                                        <!-- Preview Button -->
                                                                        <Button Grid.Column="3"
                                                                                Command="{Binding DataContext.UserDashboard.PreviewFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                CommandParameter="{Binding}"
                                                                                Style="{StaticResource SecondaryButtonStyle}"
                                                                                Padding="12,6" Margin="0,0,8,0" FontSize="11.5"
                                                                                ToolTip="View and call leads in this file">
                                                                            <TextBlock Text="👁 View"/>
                                                                        </Button>

                                                                        <!-- Export Button (Agent work export) -->
                                                                        <Button Grid.Column="4"
                                                                                Command="{Binding DataContext.UserDashboard.ExportFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                CommandParameter="{Binding}"
                                                                                Style="{StaticResource ExportButtonStyle}"
                                                                                Padding="12,6" FontSize="11.5"
                                                                                ToolTip="Export updated leads with latest call records and notes">
                                                                            <TextBlock Text="📥 Export"/>
                                                                        </Button>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <!-- Empty Files Placeholder -->
                                                    <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                            CornerRadius="8" Padding="16"
                                                            Visibility="{Binding Files.Count, Converter={StaticResource ZeroToVisibilityConverter}, FallbackValue=Collapsed}">
                                                        <TextBlock Text="No files available for this client yet." FontSize="12" Foreground="#64748B" HorizontalAlignment="Center"/>
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>
                </ScrollViewer>

                <!-- ============================================================== -->
                <!-- PAGE 2: FULL LEAD FILE VIEW (NEXT PAGE WITH BACK BUTTON)       -->
                <!-- ============================================================== -->
                <Grid Visibility="{Binding UserDashboard.IsPreviewOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
                      Background="White">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>  <!-- Header Bar with Upper-Left Back Button -->
                        <RowDefinition Height="Auto"/>  <!-- Search & Stats Toolbar -->
                        <RowDefinition Height="*"/>     <!-- Edge-to-Edge DataGrid Table -->
                        <RowDefinition Height="Auto"/>  <!-- Footer Bar -->
                    </Grid.RowDefinitions>

                    <!-- ROW 0: HEADER BAR WITH UPPER-LEFT BACK BUTTON -->
                    <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/> <!-- Back button -->
                                <ColumnDefinition Width="*"/>    <!-- File title & meta -->
                                <ColumnDefinition Width="Auto"/> <!-- Status badge & Actions -->
                            </Grid.ColumnDefinitions>

                            <!-- Upper Left Back Button -->
                            <Button Grid.Column="0"
                                    Command="{Binding UserDashboard.ClosePreviewCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="14,8"
                                    Margin="0,0,18,0"
                                    VerticalAlignment="Center"
                                    ToolTip="Return to Assigned Clients list">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="←" FontSize="15" FontWeight="Bold" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{StaticResource PrimaryBrush}"/>
                                    <TextBlock Text="Back" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Title & Subtitle -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                     
                                    <TextBlock Text="{Binding UserDashboard.PreviewTitle}" FontSize="18" FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <TextBlock Text="{Binding UserDashboard.PreviewSubtitle}" FontSize="12.5"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0"/>
                            </StackPanel>

                             
                        </Grid>
                    </Border>

                    <!-- ROW 1: SEARCH & FILTER TOOLBAR -->
                    <Border Grid.Row="1" Background="#F8FAFC" Padding="24,12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            

                            <!-- Quick Total Leads Chip -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,6">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="📊 Total Leads: " FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding UserDashboard.FilteredPreviewLeads.Count, Mode=OneWay, StringFormat={}{0:N0}}"
                                                   FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Instant Search Box -->
                            <Grid Grid.Column="1" MaxWidth="780" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBox Text="{Binding UserDashboard.PreviewSearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ModernTextBoxStyle}"
                                         Padding="38,0,12,0"
                                         Width="480"
                                         Height="40"/>
                                         
                                <TextBlock Text="🔍" Foreground="#94A3B8" FontSize="13"
                                           VerticalAlignment="Center" HorizontalAlignment="Left" Margin="12,0,0,0"
                                           IsHitTestVisible="False"/>
                                <TextBlock Text="Search business name, contact, phone, disposition, agent, notes…"
                                           Foreground="#94A3B8" FontSize="12"
                                           VerticalAlignment="Center" Margin="38,0,0,0"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding UserDashboard.PreviewSearchText}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding UserDashboard.PreviewSearchText}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- ROW 2: FULL DATA GRID TABLE -->
                    <Grid Grid.Row="2" Background="White">
                        <!-- Loading Preview Spinner -->
                        <Border Visibility="{Binding UserDashboard.IsLoadingPreview, Converter={StaticResource BooleanToVisibilityConverter}}"
                                VerticalAlignment="Center" HorizontalAlignment="Center">
                            <StackPanel>
                                <TextBlock Text="⏳" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                <TextBlock Text="Loading leads data…" FontSize="13" Foreground="#64748B" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Preview Data Grid (Full Width & Height) -->
                        <DataGrid ItemsSource="{Binding UserDashboard.FilteredPreviewLeads}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  SelectionMode="Single"
                                  GridLinesVisibility="None"
                                  HorizontalGridLinesBrush="{x:Null}"
                                  VerticalGridLinesBrush="{x:Null}"
                                  Background="White"
                                  RowBackground="White"
                                  AlternatingRowBackground="#F8FAFC"
                                  BorderThickness="0"
                                  ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeaderStyle}"
                                  RowStyle="{StaticResource ModernDataGridRowStyle}"
                                  CellStyle="{StaticResource CenteredCellStyle}"
                                  AlternationCount="2"
                                  RowHeight="40"
                                  EnableRowVirtualization="True"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Standard"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Auto"
                                  Visibility="{Binding UserDashboard.IsLoadingPreview, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                            <DataGrid.Resources>
                                <!-- Global cell text style -->
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="TextDecorations" Value="{x:Null}"/>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <!-- 0. PROFILE Button (Very Left First Column) -->
                                <DataGridTemplateColumn Header="PROFILE" Width="73" CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.UserDashboard.OpenLeadProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Height="28" Width="36" Padding="0"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    ToolTip="Open lead profile, edit all fields &amp; view call history">
                                                <TextBlock Text="👤" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- 1. DATE (Read-only display; edit via Profile modal) -->
                                <DataGridTemplateColumn Header="DATE" Width="115" CanUserSort="True" SortMemberPath="CallDate">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock FontSize="12" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="{Binding CallDate}"/>
                                                        <Setter Property="Foreground" Value="#0F172A"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CallDate}" Value="">
                                                                <Setter Property="Text" Value="—"/>
                                                                <Setter Property="Foreground" Value="#94A3B8"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding CallDate}" Value="{x:Null}">
                                                                <Setter Property="Text" Value="—"/>
                                                                <Setter Property="Foreground" Value="#94A3B8"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- 2. CALL DISPOSITION (Read-only color-coded badge; edit via Profile modal) -->
                                <DataGridTemplateColumn Header="CALL DISPOSITION" Width="165" CanUserSort="True" SortMemberPath="CallDisposition">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid VerticalAlignment="Center">
                                                <Border Background="{Binding DispositionInfo.BackgroundHex}"
                                                        BorderBrush="{Binding DispositionInfo.BorderHex}"
                                                        BorderThickness="1" CornerRadius="8"
                                                        Padding="8,3" HorizontalAlignment="Left">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding CallDisposition}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding CallDisposition}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding CallDisposition}"
                                                               Foreground="{Binding DispositionInfo.ForegroundHex}"
                                                               FontWeight="SemiBold" FontSize="11.5"/>
                                                </Border>
                                                <TextBlock Text="—" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding CallDisposition}" Value="">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding CallDisposition}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- 3. AGENT (Read-only display; edit via Profile modal) -->
                                <DataGridTemplateColumn Header="AGENT" Width="140" CanUserSort="True" SortMemberPath="AssignedAgent">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="{Binding AssignedAgent, StringFormat='👤 {0}'}"/>
                                                        <Setter Property="Foreground" Value="#0F172A"/>
                                                        <Setter Property="FontWeight" Value="Medium"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding AssignedAgent}" Value="">
                                                                <Setter Property="Text" Value="— Unassigned —"/>
                                                                <Setter Property="Foreground" Value="#94A3B8"/>
                                                                <Setter Property="FontStyle" Value="Italic"/>
                                                                <Setter Property="FontWeight" Value="Normal"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding AssignedAgent}" Value="{x:Null}">
                                                                <Setter Property="Text" Value="— Unassigned —"/>
                                                                <Setter Property="Foreground" Value="#94A3B8"/>
                                                                <Setter Property="FontStyle" Value="Italic"/>
                                                                <Setter Property="FontWeight" Value="Normal"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- 4. NOTES (Read-only display; edit via Profile modal) -->
                                <DataGridTemplateColumn Header="NOTES" Width="190" CanUserSort="True" SortMemberPath="Notes">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Notes}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="{Binding Notes}"/>
                                                        <Setter Property="Foreground" Value="#334155"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Notes}" Value="">
                                                                <Setter Property="Text" Value="—"/>
                                                                <Setter Property="Foreground" Value="#94A3B8"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Notes}" Value="{x:Null}">
                                                                <Setter Property="Text" Value="—"/>
                                                                <Setter Property="Foreground" Value="#94A3B8"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- 5. # OF CALL (Auto-incremented on Dial, Not editable) -->
                                <DataGridTemplateColumn Header="# OF CALL" Width="95" CanUserSort="True" SortMemberPath="CallCount">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="5"
                                                    Height="28" Width="48" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding CallCount}" 
                                                           FontWeight="Bold" FontSize="12" Foreground="#0F172A"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           ToolTip="Total calls dialed to this lead (auto-increments upon calling)"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- 6. CELL NUMBER (Read-only display with Zoom Call Button on Left) -->
                                <DataGridTemplateColumn Header="CELL NUMBER" Width="160" CanUserSort="True" SortMemberPath="CellNumber">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Call Button: Dials number in Zoom & increments # of call -->
                                                <Button Grid.Column="0"
                                                        Command="{Binding DataContext.UserDashboard.CallLeadCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource CallIconButtonStyle}"
                                                        Margin="0,0,8,0"
                                                        ToolTip="Call this number via Zoom Phone (auto-increments # OF CALL)">
                                                    <Path Data="M3.654 1.328a.678.678 0 0 0-1.015-.063L1.605 2.3c-.483.484-.661 1.169-.45 1.77a17.6 17.6 0 0 0 4.168 6.608 17.6 17.6 0 0 0 6.608 4.168c.601.211 1.286.033 1.77-.45l1.034-1.034a.678.678 0 0 0-.063-1.015l-2.307-1.794a.68.68 0 0 0-.58-.122l-2.19.547a1.75 1.75 0 0 1-1.657-.459L5.482 8.062a1.75 1.75 0 0 1-.46-1.657l.548-2.19a.68.68 0 0 0-.122-.58z"
                                                          Fill="White" Stretch="Uniform" Width="12" Height="12"/>
                                                </Button>

                                                <!-- Cell Number (Read-only selectable text) -->
                                                <TextBox Grid.Column="1"
                                                         Text="{Binding CellNumber, Mode=OneWay}"
                                                         Style="{StaticResource SelectableTextStyle}"
                                                         FontSize="12"
                                                         VerticalAlignment="Center"
                                                         ToolTip="{Binding CellNumber}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- 7. BUSINESS NAME (Read-only) -->
                                <DataGridTemplateColumn Header="BUSINESS NAME" Width="220" CanUserSort="True" SortMemberPath="BusinessName">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding BusinessName, Mode=OneWay}"
                                                     Style="{StaticResource SelectableTextStyle}"
                                                     FontWeight="SemiBold"
                                                     VerticalAlignment="Center"
                                                     ToolTip="{Binding BusinessName}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- 8. TITLE -->
                                <DataGridTextColumn Header="TITLE" Binding="{Binding Title}" Width="120" IsReadOnly="True"/>

                                <!-- 9. CONTACT NAME (Read-only) -->
                                <DataGridTemplateColumn Header="CONTACT NAME" Width="170" CanUserSort="True" SortMemberPath="ContactName">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding ContactName, Mode=OneWay}"
                                                     Style="{StaticResource SelectableTextStyle}"
                                                     VerticalAlignment="Center"
                                                     ToolTip="{Binding ContactName}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- 10. EMAIL -->
                                <DataGridTextColumn Header="EMAIL" Binding="{Binding Email}" Width="170" IsReadOnly="True"/>

                                <!-- 11. ADDRESS -->
                                <DataGridTextColumn Header="ADDRESS" Binding="{Binding Address}" Width="190" IsReadOnly="True"/>

                                <!-- 12. CITY -->
                                <DataGridTextColumn Header="CITY" Binding="{Binding City}" Width="110" IsReadOnly="True"/>

                                <!-- 13. COUNTY -->
                                <DataGridTextColumn Header="COUNTY" Binding="{Binding County}" Width="110" IsReadOnly="True"/>

                                <!-- 14. STATE -->
                                <DataGridTextColumn Header="STATE" Binding="{Binding State}" Width="65" IsReadOnly="True"/>

                                <!-- 15. ZIP CODE -->
                                <DataGridTextColumn Header="ZIP CODE" Binding="{Binding ZipCode}" Width="85" IsReadOnly="True"/>

                                <!-- 16. FAX -->
                                <DataGridTextColumn Header="FAX" Binding="{Binding Fax}" Width="110" IsReadOnly="True"/>

                                <!-- 17. ANNUAL SALES -->
                                <DataGridTextColumn Header="ANNUAL SALES" Binding="{Binding AnnualSales}" Width="140" IsReadOnly="True"/>

                                <!-- 18. NUMBER OF EMP -->
                                <DataGridTextColumn Header="NUMBER OF EMP" Binding="{Binding NumberOfEmployees}" Width="115" IsReadOnly="True"/>

                                <!-- 19. WEBSITE -->
                                <DataGridTextColumn Header="WEBSITE" Binding="{Binding Website}" Width="160" IsReadOnly="True"/>

                                <!-- 20. SIC CODE -->
                                <DataGridTextColumn Header="SIC CODE" Binding="{Binding SicCode}" Width="95" IsReadOnly="True"/>

                                <!-- 21. SIC DESCRIPTION -->
                                <DataGridTextColumn Header="SIC DESCRIPTION" Binding="{Binding SicDescription}" Width="170" IsReadOnly="True"/>

                                <!-- 22. NAICS CODE -->
                                <DataGridTextColumn Header="NAICS CODE" Binding="{Binding NaicsCode}" Width="95" IsReadOnly="True"/>

                                <!-- 23. NAICS DESCRIPTION -->
                                <DataGridTextColumn Header="NAICS DESCRIPTION" Binding="{Binding NaicsDescription}" Width="170" IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                     
                </Grid>
            </Grid>
        </Grid>

        <!-- ===== LEAD PROFILE & CALL/CLIENT HISTORY MODAL ===== -->
        <Grid Grid.RowSpan="2"
              Background="#990F172A"
              Panel.ZIndex="150"
              Visibility="{Binding UserDashboard.IsLeadProfileModalOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="White"
                    CornerRadius="14"
                    Width="920"
                    MaxHeight="780"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="36" ShadowDepth="6" Opacity="0.25" Color="#000000" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Modal Header -->
                    <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" CornerRadius="14,14,0,0" Padding="24,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="👤 " FontSize="18" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding UserDashboard.ProfileBusinessName}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="Edit any lead details below or review call &amp; multi-client assignment history."
                                           FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1" Command="{Binding UserDashboard.CloseLeadProfileCommand}"
                                    Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="6" VerticalAlignment="Top">
                                <TextBlock Text="✕" FontSize="15" Foreground="#64748B" />
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Scrollable Body: Editable Fields + History List -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,18">
                        <StackPanel>
                            <!-- Assigned Clients Chips -->
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="ASSIGNED CLIENTS" FontSize="10.5" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,6" />
                                    <ItemsControl ItemsSource="{Binding UserDashboard.ProfileAssignedClients}"
                                                  Visibility="{Binding UserDashboard.HasProfileAssignedClients, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#EEF2FF" BorderBrush="#C7D2FE" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,6,4">
                                                    <TextBlock Text="{Binding DisplayLabel}" FontSize="11.5" FontWeight="SemiBold" Foreground="#3730A3" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="Not assigned to any client yet." FontSize="12" Foreground="#94A3B8" FontStyle="Italic">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding UserDashboard.HasProfileAssignedClients}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- Editable Lead Details Grid (3 Columns) -->
                            <TextBlock Text="LEAD DETAILS (EDITABLE)" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,10" />
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Row 0: Business Name, Contact Name, Title -->
                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,10">
                                    <TextBlock Text="Business Name" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding UserDashboard.ProfileBusinessName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Height="36" Padding="10,6" FontSize="13" />
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,10">
                                    <TextBlock Text="Contact Name" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding UserDashboard.ProfileContactName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Height="36" Padding="10,6" FontSize="13" />
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="4" Margin="0,0,0,10">
                                    <TextBlock Text="Title" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding UserDashboard.ProfileTitle, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Height="36" Padding="10,6" FontSize="13" />
                                </StackPanel>

                                <!-- Row 1: Cell Number, Email, Fax -->
                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,10">
                                    <TextBlock Text="Cell Number" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding UserDashboard.ProfileCellNumber, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Height="36" Padding="10,6" FontSize="13" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,10">
                                    <TextBlock Text="Email" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding UserDashboard.ProfileEmail, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Height="36" Padding="10,6" FontSize="13" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="4" Margin="0,0,0,10">
                                    <TextBlock Text="Fax" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding UserDashboard.ProfileFax, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Height="36" Padding="10,6" FontSize="13" />
                                </StackPanel>

                                <!-- Row 2: Website, Call Date, Call Count -->
                                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,10">
                                    <TextBlock Text="Website" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding UserDashboard.ProfileWebsite, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Height="36" Padding="10,6" FontSize="13" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,10">
                                    <TextBlock Text="Call Date" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                                    <DatePicker SelectedDate="{Binding UserDashboard.ProfileSelectedDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="36" VerticalContentAlignment="Center" BorderBrush="#CBD5E1" Background="White" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="4" Margin="0,0,0,10">
                                    <TextBlock Text="# of Calls" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding UserDashboard.ProfileCallCount, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Height="36" Padding="10,6" FontSize="13" />
                                </StackPanel>

                                <!-- Row 3: Call Disposition, Assigned Agent, Annual Sales -->
                                <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,0,10">
                                    <TextBlock Text="Call Disposition" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding Source={x:Static models:CallDispositionHelper.Dispositions}}"
                                              SelectedValue="{Binding UserDashboard.ProfileCallDisposition, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              SelectedValuePath="Name" DisplayMemberPath="Name"
                                              Height="36" BorderBrush="#CBD5E1" Background="White" />
                                </StackPanel>
                                <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,0,0,10">
                                    <TextBlock Text="Assigned Agent" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding UserDashboard.ProfileAgentOptions}"
                                              SelectedItem="{Binding UserDashboard.ProfileAssignedAgent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Height="36" BorderBrush="#CBD5E1" Background="White" />
                                </StackPanel>
                                <StackPanel Grid.Row="3" Grid.Column="4" Margin="0,0,0,10">
                                    <TextBlock Text="Annual Sales" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding UserDashboard.ProfileAnnualSales, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Height="36" Padding="10,6" FontSize="13" />
                                </StackPanel>

                                <!-- Row 4: Address, City, County -->
                                <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,0,0,10">
                                    <TextBlock Text="Address" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding UserDashboard.ProfileAddress, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Height="36" Padding="10,6" FontSize="13" />
                                </StackPanel>
                                <StackPanel Grid.Row="4" Grid.Column="2" Margin="0,0,0,10">
                                    <TextBlock Text="City" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding UserDashboard.ProfileCity, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Height="36" Padding="10,6" FontSize="13" />
                                </StackPanel>
                                <StackPanel Grid.Row="4" Grid.Column="4" Margin="0,0,0,10">
                                    <TextBlock Text="County" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding UserDashboard.ProfileCounty, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Height="36" Padding="10,6" FontSize="13" />
                                </StackPanel>

                                <!-- Row 5: State, Zip Code, Number of Employees -->
                                <StackPanel Grid.Row="5" Grid.Column="0" Margin="0,0,0,10">
                                    <TextBlock Text="State" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding UserDashboard.ProfileState, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Height="36" Padding="10,6" FontSize="13" />
                                </StackPanel>
                                <StackPanel Grid.Row="5" Grid.Column="2" Margin="0,0,0,10">
                                    <TextBlock Text="Zip Code" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding UserDashboard.ProfileZipCode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Height="36" Padding="10,6" FontSize="13" />
                                </StackPanel>
                                <StackPanel Grid.Row="5" Grid.Column="4" Margin="0,0,0,10">
                                    <TextBlock Text="Number of Employees" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding UserDashboard.ProfileNumberOfEmployees, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Height="36" Padding="10,6" FontSize="13" />
                                </StackPanel>

                                <!-- Row 6: SIC Code, SIC Description, NAICS Code -->
                                <StackPanel Grid.Row="6" Grid.Column="0" Margin="0,0,0,10">
                                    <TextBlock Text="SIC Code" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding UserDashboard.ProfileSicCode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Height="36" Padding="10,6" FontSize="13" />
                                </StackPanel>
                                <StackPanel Grid.Row="6" Grid.Column="2" Margin="0,0,0,10">
                                    <TextBlock Text="SIC Description" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding UserDashboard.ProfileSicDescription, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Height="36" Padding="10,6" FontSize="13" />
                                </StackPanel>
                                <StackPanel Grid.Row="6" Grid.Column="4" Margin="0,0,0,10">
                                    <TextBlock Text="NAICS Code" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding UserDashboard.ProfileNaicsCode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Height="36" Padding="10,6" FontSize="13" />
                                </StackPanel>

                                <!-- Row 7: NAICS Description & Notes -->
                                <StackPanel Grid.Row="7" Grid.Column="0" Margin="0,0,0,10">
                                    <TextBlock Text="NAICS Description" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding UserDashboard.ProfileNaicsDescription, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Height="36" Padding="10,6" FontSize="13" />
                                </StackPanel>
                                <StackPanel Grid.Row="7" Grid.Column="2" Grid.ColumnSpan="3" Margin="0,0,0,10">
                                    <TextBlock Text="Notes" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding UserDashboard.ProfileNotes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Height="36" Padding="10,6" FontSize="13" />
                                </StackPanel>
                            </Grid>

                            <!-- Call & Assignment History List -->
                            <Rectangle Height="1" Fill="#E2E8F0" Margin="0,4,0,14" />
                            <TextBlock Text="CALL &amp; ASSIGNMENT HISTORY" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,10" />

                            <TextBlock Text="Loading history…" FontSize="12" Foreground="#64748B"
                                       Visibility="{Binding UserDashboard.IsLoadingProfileHistory, Converter={StaticResource BooleanToVisibilityConverter}}"
                                       Margin="0,0,0,8" />

                            <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" ClipToBounds="True"
                                    Visibility="{Binding UserDashboard.HasProfileCallHistory, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <!-- Table Header -->
                                    <Border Background="#0F172A" Padding="12,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="135" />
                                                <ColumnDefinition Width="145" />
                                                <ColumnDefinition Width="135" />
                                                <ColumnDefinition Width="75" />
                                                <ColumnDefinition Width="135" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="AGENT" FontSize="10.5" FontWeight="Bold" Foreground="White" />
                                            <TextBlock Grid.Column="1" Text="CLIENT" FontSize="10.5" FontWeight="Bold" Foreground="White" />
                                            <TextBlock Grid.Column="2" Text="DATE" FontSize="10.5" FontWeight="Bold" Foreground="White" />
                                            <TextBlock Grid.Column="3" Text="# OF CALL" FontSize="10.5" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" />
                                            <TextBlock Grid.Column="4" Text="DISPOSITION" FontSize="10.5" FontWeight="Bold" Foreground="White" Margin="6,0,0,0" />
                                            <TextBlock Grid.Column="5" Text="NOTES" FontSize="10.5" FontWeight="Bold" Foreground="White" Margin="6,0,0,0" />
                                        </Grid>
                                    </Border>

                                    <!-- Single-Line History Rows -->
                                    <ItemsControl ItemsSource="{Binding UserDashboard.ProfileCallHistory}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="12,9">
                                                    <Grid VerticalAlignment="Center">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="135" />
                                                            <ColumnDefinition Width="145" />
                                                            <ColumnDefinition Width="135" />
                                                            <ColumnDefinition Width="75" />
                                                            <ColumnDefinition Width="135" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Grid.Column="0" FontSize="12" FontWeight="SemiBold" Foreground="#065F46"
                                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0"
                                                                   ToolTip="{Binding AgentName}">
                                                            <Run Text="👤 " />
                                                            <Run Text="{Binding AgentName, Mode=OneWay}" />
                                                        </TextBlock>

                                                        <TextBlock Grid.Column="1" FontSize="12" FontWeight="Medium" Foreground="#3730A3"
                                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0"
                                                                   ToolTip="{Binding ClientNames}">
                                                            <Run Text="🏢 " />
                                                            <Run Text="{Binding ClientNames, Mode=OneWay}" />
                                                        </TextBlock>

                                                        <TextBlock Grid.Column="2" Text="{Binding FormattedCalledAt}" FontSize="11.5" Foreground="#64748B"
                                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0" />

                                                        <Border Grid.Column="3" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="5"
                                                                Padding="8,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding CallNumber}" FontSize="11.5" FontWeight="Bold" Foreground="#0F172A" />
                                                        </Border>

                                                        <Grid Grid.Column="4" Margin="6,0,6,0" VerticalAlignment="Center">
                                                            <Border Background="{Binding DispositionInfo.BackgroundHex}"
                                                                    BorderBrush="{Binding DispositionInfo.BorderHex}"
                                                                    BorderThickness="1" CornerRadius="6" Padding="7,2" HorizontalAlignment="Left"
                                                                    Visibility="{Binding HasDisposition, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                <TextBlock Text="{Binding CallDisposition}" FontSize="11" FontWeight="SemiBold"
                                                                           Foreground="{Binding DispositionInfo.ForegroundHex}" TextTrimming="CharacterEllipsis" />
                                                            </Border>
                                                            <TextBlock Text="—" FontSize="12" Foreground="#94A3B8">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding HasDisposition}" Value="False">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Grid>

                                                        <TextBlock Grid.Column="5" Text="{Binding DisplayNotes}" FontSize="12" Foreground="#334155"
                                                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                                                   VerticalAlignment="Center" Margin="6,0,0,0"
                                                                   ToolTip="{Binding Notes}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding UserDashboard.HasProfileCallHistory}" Value="False" />
                                                    <Condition Binding="{Binding UserDashboard.IsLoadingProfileHistory}" Value="False" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="No call history recorded for this lead yet. Click the green Call button to dial and log a call."
                                           FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center" />
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Modal Footer -->
                    <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" CornerRadius="0,0,14,14" Padding="24,14">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Close" Command="{Binding UserDashboard.CloseLeadProfileCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" Padding="16,8" Margin="0,0,10,0" />
                            <Button Content="✓ Update Lead" Command="{Binding UserDashboard.UpdateLeadProfileCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Background="#4F46E5" BorderBrush="#4338CA"
                                    Padding="18,8"
                                    Visibility="{Binding UserDashboard.HasProfileChanges, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ===== ASYNC OPERATION LOADING MODAL WITH CANCEL ===== -->
        <Border Grid.RowSpan="2"
                Background="#770F172A"
                Panel.ZIndex="100"
                Visibility="{Binding UserDashboard.IsLoadingModalOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="White" CornerRadius="14" Padding="32,28" Width="420"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="#0F172A" BlurRadius="36" ShadowDepth="6" Direction="270" Opacity="0.18"/>
                </Border.Effect>
                <StackPanel HorizontalAlignment="Center">
                    <!-- Progress Bar / Spinner -->
                    <ProgressBar IsIndeterminate="True" Height="4" Width="320" Margin="0,0,0,20"
                                 Foreground="#2563EB" Background="#E2E8F0" BorderThickness="0"/>

                    <TextBlock Text="{Binding UserDashboard.LoadingModalTitle}" FontSize="17" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>

                    <TextBlock Text="{Binding UserDashboard.LoadingModalMessage}" FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" TextAlignment="Center"
                               TextWrapping="Wrap" Margin="0,0,0,6"/>

                    <TextBlock Text="{Binding UserDashboard.LoadingModalDetail}" FontSize="11.5" Foreground="#94A3B8"
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,22"/>

                    <!-- Cancel Button -->
                    <Button Content="✕ Cancel Operation"
                            Command="{Binding UserDashboard.CancelLoadingModalCommand}"
                            Style="{StaticResource DangerButtonStyle}"
                            Padding="22,7" FontSize="12" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Border>

    </Grid>
</UserControl>
