<UserControl x:Class="LeadManagement.Desktop.Views.ManageClientsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:LeadManagement.Desktop.ViewModels"
             xmlns:models="clr-namespace:LeadManagement.Desktop.Models"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1250"
             FontFamily="{StaticResource AppFontFamily}"
             Loaded="ManageClientsView_Loaded">

    <UserControl.Resources>
        <!-- Danger button style (inline, matches red delete pattern across the app) -->
        <Style x:Key="DangerButtonStyle" TargetType="Button">
            <Setter Property="FontFamily"   Value="{StaticResource AppFontFamily}"/>
            <Setter Property="FontSize"     Value="12"/>
            <Setter Property="FontWeight"   Value="SemiBold"/>
            <Setter Property="Foreground"   Value="#DC2626"/>
            <Setter Property="Background"   Value="#FEF2F2"/>
            <Setter Property="BorderBrush"  Value="#FECACA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"      Value="10,5"/>
            <Setter Property="Cursor"       Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FEE2E2"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#FCA5A5"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FECACA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Centered DataGrid cell style – fixes vertical alignment for all cell types -->
        <Style x:Key="CenteredCellStyle" TargetType="DataGridCell">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="6,0"
                                SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#EFF6FF"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ghost preview button -->
        <Style x:Key="PreviewButtonStyle" TargetType="Button">
            <Setter Property="FontFamily"   Value="{StaticResource AppFontFamily}"/>
            <Setter Property="FontSize"     Value="12"/>
            <Setter Property="FontWeight"   Value="SemiBold"/>
            <Setter Property="Foreground"   Value="#2563EB"/>
            <Setter Property="Background"   Value="#EFF6FF"/>
            <Setter Property="BorderBrush"  Value="#BFDBFE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"      Value="10,5"/>
            <Setter Property="Cursor"       Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#DBEAFE"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#93C5FD"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#BFDBFE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- ===== LOADING OVERLAY ===== -->
        <Border Background="#A0F8FAFC"
                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                Panel.ZIndex="99">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="⏳" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                <TextBlock Text="Loading clients…" FontSize="14" Foreground="#64748B" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ===== ADD CLIENT MODAL OVERLAY ===== -->
        <Border Background="#770F172A"
                Panel.ZIndex="50"
                Visibility="{Binding IsAddClientModalOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="White" CornerRadius="12" Padding="32"
                    Width="420" VerticalAlignment="Center" HorizontalAlignment="Center"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="#0F172A" BlurRadius="30" ShadowDepth="4" Direction="270" Opacity="0.12"/>
                </Border.Effect>
                <StackPanel>
                    <!-- Modal Header -->
                    <Grid Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="➕ Add New Client" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="Enter the client's first and last name." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                                Command="{Binding CloseAddClientModalCommand}"
                                Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="6">
                            <TextBlock Text="✕" FontSize="14" Foreground="#94A3B8"/>
                        </Button>
                    </Grid>

                    <!-- Error Banner -->
                    <Border Background="#FEF2F2" CornerRadius="6" Padding="12,8" Margin="0,0,0,16"
                            BorderBrush="#FECACA" BorderThickness="1"
                            Visibility="{Binding HasFormError, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{Binding FormErrorMessage}" Foreground="#DC2626" FontSize="12" TextWrapping="Wrap"/>
                    </Border>

                    <!-- First Name -->
                    <TextBlock Text="First Name" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding NewFirstName, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBoxStyle}"
                             Margin="0,0,0,16"
                             Tag="e.g. Michael"/>

                    <!-- Last Name -->
                    <TextBlock Text="Last Name" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding NewLastName, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBoxStyle}"
                             Margin="0,0,0,24"
                             Tag="e.g. Scott"/>

                    <!-- Action Buttons -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Cancel"
                                Command="{Binding CloseAddClientModalCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"/>
                        <Button Grid.Column="2"
                                Command="{Binding CreateClientCommand}"
                                Style="{StaticResource PrimaryButtonStyle}">
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="✓ Save Client"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSaving}" Value="True">
                                                <Setter Property="Text" Value="Saving…"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- ===== FILE PREVIEW MODAL OVERLAY ===== -->
        <Border Background="#770F172A"
                Panel.ZIndex="40"
                Visibility="{Binding IsPreviewOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="White" CornerRadius="12" Margin="32"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                <Border.Effect>
                    <DropShadowEffect Color="#0F172A" BlurRadius="40" ShadowDepth="6" Direction="270" Opacity="0.14"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>  <!-- Header -->
                        <RowDefinition Height="Auto"/>  <!-- Search bar -->
                        <RowDefinition Height="*"/>     <!-- Data table -->
                        <RowDefinition Height="Auto"/>  <!-- Footer -->
                    </Grid.RowDefinitions>

                    <!-- Preview Header -->
                    <Border Grid.Row="0" Background="#F8FAFC" CornerRadius="12,12,0,0"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                            Padding="24,18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="📄" FontSize="22" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding PreviewTitle}" FontSize="16" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding PreviewSubtitle}" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="8" Padding="8,3" Margin="0,0,12,0">
                                    <TextBlock Text="⚡ Real-time Sync Active" FontSize="11" Foreground="#047857" FontWeight="SemiBold"/>
                                </Border>
                                <Button Command="{Binding ClosePreviewCommand}"
                                        Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="8">
                                    <TextBlock Text="✕" FontSize="14" Foreground="#94A3B8"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Search Bar -->
                    <Border Grid.Row="1" Padding="20,12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                        <Grid>
                            <TextBox Text="{Binding PreviewSearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernTextBoxStyle}"
                                     Padding="36,9,12,9"/>
                            <TextBlock Text="🔍" Foreground="#94A3B8" FontSize="13"
                                       VerticalAlignment="Center" HorizontalAlignment="Left" Margin="12,0,0,0"
                                       IsHitTestVisible="False"/>
                            <TextBlock Text="Search business name, contact, phone, disposition, agent, notes…"
                                       Foreground="#94A3B8" FontSize="13"
                                       VerticalAlignment="Center" Margin="38,0,0,0"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PreviewSearchText}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding PreviewSearchText}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <!-- Loading Preview Spinner -->
                    <Border Grid.Row="2"
                            Visibility="{Binding IsLoadingPreview, Converter={StaticResource BooleanToVisibilityConverter}}"
                            VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="⏳" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock Text="Loading leads data…" FontSize="13" Foreground="#64748B" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Preview Data Grid (With Editable Columns First) -->
                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding FilteredPreviewLeads}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Single"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#F1F5F9"
                              Background="White"
                              RowBackground="White"
                              AlternatingRowBackground="#F8FAFC"
                              BorderThickness="0"
                              ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeaderStyle}"
                              RowStyle="{StaticResource ModernDataGridRowStyle}"
                              CellStyle="{StaticResource CenteredCellStyle}"
                              AlternationCount="2"
                              RowHeight="40"
                              EnableRowVirtualization="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Standard"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto"
                              Visibility="{Binding IsLoadingPreview, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <DataGrid.Columns>
                            <!-- 1. DATE with Calendar Picker -->
                            <DataGridTemplateColumn Header="DATE" Width="135" CanUserSort="True" SortMemberPath="CallDate">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <DatePicker SelectedDate="{Binding SelectedDate, Mode=OneWay}"
                                                    Height="28" VerticalAlignment="Center" VerticalContentAlignment="Center"
                                                    BorderBrush="#CBD5E1" Background="White" Padding="4,1"
                                                    ToolTip="Pick a date for this call"
                                                    SelectedDateChanged="DatePicker_SelectedDateChanged"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- 2. CALL DISPOSITION Dropdown with Color Coding -->
                            <DataGridTemplateColumn Header="CALL DISPOSITION" Width="190" CanUserSort="True" SortMemberPath="CallDisposition">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding Source={x:Static models:CallDispositionHelper.Dispositions}}"
                                                  SelectedValue="{Binding CallDisposition, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  SelectedValuePath="Name"
                                                  Height="30" VerticalAlignment="Center"
                                                  BorderBrush="#CBD5E1" Background="White">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{Binding BackgroundHex}"
                                                            BorderBrush="{Binding BorderHex}"
                                                            BorderThickness="1" CornerRadius="8"
                                                            Padding="8,3" Margin="0,1" HorizontalAlignment="Stretch">
                                                        <TextBlock Text="{Binding Name}"
                                                                   Foreground="{Binding ForegroundHex}"
                                                                   FontWeight="SemiBold" FontSize="11.5"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- 3. AGENT Assigned Dropdown (Specific to this client) -->
                            <DataGridTemplateColumn Header="AGENT" Width="150" CanUserSort="True" SortMemberPath="AssignedAgent">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding AvailableAgentOptions}"
                                                  SelectedItem="{Binding AssignedAgent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Height="30" VerticalAlignment="Center"
                                                  BorderBrush="#CBD5E1" Background="White">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="👤 " FontSize="11" Foreground="#64748B"/>
                                                        <TextBlock Text="{Binding}" FontSize="12" Foreground="#0F172A" FontWeight="Medium"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- 4. NOTES (Editable) -->
                            <DataGridTemplateColumn Header="NOTES" Width="220" CanUserSort="True" SortMemberPath="Notes">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Notes, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                 Height="28" VerticalContentAlignment="Center"
                                                 Padding="6,2" BorderBrush="#CBD5E1" BorderThickness="1"
                                                 Background="White" FontSize="12"
                                                 ToolTip="{Binding Notes}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- 5. OF CAL (# of Calls - Editable) -->
                            <DataGridTemplateColumn Header="OF CAL" Width="85" CanUserSort="True" SortMemberPath="CallCount">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding CallCount, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                 Height="28" Width="55" TextAlignment="Center"
                                                 VerticalContentAlignment="Center"
                                                 BorderBrush="#CBD5E1" BorderThickness="1"
                                                 Background="White" FontSize="12" FontWeight="SemiBold"
                                                 ToolTip="Number of calls made to this lead"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- 6. CELL NUMBER -->
                            <DataGridTextColumn Header="CELL NUMBER" Binding="{Binding FormattedPhone}" Width="125" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- 7. BUSINESS NAME -->
                            <DataGridTextColumn Header="BUSINESS NAME" Binding="{Binding BusinessName}" Width="210" IsReadOnly="True" FontWeight="SemiBold">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- 8. TITLE -->
                            <DataGridTextColumn Header="TITLE" Binding="{Binding Title}" Width="120" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- 9. CONTACT NAME -->
                            <DataGridTextColumn Header="CONTACT NAME" Binding="{Binding ContactName}" Width="150" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- 10. EMAIL -->
                            <DataGridTextColumn Header="EMAIL" Binding="{Binding Email}" Width="170" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- 11. ADDRESS -->
                            <DataGridTextColumn Header="ADDRESS" Binding="{Binding Address}" Width="190" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- 12. CITY -->
                            <DataGridTextColumn Header="CITY" Binding="{Binding City}" Width="110" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- 13. COUNTY -->
                            <DataGridTextColumn Header="COUNTY" Binding="{Binding County}" Width="110" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- 14. STATE -->
                            <DataGridTextColumn Header="STATE" Binding="{Binding State}" Width="65" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- 15. ZIP CODE -->
                            <DataGridTextColumn Header="ZIP CODE" Binding="{Binding ZipCode}" Width="85" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- 16. FAX -->
                            <DataGridTextColumn Header="FAX" Binding="{Binding Fax}" Width="110" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- 17. ANNUAL SALES -->
                            <DataGridTextColumn Header="ANNUAL SALES" Binding="{Binding AnnualSales}" Width="140" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- 18. NUMBER OF EMP -->
                            <DataGridTextColumn Header="NUMBER OF EMP" Binding="{Binding NumberOfEmployees}" Width="115" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- 19. WEBSITE -->
                            <DataGridTextColumn Header="WEBSITE" Binding="{Binding Website}" Width="160" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- 20. SIC CODE -->
                            <DataGridTextColumn Header="SIC CODE" Binding="{Binding SicCode}" Width="95" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- 21. SIC DESCRIPTION -->
                            <DataGridTextColumn Header="SIC DESCRIPTION" Binding="{Binding SicDescription}" Width="180" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- 22. NAICS CODE -->
                            <DataGridTextColumn Header="NAICS CODE" Binding="{Binding NaicsCode}" Width="95" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- 23. NAICS DESCRIPTION -->
                            <DataGridTextColumn Header="NAICS DESCRIPTION" Binding="{Binding NaicsDescription}" Width="180" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- 24. STATUS -->
                            <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="110" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Footer -->
                    <Border Grid.Row="3" Background="#F8FAFC" CornerRadius="0,0,12,12"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                            Padding="20,12">
                        <Grid>
                            <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}">
                                <Run Text="Showing "/>
                                <Run Text="{Binding FilteredPreviewLeads.Count, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <Run Text=" of "/>
                                <Run Text="{Binding PreviewSubtitle, Mode=OneWay}"/>
                            </TextBlock>
                            <Button HorizontalAlignment="Right"
                                    Command="{Binding ClosePreviewCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Content="Close" Padding="16,7"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Border>

        <!-- ===== MAIN CONTENT ===== -->
        <Grid Margin="24,20,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- Page Header -->
                <RowDefinition Height="Auto"/>  <!-- Status Banner -->
                <RowDefinition Height="*"/>     <!-- Client List -->
            </Grid.RowDefinitions>

            <!-- PAGE HEADER -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Manage Clients"
                                   FontSize="24" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                        <!-- Client count badge -->
                        <Border Background="#E0F2FE" BorderBrush="#BAE6FD" BorderThickness="1"
                                CornerRadius="10" Padding="10,3" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock FontSize="11.5" Foreground="#0284C7" FontWeight="SemiBold">
                                <Run Text="{Binding Clients.Count, Mode=OneWay}"/>
                                <Run Text=" clients"/>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Add clients, upload lead files, manage call compositions, and assign agents."
                               FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="⟳ Refresh"
                            Command="{Binding RefreshCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Padding="14,8" Margin="0,0,10,0"
                            ToolTip="Reload clients from server"/>
                    <Button Content="➕ Add Client"
                            Command="{Binding OpenAddClientModalCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Padding="16,8"
                            ToolTip="Add a new client"/>
                </StackPanel>
            </Grid>

            <!-- STATUS BANNER -->
            <Border Grid.Row="1"
                    CornerRadius="8" BorderThickness="1" Padding="14,10" Margin="0,0,0,16"
                    Visibility="{Binding IsBannerVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background"   Value="#ECFDF5"/>
                        <Setter Property="BorderBrush"  Value="#A7F3D0"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsBannerError}" Value="True">
                                <Setter Property="Background"  Value="#FEF2F2"/>
                                <Setter Property="BorderBrush" Value="#FECACA"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <TextBlock Text="{Binding StatusBannerMessage}" FontSize="13" FontWeight="SemiBold"
                               TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,32,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#065F46"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBannerError}" Value="True">
                                        <Setter Property="Foreground" Value="#DC2626"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                            Command="{Binding DismissBannerCommand}"
                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                            Content="✕" FontSize="12" Foreground="#94A3B8" Padding="4,2"/>
                </Grid>
            </Border>

            <!-- EMPTY STATE -->
            <Border Grid.Row="2"
                    Visibility="{Binding Clients.Count, Converter={StaticResource ZeroToVisibilityConverter}, FallbackValue=Collapsed}"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="📂" FontSize="52" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBlock Text="No Clients Yet" FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Click '➕ Add Client' above to get started."
                               FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- CLIENT LIST -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Clients}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- CLIENT CARD -->
                            <Border Background="White" CornerRadius="10" Margin="0,0,0,14"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                <Border.Effect>
                                    <DropShadowEffect Color="#0F172A" BlurRadius="8" ShadowDepth="1" Direction="270" Opacity="0.05"/>
                                </Border.Effect>
                                <StackPanel>
                                    <!-- CLIENT CARD HEADER ROW -->
                                    <Grid Margin="16,14,16,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>  <!-- Expand icon -->
                                            <ColumnDefinition Width="Auto"/>  <!-- Folder icon -->
                                            <ColumnDefinition Width="*"/>     <!-- Name + badges -->
                                            <ColumnDefinition Width="Auto"/>  <!-- Actions -->
                                        </Grid.ColumnDefinitions>

                                        <!-- Expand / Collapse arrow -->
                                        <Button Grid.Column="0"
                                                Command="{Binding DataContext.ToggleExpandCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                Width="28" Height="28" Margin="0,0,4,0" VerticalAlignment="Center">
                                            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="11">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text"       Value="▶"/>
                                                        <Setter Property="Foreground" Value="#94A3B8"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                <Setter Property="Text"       Value="▼"/>
                                                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Button>

                                        <!-- Folder icon -->
                                        <TextBlock Grid.Column="1" Text="📁" FontSize="20"
                                                   VerticalAlignment="Center" Margin="0,0,10,0"/>

                                        <!-- Client name + badges -->
                                        <WrapPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal">
                                            <TextBlock Text="{Binding FullName}" FontSize="15" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       VerticalAlignment="Center"/>

                                            <!-- File count badge -->
                                            <Border Background="#F1F5F9" CornerRadius="8" Padding="8,2"
                                                    Margin="10,0,0,0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="📄 " FontSize="11" Foreground="#64748B"/>
                                                    <TextBlock FontSize="11" Foreground="#64748B">
                                                        <Run Text="{Binding FileCount, Mode=OneWay}"/>
                                                        <Run Text=" files"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>

                                            <!-- Total leads badge -->
                                            <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1"
                                                    CornerRadius="8" Padding="8,2" Margin="6,0,0,0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="👥 " FontSize="11" Foreground="#2563EB"/>
                                                    <TextBlock FontSize="11" Foreground="#2563EB">
                                                        <Run Text="{Binding TotalLeads, Mode=OneWay, StringFormat={}{0:N0}}"/>
                                                        <Run Text=" leads"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>

                                            <!-- Assigned agents chips -->
                                            <ItemsControl ItemsSource="{Binding AssignedAgents}" Margin="6,0,0,0" VerticalAlignment="Center">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1"
                                                                CornerRadius="8" Padding="7,2" Margin="0,0,4,0">
                                                            <TextBlock FontSize="11" Foreground="#065F46">
                                                                <Run Text="👤 "/>
                                                                <Run Text="{Binding FullName, Mode=OneWay}"/>
                                                            </TextBlock>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </WrapPanel>

                                        <!-- ACTION BUTTONS -->
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- Upload file button -->
                                            <Button Command="{Binding DataContext.BrowseFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Padding="10,6" Margin="0,0,8,0" FontSize="12"
                                                    ToolTip="Browse and upload a leads file (.csv/.xlsx/.xls)">
                                                <TextBlock Text="📤 Upload File"/>
                                            </Button>

                                            <!-- Assign to Agent button -->
                                            <Button Command="{Binding DataContext.ToggleAssignDropdownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Padding="10,6" Margin="0,0,8,0" FontSize="12"
                                                    ToolTip="Assign agents to this client">
                                                <TextBlock Text="👤 Assign to Agent ▾"/>
                                            </Button>

                                            <!-- Delete client -->
                                            <Button Command="{Binding DataContext.DeleteClientCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource DangerButtonStyle}"
                                                    ToolTip="Delete this client and all associated data">
                                                <TextBlock Text="🗑 Delete"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <!-- AGENT ASSIGNMENT DROPDOWN (inline popup) -->
                                    <Border Margin="16,0,16,12"
                                            Background="#F8FAFC" CornerRadius="8"
                                            BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="1"
                                            Padding="16,12"
                                            Visibility="{Binding IsAssignDropdownOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <StackPanel>
                                            <TextBlock Text="Select Agents to Assign to this Client"
                                                       FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                                            <ItemsControl ItemsSource="{Binding AgentSelectionItems}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <CheckBox IsChecked="{Binding IsSelected}"
                                                                  Foreground="{StaticResource TextPrimaryBrush}"
                                                                  Margin="0,4,0,0" Cursor="Hand">
                                                            <TextBlock>
                                                                <Run Text="👤 "/>
                                                                <Run Text="{Binding Agent.FullName, Mode=OneWay}"/>
                                                                <Run Text=" (" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                                <Run Text="{Binding Agent.Username, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                                <Run Text=")" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                            </TextBlock>
                                                        </CheckBox>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Empty agents placeholder -->
                                            <TextBlock Text="No agent accounts found. Add users with 'User' role first."
                                                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"
                                                       Visibility="{Binding DataContext.HasNoAgents, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"/>

                                            <!-- Save button -->
                                            <Button Content="✓ Save Assignment"
                                                    Command="{Binding DataContext.SaveAgentAssignmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource PrimaryButtonStyle}"
                                                    Margin="0,12,0,0" Padding="14,7" HorizontalAlignment="Left"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- EXPANDED CLIENT LEADS AREA -->
                                    <!-- EXPANDED CLIENT UPLOADED FILES AREA -->
                                    <Border Margin="16,0,16,16"
                                            Visibility="{Binding IsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <StackPanel>
                                            <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="0,0,0,14"/>

                                            <TextBlock Text="Uploaded Files" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10"/>

                                            <!-- UPLOADED FILES LIST -->
                                            <ItemsControl ItemsSource="{Binding Files}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                                CornerRadius="8" Padding="14,10" Margin="0,0,0,8">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/> <!-- File Icon -->
                                                                    <ColumnDefinition Width="*"/>    <!-- Name, Size, Date -->
                                                                    <ColumnDefinition Width="Auto"/> <!-- Leads Badge -->
                                                                    <ColumnDefinition Width="Auto"/> <!-- Preview Button -->
                                                                    <ColumnDefinition Width="Auto"/> <!-- Delete Button -->
                                                                </Grid.ColumnDefinitions>

                                                                <TextBlock Grid.Column="0" Text="📄" FontSize="20" VerticalAlignment="Center" Margin="0,0,12,0"/>

                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding FileName}" FontSize="13" FontWeight="SemiBold"
                                                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                                        <TextBlock Text="{Binding FileSize}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                                        <TextBlock Text=" · " FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                                        <TextBlock Text="{Binding FormattedDate}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                                    </StackPanel>
                                                                </StackPanel>

                                                                <!-- Leads badge -->
                                                                <Border Grid.Column="2" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1"
                                                                        CornerRadius="6" Padding="8,4" VerticalAlignment="Center" Margin="0,0,12,0">
                                                                    <TextBlock FontSize="11.5" Foreground="#2563EB" FontWeight="SemiBold">
                                                                        <Run Text="{Binding TotalLeads, Mode=OneWay, StringFormat={}{0:N0}}"/>
                                                                        <Run Text=" leads"/>
                                                                    </TextBlock>
                                                                </Border>

                                                                <!-- Preview button -->
                                                                <Button Grid.Column="3"
                                                                        Command="{Binding DataContext.PreviewFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        CommandParameter="{Binding}"
                                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                                        Padding="12,6" Margin="0,0,8,0" FontSize="11.5"
                                                                        ToolTip="Preview all lead records and edit dispositions, notes, agents">
                                                                    <TextBlock Text="👁 Preview"/>
                                                                </Button>

                                                                <!-- Delete button -->
                                                                <Button Grid.Column="4"
                                                                        Command="{Binding DataContext.DeleteFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        CommandParameter="{Binding}"
                                                                        Style="{StaticResource DangerButtonStyle}"
                                                                        Padding="10,6" FontSize="11.5"
                                                                        ToolTip="Delete this file and all its leads">
                                                                    <TextBlock Text="🗑 Delete"/>
                                                                </Button>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Empty files placeholder -->
                                            <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                    CornerRadius="8" Padding="20"
                                                    Visibility="{Binding Files.Count, Converter={StaticResource ZeroToVisibilityConverter}, FallbackValue=Collapsed}">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="📄" FontSize="28" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                                    <TextBlock Text="No files uploaded yet for this client." FontSize="13" FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="Click '📤 Upload File' above to import leads." FontSize="12"
                                                               Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>

</UserControl>
