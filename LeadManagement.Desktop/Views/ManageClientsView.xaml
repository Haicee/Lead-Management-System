<UserControl x:Class="LeadManagement.Desktop.Views.ManageClientsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:LeadManagement.Desktop.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1000"
             Background="{StaticResource WindowBgBrush}"
             Loaded="ManageClientsView_Loaded">

    <UserControl.Resources>
        <!-- Badge style for counts -->
        <Style x:Key="BadgeStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Background" Value="#1E293B"/>
        </Style>
        <!-- Small chip for assigned agent names -->
        <Style x:Key="AgentChipStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="7,2"/>
            <Setter Property="Background" Value="#1E3A8A"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
        </Style>
        <!-- File row background -->
        <Style x:Key="FileRowStyle" TargetType="Border">
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- ===== LOADING OVERLAY ===== -->
        <Border Background="#CC0F172A"
                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                Panel.ZIndex="99">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="⏳" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                <TextBlock Text="Loading clients…" FontSize="14" Foreground="#94A3B8" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ===== ADD CLIENT MODAL OVERLAY ===== -->
        <Border Background="#CC0F172A"
                Panel.ZIndex="50"
                Visibility="{Binding IsAddClientModalOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="#1E293B" CornerRadius="12" Padding="32"
                    Width="420" VerticalAlignment="Center" HorizontalAlignment="Center"
                    BorderBrush="#334155" BorderThickness="1">
                <StackPanel>
                    <!-- Modal Header -->
                    <Grid Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="➕ Add New Client" FontSize="18" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="Enter the client's first and last name." FontSize="12" Foreground="#64748B" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                                Command="{Binding CloseAddClientModalCommand}"
                                Background="Transparent" BorderThickness="0" Cursor="Hand">
                            <TextBlock Text="✕" FontSize="16" Foreground="#64748B"/>
                        </Button>
                    </Grid>

                    <!-- Error Banner -->
                    <Border Background="#450A0A" CornerRadius="6" Padding="12,8" Margin="0,0,0,16"
                            Visibility="{Binding HasFormError, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{Binding FormErrorMessage}" Foreground="#FCA5A5" FontSize="12" TextWrapping="Wrap"/>
                    </Border>

                    <!-- First Name -->
                    <TextBlock Text="First Name" FontSize="12" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding NewFirstName, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBoxStyle}"
                             Margin="0,0,0,16"
                             Tag="e.g. Michael"/>

                    <!-- Last Name -->
                    <TextBlock Text="Last Name" FontSize="12" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding NewLastName, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBoxStyle}"
                             Margin="0,0,0,24"
                             Tag="e.g. Scott"/>

                    <!-- Action Buttons -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Cancel"
                                Command="{Binding CloseAddClientModalCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Foreground="#CBD5E1" BorderBrush="#475569"/>
                        <Button Grid.Column="2"
                                Command="{Binding CreateClientCommand}"
                                Style="{StaticResource PrimaryButtonStyle}">
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="✓ Save Client"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSaving}" Value="True">
                                                <Setter Property="Text" Value="Saving…"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- ===== MAIN CONTENT ===== -->
        <Grid Margin="28,24,28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- Page Header -->
                <RowDefinition Height="Auto"/>  <!-- Status Banner -->
                <RowDefinition Height="*"/>     <!-- Client List -->
            </Grid.RowDefinitions>

            <!-- PAGE HEADER -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="📂 Manage Clients" FontSize="22" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Add clients, upload lead files, and assign agents." FontSize="13" Foreground="#64748B" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="🔄 Refresh"
                            Command="{Binding RefreshCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Foreground="#CBD5E1" BorderBrush="#475569"
                            Padding="14,8" Margin="0,0,10,0"/>
                    <Button Content="➕ Add Client"
                            Command="{Binding OpenAddClientModalCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Padding="16,8"/>
                </StackPanel>
            </Grid>

            <!-- STATUS BANNER -->
            <Border Grid.Row="1"
                    CornerRadius="8" Padding="14,10" Margin="0,0,0,16"
                    Visibility="{Binding IsBannerVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#052E16"/>
                        <Setter Property="BorderBrush" Value="#16A34A"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsBannerError}" Value="True">
                                <Setter Property="Background" Value="#450A0A"/>
                                <Setter Property="BorderBrush" Value="#DC2626"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <TextBlock Text="{Binding StatusBannerMessage}" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#86EFAC"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBannerError}" Value="True">
                                        <Setter Property="Foreground" Value="#FCA5A5"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                            Command="{Binding DismissBannerCommand}"
                            Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="6,0">
                        <TextBlock Text="✕" FontSize="12" Foreground="#64748B"/>
                    </Button>
                </Grid>
            </Border>

            <!-- EMPTY STATE -->
            <Border Grid.Row="2"
                    Visibility="{Binding Clients.Count, Converter={StaticResource ZeroToVisibilityConverter}, FallbackValue=Collapsed}"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="📂" FontSize="52" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBlock Text="No Clients Yet" FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                    <TextBlock Text="Click '➕ Add Client' above to get started." FontSize="13" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- CLIENT LIST -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Clients}" x:Name="ClientsItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- CLIENT CARD -->
                            <Border Background="#1E293B" CornerRadius="10" Margin="0,0,0,12"
                                    BorderBrush="#334155" BorderThickness="1"
                                    AllowDrop="True" Drop="ClientCard_Drop" Tag="{Binding}">
                                <StackPanel>
                                    <!-- CLIENT CARD HEADER ROW -->
                                    <Grid Margin="16,14,16,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>  <!-- Expand icon -->
                                            <ColumnDefinition Width="Auto"/>  <!-- Folder icon -->
                                            <ColumnDefinition Width="*"/>     <!-- Name + badges -->
                                            <ColumnDefinition Width="Auto"/>  <!-- Actions -->
                                        </Grid.ColumnDefinitions>

                                        <!-- Expand / Collapse arrow -->
                                        <Button Grid.Column="0"
                                                Command="{Binding DataContext.ToggleExpandCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                Width="28" Height="28" Margin="0,0,4,0" VerticalAlignment="Center">
                                            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="13">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="▶"/>
                                                        <Setter Property="Foreground" Value="#64748B"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                <Setter Property="Text" Value="▼"/>
                                                                <Setter Property="Foreground" Value="#2563EB"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Button>

                                        <!-- Folder icon -->
                                        <TextBlock Grid.Column="1" Text="📁" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0"/>

                                        <!-- Client name + badges -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" FlowDirection="LeftToRight">
                                            <TextBlock Text="{Binding FullName}" FontSize="15" FontWeight="SemiBold"
                                                       Foreground="White" VerticalAlignment="Center"/>

                                            <!-- File count badge -->
                                            <Border Style="{StaticResource BadgeStyle}" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="📄 " FontSize="11" Foreground="#94A3B8"/>
                                                    <TextBlock FontSize="11" Foreground="#94A3B8">
                                                        <Run Text="{Binding FileCount, Mode=OneWay}"/>
                                                        <Run Text=" files"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>

                                            <!-- Total leads badge -->
                                            <Border Style="{StaticResource BadgeStyle}" Margin="6,0,0,0" VerticalAlignment="Center"
                                                    Background="#0C2442" BorderBrush="#1D4ED8" BorderThickness="1">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="👥 " FontSize="11" Foreground="#93C5FD"/>
                                                    <TextBlock FontSize="11" Foreground="#93C5FD">
                                                        <Run Text="{Binding TotalLeads, Mode=OneWay, StringFormat={}{0:N0}}"/>
                                                        <Run Text=" leads"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>

                                            <!-- Assigned agents chips -->
                                            <ItemsControl ItemsSource="{Binding AssignedAgents}" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Style="{StaticResource AgentChipStyle}">
                                                            <TextBlock FontSize="11" Foreground="#93C5FD">
                                                                <Run Text="👤 "/>
                                                                <Run Text="{Binding FullName, Mode=OneWay}"/>
                                                            </TextBlock>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <!-- ACTION BUTTONS -->
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- Upload file button -->
                                            <Button Command="{Binding DataContext.BrowseFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Foreground="#CBD5E1" BorderBrush="#475569"
                                                    Padding="10,6" Margin="0,0,8,0" FontSize="12"
                                                    ToolTip="Browse and upload a leads file (.csv/.xlsx/.xls)">
                                                <TextBlock Text="📤 Upload File"/>
                                            </Button>

                                            <!-- Assign to Agent button (dropdown trigger) -->
                                            <Button Command="{Binding DataContext.ToggleAssignDropdownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Foreground="#CBD5E1" BorderBrush="#475569"
                                                    Padding="10,6" Margin="0,0,8,0" FontSize="12"
                                                    ToolTip="Assign agents to this client">
                                                <TextBlock Text="👤 Assign to Agent ▾"/>
                                            </Button>

                                            <!-- Delete client -->
                                            <Button Command="{Binding DataContext.DeleteClientCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Background="#450A0A" BorderBrush="#7F1D1D" BorderThickness="1"
                                                    Foreground="#FCA5A5" Padding="8,6" FontSize="12"
                                                    Cursor="Hand" ToolTip="Delete this client and all associated data">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#7F1D1D"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                                <TextBlock Text="🗑 Delete"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <!-- AGENT ASSIGNMENT DROPDOWN (inline popup) -->
                                    <Border Margin="16,0,16,12"
                                            Background="#0F172A" CornerRadius="8"
                                            BorderBrush="#2563EB" BorderThickness="1"
                                            Padding="16,12"
                                            Visibility="{Binding IsAssignDropdownOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <StackPanel>
                                            <TextBlock Text="Select Agents to Assign" FontSize="13" FontWeight="SemiBold" Foreground="#CBD5E1" Margin="0,0,0,10"/>
                                            <!-- Agent checkboxes bound to ClientModel.AgentSelectionItems -->
                                            <ItemsControl ItemsSource="{Binding AgentSelectionItems}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <CheckBox IsChecked="{Binding IsSelected}" Foreground="#CBD5E1" Margin="0,4,0,0" Cursor="Hand">
                                                            <TextBlock>
                                                                <Run Text="👤 "/>
                                                                <Run Text="{Binding Agent.FullName, Mode=OneWay}"/>
                                                                <Run Text=" (" Foreground="#64748B"/>
                                                                <Run Text="{Binding Agent.Username, Mode=OneWay}" Foreground="#64748B"/>
                                                                <Run Text=")" Foreground="#64748B"/>
                                                            </TextBlock>
                                                        </CheckBox>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Empty agents placeholder -->
                                            <TextBlock Text="No agent accounts found. Add users with 'User' role first."
                                                       FontSize="12" Foreground="#64748B" Margin="0,4,0,0"
                                                       Visibility="{Binding DataContext.HasNoAgents, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"/>

                                            <!-- Save button -->
                                            <Button Content="✓ Save Assignment"
                                                    Command="{Binding DataContext.SaveAgentAssignmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource PrimaryButtonStyle}"
                                                    Margin="0,12,0,0" Padding="14,7" HorizontalAlignment="Left"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- EXPANDED FILES AREA -->
                                    <Border Margin="16,0,16,14"
                                            Visibility="{Binding IsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <StackPanel>
                                            <Rectangle Height="1" Fill="#334155" Margin="0,0,0,12"/>

                                            <!-- Drop zone (shown when no files yet) -->
                                            <Border CornerRadius="8" Padding="20,30"
                                                    BorderBrush="#334155" BorderThickness="1"
                                                    Background="#0F172A"
                                                    HorizontalAlignment="Stretch"
                                                    Margin="0,0,0,10"
                                                    AllowDrop="True" Drop="ClientDropZone_Drop" Tag="{Binding}"
                                                    DragEnter="DropZone_DragEnter" DragLeave="DropZone_DragLeave"
                                                    x:Name="DropZoneBorder">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="📁" FontSize="28" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                                    <TextBlock Text="Drag &amp; drop a file here" FontSize="13" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="(.csv, .xlsx, .xls accepted)" FontSize="11" Foreground="#475569" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                                    <TextBlock Text="— or —" FontSize="11" Foreground="#475569" HorizontalAlignment="Center" Margin="0,8,0,8"/>
                                                    <Button Content="Browse File"
                                                            Command="{Binding DataContext.BrowseFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource SecondaryButtonStyle}"
                                                            Foreground="#CBD5E1" BorderBrush="#475569"
                                                            Padding="16,6" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Uploaded files list -->
                                            <ItemsControl ItemsSource="{Binding Files}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Style="{StaticResource FileRowStyle}">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>

                                                                <TextBlock Grid.Column="0" Text="📄" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>

                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding FileName}" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                                                                    <TextBlock FontSize="11" Foreground="#64748B">
                                                                        <Run Text="{Binding FileSize, Mode=OneWay}"/>
                                                                        <Run Text=" · "/>
                                                                        <Run Text="{Binding FormattedDate, Mode=OneWay}"/>
                                                                    </TextBlock>
                                                                </StackPanel>

                                                                <Border Grid.Column="2" Background="#0C2442" BorderBrush="#1D4ED8" BorderThickness="1"
                                                                        CornerRadius="8" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                                                                    <TextBlock FontSize="11" Foreground="#93C5FD">
                                                                        <Run Text="{Binding TotalLeads, Mode=OneWay, StringFormat={}{0:N0}}"/>
                                                                        <Run Text=" leads"/>
                                                                    </TextBlock>
                                                                </Border>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
