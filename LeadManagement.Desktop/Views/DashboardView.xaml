<UserControl x:Class="LeadManagement.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="750" d:DesignWidth="1050">

    <!-- Root grid: no outer ScrollViewer — only the activity list scrolls -->
    <Grid Margin="32,28,32,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- Row 0: Header -->
            <RowDefinition Height="Auto" />   <!-- Row 1: KPI Cards -->
            <RowDefinition Height="*"    />   <!-- Row 2: Activity Log (fills remaining space) -->
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════════
             Row 0 — Dashboard Header
             ═══════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Welcome, Administrator 👋"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="Live overview of leads, clients, system accounts, and recent administrator activity."
                           FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,4,0,0" />
            </StackPanel>

            <!-- Quick Action Buttons -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Import Leads (CSV)"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="ImportLeads"
                        Margin="0,0,10,0" />
                <Button Content="View Masterlist"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="LeadMasterlist" />
            </StackPanel>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════
             Row 1 — 3 KPI Summary Cards
             ═══════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1" Margin="0,0,0,28">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Card 1: Total Leads -->
            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="22,20">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="TOTAL LEADS"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <Border Background="#EFF6FF" CornerRadius="4" Padding="8,3" HorizontalAlignment="Right">
                            <TextBlock Text="👥 All Leads" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" />
                        </Border>
                    </Grid>
                    <TextBlock Text="{Binding TotalLeads}"
                               FontSize="32"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" Height="52" />

                </StackPanel>
            </Border>

            <!-- Card 2: Total Clients -->
            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="22,20">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="TOTAL CLIENTS"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <Border Background="#ECFDF5" CornerRadius="4" Padding="8,3" HorizontalAlignment="Right">
                            <TextBlock Text="📁 Managed" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" />
                        </Border>
                    </Grid>
                    <TextBlock Text="{Binding TotalClients}"
                               FontSize="32"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" Height="52" />
                     
                </StackPanel>
            </Border>

            <!-- Card 3: User Accounts -->
            <Border Grid.Column="4" Style="{StaticResource CardBorderStyle}" Padding="22,20">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="USER ACCOUNTS"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <Border Background="#FEF3C7" CornerRadius="4" Padding="8,3" HorizontalAlignment="Right">
                            <TextBlock Text="👤 System Users" FontSize="11" FontWeight="SemiBold" Foreground="#D97706" />
                        </Border>
                    </Grid>
                    <TextBlock Text="{Binding TotalUsers}"
                               FontSize="32"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" Height="52" />
                     
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════
             Row 2 — Recent Admin Activity Log (full-width)
             Card header is fixed; only the list scrolls.
             ═══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />  <!-- Fixed card header -->
                    <RowDefinition Height="*"    />  <!-- Scrollable list -->
                </Grid.RowDefinitions>

                <!-- Fixed Header & Refresh Button -->
                <Grid Grid.Row="0" Margin="0,0,0,18">
                    <StackPanel HorizontalAlignment="Left">
                        <TextBlock Text="Recent Admin Activity Log"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="Showing latest 10 actions • Auto-pruned from frontend to database"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,2,0,0" />
                    </StackPanel>

                    <Button Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding RefreshDashboardCommand}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Padding="10,6"
                            Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⟳" FontSize="13" FontWeight="Bold" Margin="0,0,5,0" />
                            <TextBlock Text="Refresh Feed" FontSize="12" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Scrollable content area -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>

                        <!-- Empty State -->
                        <Border Background="#F8FAFC"
                                CornerRadius="8"
                                Padding="32,28"
                                HorizontalAlignment="Stretch">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasActivities}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="📝" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,8" />
                                <TextBlock Text="No admin activities recorded yet"
                                           FontWeight="SemiBold"
                                           FontSize="14"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="Recent imports, exports, deletions, client, and user actions will appear here."
                                           FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Activity Items -->
                        <ItemsControl ItemsSource="{Binding AdminActivities}">
                            <ItemsControl.Style>
                                <Style TargetType="ItemsControl">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasActivities}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.Style>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#F8FAFC"
                                            BorderBrush="#E2E8F0"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="14,12"
                                            Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Activity Badge -->
                                            <Border Grid.Column="0"
                                                    Background="{Binding BadgeBackground}"
                                                    CornerRadius="6"
                                                    Padding="8,5"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,14,0"
                                                    MinWidth="68">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <TextBlock Text="{Binding ActionIcon}" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding ActionBadgeText}"
                                                               FontSize="10"
                                                               FontWeight="Bold"
                                                               Foreground="{Binding BadgeForeground}"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>

                                            <!-- Description & Meta -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Description}"
                                                           FontWeight="SemiBold"
                                                           FontSize="13"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           TextWrapping="Wrap" />
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <TextBlock Text="{Binding AdminName, StringFormat='By {0}'}"
                                                               FontSize="11"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               FontWeight="Medium" />
                                                    <TextBlock Text="•"
                                                               FontSize="11"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               Margin="6,0" />
                                                    <TextBlock Text="{Binding DateFormatted}"
                                                               FontSize="11"
                                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Time Ago & Count Pill -->
                                            <StackPanel Grid.Column="2"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Right"
                                                        Margin="12,0,0,0">
                                                <TextBlock Text="{Binding TimeAgo}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           HorizontalAlignment="Right" />

                                                <!-- Record Count Pill -->
                                                <Border Background="#EFF6FF"
                                                        CornerRadius="4"
                                                        Padding="6,2"
                                                        Margin="0,4,0,0"
                                                        HorizontalAlignment="Right">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasCount}" Value="False">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding FormattedCount}"
                                                               FontSize="10"
                                                               FontWeight="Bold"
                                                               Foreground="{StaticResource PrimaryBrush}" />
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>
                </ScrollViewer>

            </Grid>
        </Border>

    </Grid>
</UserControl>
