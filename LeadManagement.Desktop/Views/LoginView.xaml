<UserControl x:Class="LeadManagement.Desktop.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000"
             Loaded="LoginView_Loaded">

    <Grid>
        <!-- Background image -->
        <Image Source="/Assets/vas-logo-term.jpg"
            Stretch="Fill"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Panel.ZIndex="0"/>

        <!-- Dark overlay -->
        <Border Background="#66000000" Panel.ZIndex="1"/>
    
        <!-- Login Card -->
        <Border HorizontalAlignment="Center"  
                VerticalAlignment="Center" 
                Style="{StaticResource CardBorderStyle}"
                Padding="36,40"
                Panel.ZIndex="2">

            <StackPanel>
                <!-- Brand / Logo Header -->
                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,24">
                    <Border 
                        CornerRadius="8"
                        Width="75"
                        Height="66"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,12"
                        ClipToBounds="True">

                        <Image Source="/Assets/vas-logo.jpg"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Stretch"
                           Stretch="UniformToFill" />
                    </Border>
                    <TextBlock Text="Leads Management System" 
                               FontSize="20" 
                               FontWeight="Bold" 
                               Foreground="{StaticResource TextPrimaryBrush}" 
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Sign in to access the system" 
                               FontSize="13" 
                               Foreground="{StaticResource TextSecondaryBrush}" 
                               HorizontalAlignment="Center" 
                               Margin="0,4,0,0" />
                </StackPanel>

                <!-- Info Banner -->
                <Border Background="#EFF6FF" 
                        BorderBrush="#BFDBFE" 
                        BorderThickness="1" 
                        CornerRadius="6" 
                        Padding="12,10" 
                        Margin="0,0,0,24">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Please enter your credentials to sign in." 
                                   FontSize="12" 
                                   Foreground="#1E40AF" 
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right"/>
                    </StackPanel>
                </Border>

                <!-- Error Message Banner (visible only when login fails) -->
                <Border Background="#FEF2F2" 
                        BorderBrush="#FECACA" 
                        BorderThickness="1" 
                        CornerRadius="6" 
                        Padding="12,10" 
                        Margin="0,0,0,16"
                        Visibility="{Binding HasLoginError, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⚠" 
                                   FontSize="14" 
                                   Foreground="#DC2626" 
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding LoginErrorMessage}" 
                                   FontSize="12" 
                                   Foreground="#DC2626" 
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Username Input -->
                <TextBlock Text="Username" 
                           FontSize="12" 
                           FontWeight="SemiBold" 
                           Foreground="{StaticResource TextPrimaryBrush}" 
                           Margin="0,0,0,6" />
                <TextBox Style="{StaticResource ModernTextBoxStyle}" 
                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" 
                         IsEnabled="{Binding IsLoggingIn, Converter={StaticResource InverseBoolConverter}}"
                         Margin="0,0,0,16" />

                <!-- Password Input -->
                <TextBlock Text="Password" 
                           FontSize="12" 
                           FontWeight="SemiBold" 
                           Foreground="{StaticResource TextPrimaryBrush}" 
                           Margin="0,0,0,6" />
                <PasswordBox x:Name="LoginPasswordBox" 
                             Style="{StaticResource ModernPasswordBoxStyle}" 
                             IsEnabled="{Binding IsLoggingIn, Converter={StaticResource InverseBoolConverter}}"
                             PasswordChanged="LoginPasswordBox_PasswordChanged"
                             Margin="0,0,0,24" />

                <!-- Sign In Action Button -->
                <Button Content="{Binding LoginButtonText}" 
                        Style="{StaticResource PrimaryButtonStyle}" 
                        Command="{Binding LoginCommand}" 
                        IsDefault="True"
                        IsEnabled="{Binding IsLoggingIn, Converter={StaticResource InverseBoolConverter}}"
                        Height="44" 
                        Margin="0,0,0,16" />

                <!-- Footnote -->
                <TextBlock Text="Virtual Assistant Services Outsourcing" 
                           FontSize="11" 
                           Foreground="{StaticResource TextSecondaryBrush}" 
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
