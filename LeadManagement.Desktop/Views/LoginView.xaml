<UserControl x:Class="LeadManagement.Desktop.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">

    <Grid Background="{StaticResource WindowBgBrush}">
        <!-- Subtle background pattern or glow -->
        <Border HorizontalAlignment="Center" 
                VerticalAlignment="Center" 
                Width="420"
                Style="{StaticResource CardBorderStyle}"
                Padding="36,40">
            
            <StackPanel>
                <!-- Brand / Logo Header -->
                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,24">
                    <Border Background="{StaticResource PrimaryBrush}" 
                            CornerRadius="8" 
                            Width="52" 
                            Height="52" 
                            HorizontalAlignment="Center"
                            Margin="0,0,0,12">
                        <TextBlock Text="LMS" 
                                   Foreground="White" 
                                   FontWeight="Bold" 
                                   FontSize="18" 
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Lead Management System" 
                               FontSize="20" 
                               FontWeight="Bold" 
                               Foreground="{StaticResource TextPrimaryBrush}" 
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Sign in to access your business pipeline" 
                               FontSize="13" 
                               Foreground="{StaticResource TextSecondaryBrush}" 
                               HorizontalAlignment="Center" 
                               Margin="0,4,0,0" />
                </StackPanel>

                <!-- Test Mode Notice Banner -->
                <Border Background="#EFF6FF" 
                        BorderBrush="#BFDBFE" 
                        BorderThickness="1" 
                        CornerRadius="6" 
                        Padding="12,10" 
                        Margin="0,0,0,24">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⚡" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Test Mode Active: Click Sign In below to enter directly." 
                                   FontSize="12" 
                                   Foreground="#1E40AF" 
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Username Input -->
                <TextBlock Text="Username / Email" 
                           FontSize="12" 
                           FontWeight="SemiBold" 
                           Foreground="{StaticResource TextPrimaryBrush}" 
                           Margin="0,0,0,6" />
                <TextBox Style="{StaticResource ModernTextBoxStyle}" 
                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" 
                         Margin="0,0,0,16" />

                <!-- Password Input -->
                <TextBlock Text="Password" 
                           FontSize="12" 
                           FontWeight="SemiBold" 
                           Foreground="{StaticResource TextPrimaryBrush}" 
                           Margin="0,0,0,6" />
                <PasswordBox x:Name="LoginPasswordBox" 
                             Style="{StaticResource ModernPasswordBoxStyle}" 
                             Password="••••••••"
                             Margin="0,0,0,24" />

                <!-- Sign In Action Button -->
                <Button Content="Sign In to Dashboard" 
                        Style="{StaticResource PrimaryButtonStyle}" 
                        Command="{Binding LoginCommand}" 
                        Height="44" 
                        Margin="0,0,0,16" />

                <!-- Footnote -->
                <TextBlock Text="Desktop Shell v1.0 • Running on .NET 10" 
                           FontSize="11" 
                           Foreground="{StaticResource TextSecondaryBrush}" 
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
