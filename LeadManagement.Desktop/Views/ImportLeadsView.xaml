<UserControl x:Class="LeadManagement.Desktop.Views.ImportLeadsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodels="clr-namespace:LeadManagement.Desktop.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=viewmodels:ImportLeadsViewModel, IsDesignTimeCreatable=True}"
             d:DesignHeight="850" d:DesignWidth="1200"
             FontFamily="{StaticResource AppFontFamily}">

    <!-- MASTER CONTAINER -->
    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Header & Actions (Fixed) -->
            <RowDefinition Height="Auto" /> <!-- Optional Success/Info Banner -->
            <RowDefinition Height="Auto" /> <!-- Upload Dropzone & Configuration Row (Fixed) -->
            <RowDefinition Height="*" />    <!-- Live Data Preview Table (Scrollable inside) -->
        </Grid.RowDefinitions>

        <!-- ========================================== -->
        <!-- ROW 0: PAGE HEADER & PRIMARY ACTION BUTTONS -->
        <!-- ========================================== -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Page Title -->
            <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Import Leads" 
                               FontSize="24" 
                               FontWeight="Bold" 
                               Foreground="{StaticResource TextPrimaryBrush}" 
                               VerticalAlignment="Center" />
                     
                </StackPanel>
                
                <TextBlock Text="Upload and validate external CSV or Excel spreadsheets before committing records to the central database." 
                           FontSize="13" 
                           Foreground="{StaticResource TextSecondaryBrush}" 
                           Margin="0,4,0,0" />
            </StackPanel>

            <!-- Header Quick Actions -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                 
                <Button Content="📂 Browse File..." 
                        Command="{Binding BrowseFileCommand}" 
                        Style="{StaticResource PrimaryButtonStyle}" 
                        Padding="16,8"
                        ToolTip="Choose a CSV or Excel file from your computer" />
            </StackPanel>
        </Grid>

        <!-- ========================================== -->
        <!-- ROW 1: SUCCESS / STATUS BANNER             -->
        <!-- ========================================== -->
        <Border Grid.Row="1" 
                CornerRadius="8" 
                BorderThickness="1" 
                Padding="16,12" 
                Margin="0,0,0,16">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#ECFDF5" />
                    <Setter Property="BorderBrush" Value="#A7F3D0" />
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSuccessBannerVisible}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsBannerError}" Value="True">
                            <Setter Property="Background" Value="#FEF2F2" />
                            <Setter Property="BorderBrush" Value="#FECACA" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusMessage}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#065F46" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBannerError}" Value="True">
                                        <Setter Property="Foreground" Value="#DC2626" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <!-- Dismiss Button -->
                <Button Grid.Column="1" 
                        Content="✕" 
                        Command="{Binding DismissBannerCommand}" 
                        Background="Transparent" 
                        BorderBrush="Transparent" 
                        Foreground="#64748B" 
                        FontSize="12" 
                        FontWeight="Bold" 
                        Cursor="Hand" 
                        Padding="4,2" 
                        VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- ======================================================== -->
        <!-- ROW 2: FILE STATUS / DROPZONE & BATCH CONFIGURATION CARD -->
        <!-- ======================================================== -->
        <Grid Grid.Row="2" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*" /> <!-- Dropzone / File Summary -->
                <ColumnDefinition Width="1.6*" /> <!-- Configuration & Health Checks -->
            </Grid.ColumnDefinitions>

            <!-- Card A: Dropzone & File Info -->
            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="18" Margin="0,0,14,0">
                <Grid>
                    <!-- State 1: When No File is Loaded -->
                    <Border BorderBrush="#CBD5E1" 
                            BorderThickness="1.5" 
                            CornerRadius="8" 
                            Background="#F8FAFC" 
                            Padding="20"
                            Cursor="Hand">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFileLoaded}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Background="#EFF6FF" CornerRadius="20" Width="44" Height="44" HorizontalAlignment="Center" Margin="0,0,0,10">
                                <TextBlock Text="📁" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Drag and drop your spreadsheet here" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="Supports .CSV, .XLSX, and .XLS up to 50MB" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,10" />
                            <Button Content="Choose File" Command="{Binding BrowseFileCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="14,6" FontSize="12" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- State 2: When File IS Loaded -->
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFileLoaded}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        
                        <StackPanel>
                            <!-- File Status Header -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="#1E293B" CornerRadius="6" Width="32" Height="32" Margin="0,0,10,0">
                                        <TextBlock Text="📄" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FileName}" FontWeight="Bold" FontSize="13.5" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="{Binding FileSizeDisplay}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </StackPanel>

                                <Button Grid.Column="1" 
                                        Content="✕ Remove" 
                                        Command="{Binding ClearFileCommand}" 
                                        Style="{StaticResource SecondaryButtonStyle}" 
                                        Padding="10,4" 
                                        FontSize="11"
                                        ToolTip="Remove current file" />
                            </Grid>

                            <!-- Path Pill -->
                            <Border Background="#F1F5F9" CornerRadius="6" Padding="10,6" Margin="0,0,0,12">
                                <TextBlock Text="{Binding SelectedFilePath}" 
                                           FontSize="11" 
                                           Foreground="#64748B" 
                                           TextTrimming="CharacterEllipsis" 
                                           ToolTip="{Binding SelectedFilePath}" />
                            </Border>

                            <!-- Status Badge -->
                            <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="6" Padding="10,6">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="● " Foreground="#059669" FontSize="11" VerticalAlignment="Center" />
                                    <TextBlock Text="Structure Verified • Ready for Preview &amp; Import" FontSize="11.5" Foreground="#065F46" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Card B: Import Settings & Health Check Metrics -->
            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Top: Settings Options -->
                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Option 1: Duplicate Rule -->
                         

                        <!-- Option 2: Default Lead Status -->
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="INITIAL STATUS" FontSize="10.5" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,5" />
                            <ComboBox ItemsSource="{Binding Statuses}" 
                                      SelectedItem="{Binding DefaultStatus}" 
                                      Style="{StaticResource ModernComboBoxStyle}" 
                                      ToolTip="Initial pipeline status assigned to newly imported leads" Height="43" />
                        </StackPanel>

                        <!-- Option 3: Batch Name Tag -->
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="BATCH NAME" FontSize="10.5" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,5" />
                            <TextBox Text="{Binding BatchName, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource ModernTextBoxStyle}" 
                                     Height="43" 
                                     ToolTip="Identifier tag for this import batch" />
                        </StackPanel>

                    </Grid>

                    <!-- Bottom: Health Check Metric Tiles -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Metric 1: Total Detected Rows -->
                        <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="TOTAL LEADS" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" />
                                <TextBlock Text="{Binding TotalRows}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>

                         
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ============================================================== -->
        <!-- ROW 3: LIVE DATA PREVIEW TABLE (Fixed in page, scrollable)    -->
        <!-- ============================================================== -->
        <Border Grid.Row="3" 
                Style="{StaticResource CardBorderStyle}" 
                Padding="0" 
                ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- Preview Header & Action Bar -->
                    <RowDefinition Height="*" />    <!-- Scrollable Table -->
                    <RowDefinition Height="Auto" /> <!-- Commit Action Footer -->
                </Grid.RowDefinitions>

                <!-- Preview Header & Bar -->
                <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="16,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📋 Live Data Preview" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <Border Background="#E0F2FE" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="10" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ShowingRowsText}" FontSize="11" Foreground="#0284C7" FontWeight="SemiBold" />
                            </Border>
                            <TextBlock Text="• Inspect columns below to ensure data aligns properly" FontSize="12" Foreground="#64748B" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
 
                    </Grid>
                </Border>

                <!-- Live Data Table -->
                <DataGrid Grid.Row="1" 
                          ItemsSource="{Binding FilteredPreviewRecords}" 
                          Style="{StaticResource ModernDataGridStyle}"
                          GridLinesVisibility="None"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto">
                    <DataGrid.Columns>

                        <!-- Status Badge -->
                        <DataGridTemplateColumn Header="STATUS" Width="120" CanUserSort="True" SortMemberPath="Status">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="12" Padding="10,4" BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#EFF6FF" />
                                                <Setter Property="BorderBrush" Value="#BFDBFE" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Qualified">
                                                        <Setter Property="Background" Value="#ECFDF5" />
                                                        <Setter Property="BorderBrush" Value="#A7F3D0" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Follow-up">
                                                        <Setter Property="Background" Value="#FFFBEB" />
                                                        <Setter Property="BorderBrush" Value="#FDE68A" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Contacted">
                                                        <Setter Property="Background" Value="#F5F3FF" />
                                                        <Setter Property="BorderBrush" Value="#DDD6FE" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#1D4ED8" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Qualified">
                                                            <Setter Property="Foreground" Value="#047857" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Follow-up">
                                                            <Setter Property="Foreground" Value="#B45309" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Contacted">
                                                            <Setter Property="Foreground" Value="#6D28D9" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Column A: Business Name -->
                        <DataGridTemplateColumn Header="BUSINESS NAME" Width="220" CanUserSort="True" SortMemberPath="BusinessName">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding BusinessName}" 
                                               FontWeight="SemiBold" 
                                               Foreground="{StaticResource TextPrimaryBrush}" 
                                               FontSize="12.5" 
                                               VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Column B: Address -->
                        <DataGridTextColumn Header="ADDRESS" 
                                            Binding="{Binding Address}" 
                                            Width="190" 
                                            CanUserSort="True" />

                        <!-- Column C: City -->
                        <DataGridTextColumn Header="CITY" 
                                            Binding="{Binding City}" 
                                            Width="125" 
                                            CanUserSort="True" />

                        <!-- Column D: County -->
                        <DataGridTextColumn Header="COUNTY" 
                                            Binding="{Binding County}" 
                                            Width="125" 
                                            CanUserSort="True" />

                        <!-- Column E: State -->
                        <DataGridTextColumn Header="STATE" 
                                            Binding="{Binding State}" 
                                            Width="75" 
                                            CanUserSort="True" />

                        <!-- Column F: Zip Code -->
                        <DataGridTextColumn Header="ZIP CODE" 
                                            Binding="{Binding ZipCode}" 
                                            Width="95" 
                                            CanUserSort="True" />

                        <!-- Column G: Cell Number -->
                        <DataGridTemplateColumn Header="CELL NUMBER" Width="140" CanUserSort="True" SortMemberPath="CellNumber">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="📞 " FontSize="10" Foreground="#64748B" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding FormattedPhone}" 
                                                   FontFamily="Consolas, Segoe UI" 
                                                   Foreground="{StaticResource TextPrimaryBrush}" 
                                                   FontSize="12" 
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Column H: FAX -->
                        <DataGridTextColumn Header="FAX" 
                                            Binding="{Binding Fax}" 
                                            Width="110" 
                                            CanUserSort="True" />

                        <!-- Column I: Annual Sales -->
                        <DataGridTextColumn Header="ANNUAL SALES" 
                                            Binding="{Binding AnnualSales}" 
                                            Width="145" 
                                            CanUserSort="True" />

                        <!-- Column J: Number Of Employee -->
                        <DataGridTextColumn Header="NUMBER OF EMPLOYEE" 
                                            Binding="{Binding NumberOfEmployees}" 
                                            Width="165" 
                                            CanUserSort="True" />

                        <!-- Column K: Title -->
                        <DataGridTextColumn Header="TITLE" 
                                            Binding="{Binding Title}" 
                                            Width="150" 
                                            CanUserSort="True" />

                        <!-- Column L: Contact Name -->
                        <DataGridTextColumn Header="CONTACT NAME" 
                                            Binding="{Binding ContactName}" 
                                            Width="180" 
                                            CanUserSort="True" />

                        <!-- Column M: Website -->
                        <DataGridTemplateColumn Header="WEBSITE" Width="160" CanUserSort="True" SortMemberPath="Website">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock VerticalAlignment="Center">
                                        <Hyperlink Foreground="#2563EB" TextDecorations="None">
                                            <TextBlock Text="{Binding Website}" FontSize="12" />
                                        </Hyperlink>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Website}" Value="">
                                                        <Setter Property="Text" Value="—" />
                                                        <Setter Property="Foreground" Value="#94A3B8" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Website}" Value="{x:Null}">
                                                        <Setter Property="Text" Value="—" />
                                                        <Setter Property="Foreground" Value="#94A3B8" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Column N: SIC Code -->
                        <DataGridTextColumn Header="SIC CODE" 
                                            Binding="{Binding SicCode}" 
                                            Width="110" 
                                            CanUserSort="True" />

                        <!-- Column O: SIC Description -->
                        <DataGridTextColumn Header="SIC DESCRIPTION" 
                                            Binding="{Binding SicDescription}" 
                                            Width="200" 
                                            CanUserSort="True" />

                        <!-- Column P: NAICS Code -->
                        <DataGridTextColumn Header="NAICS CODE" 
                                            Binding="{Binding NaicsCode}" 
                                            Width="110" 
                                            CanUserSort="True" />

                        <!-- Column Q: NAICS Description -->
                        <DataGridTextColumn Header="NAICS DESCRIPTION" 
                                            Binding="{Binding NaicsDescription}" 
                                            Width="220" 
                                            CanUserSort="True" />

                    </DataGrid.Columns>
                </DataGrid>

                <!-- Footer Commit Bar -->
                <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="18,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Ready to commit batch to database" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="Leads will be assigned to the masterlist and logged under Import History." FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="✕ Cancel" 
                                    Command="{Binding ClearFileCommand}" 
                                    IsEnabled="{Binding IsImporting, Converter={StaticResource InverseBoolConverter}}"
                                    Style="{StaticResource SecondaryButtonStyle}" 
                                    Padding="16,9" 
                                    Margin="0,0,10,0" />

                            <Button Content="{Binding CommitButtonText}" 
                                    Command="{Binding CommitImportCommand}" 
                                    IsEnabled="{Binding CanCommit}"
                                    Style="{StaticResource PrimaryButtonStyle}" 
                                    Padding="22,9" 
                                    FontWeight="SemiBold"
                                    FontSize="13" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

    </Grid>
</UserControl>
