<UserControl x:Class="LeadManagement.Desktop.Views.ImportHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodels="clr-namespace:LeadManagement.Desktop.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=viewmodels:ImportHistoryViewModel, IsDesignTimeCreatable=True}"
             d:DesignHeight="850" d:DesignWidth="1200"
             FontFamily="{StaticResource AppFontFamily}">

    <!-- MASTER CONTAINER -->
    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Header & Global Actions (Fixed) -->
            <RowDefinition Height="Auto" /> <!-- Search & Stats Bar (Fixed) -->
            <RowDefinition Height="*" />    <!-- Content Area: Batches Table + Collapsible Preview -->
        </Grid.RowDefinitions>

        <!-- ========================================== -->
        <!-- ROW 0: PAGE HEADER & REFRESH ACTION        -->
        <!-- ========================================== -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Page Title & Dynamic Summary Badge -->
            <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Import History" 
                               FontSize="24" 
                               FontWeight="Bold" 
                               Foreground="{StaticResource TextPrimaryBrush}" 
                               VerticalAlignment="Center" />

                    <!-- Dynamic Batches / Leads Summary Badge -->
                    <Border Background="#E0F2FE" 
                            BorderBrush="#BAE6FD" 
                            BorderThickness="1" 
                            CornerRadius="10" 
                            Padding="10,3" 
                            Margin="14,0,0,0" 
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding ShowingBatchesText}" 
                                   FontSize="11.5" 
                                   Foreground="#0284C7" 
                                   FontWeight="SemiBold" />
                    </Border>
                </StackPanel>

                <TextBlock Text="Audit log and batch transaction history of all imported spreadsheets and leads." 
                           FontSize="13" 
                           Foreground="{StaticResource TextSecondaryBrush}" 
                           Margin="0,4,0,0" />
            </StackPanel>

            <!-- Top Actions -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="⟳ Refresh" 
                        Command="{Binding RefreshCommand}" 
                        Style="{StaticResource SecondaryButtonStyle}" 
                        Padding="14,8" 
                        ToolTip="Reload import batches from database" />
            </StackPanel>
        </Grid>

        <!-- ========================================== -->
        <!-- ROW 1: SEARCH BAR CARD                     -->
        <!-- ========================================== -->
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="16,12" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Search Input with Search Icon & Placeholder -->
                <Grid Grid.Column="0" Margin="0,0,12,0">
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource ModernTextBoxStyle}" 
                             Padding="36,9,12,9" />

                    <!-- Search Icon -->
                    <TextBlock Text="🔍" 
                               Foreground="#94A3B8" 
                               FontSize="13" 
                               VerticalAlignment="Center" 
                               HorizontalAlignment="Left" 
                               Margin="12,0,0,0" 
                               IsHitTestVisible="False" />

                    <!-- Ghost Placeholder Text -->
                    <TextBlock Text="Search by batch name, filename, initial status, or user..." 
                               Foreground="#94A3B8" 
                               FontSize="13" 
                               VerticalAlignment="Center" 
                               Margin="38,0,0,0" 
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SearchText}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SearchText}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <!-- Reset Search Button -->
                <Button Grid.Column="1" 
                        Content="✕ Reset" 
                        Command="{Binding ClearSearchCommand}" 
                        Style="{StaticResource SecondaryButtonStyle}" 
                        Padding="12,8" 
                        ToolTip="Clear search filter" />
            </Grid>
        </Border>

        <!-- ============================================================== -->
        <!-- ROW 2: BATCHES DATA TABLE + COLLAPSIBLE PREVIEW SECTION        -->
        <!-- ============================================================== -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="220" /> <!-- Batches Table -->
                <RowDefinition Height="Auto" />              <!-- Collapsible Preview Drawer -->
            </Grid.RowDefinitions>

            <!-- 1. BATCHES TABLE -->
            <Border Grid.Row="0" 
                    Style="{StaticResource CardBorderStyle}" 
                    Padding="0" 
                    ClipToBounds="True">
                <DataGrid ItemsSource="{Binding FilteredBatches}" 
                          SelectedItem="{Binding SelectedBatch, Mode=TwoWay}"
                          Style="{StaticResource ModernDataGridStyle}"
                          GridLinesVisibility="None"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto" SelectionChanged="DataGrid_SelectionChanged">
                    <DataGrid.Columns>


                        <!-- Batch Name -->
                        <DataGridTemplateColumn Header="BATCH NAME" Width="260" CanUserSort="True" SortMemberPath="BatchName">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding BatchName}" 
                                               FontWeight="Bold" 
                                               Foreground="{StaticResource TextPrimaryBrush}" 
                                               FontSize="13" 
                                               VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Original File Name -->
                        <DataGridTemplateColumn Header="FILE NAME" Width="230" CanUserSort="True" SortMemberPath="FileName">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="📄 " FontSize="12" Foreground="#64748B" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding FileName}" 
                                                   FontSize="12" 
                                                   Foreground="{StaticResource TextPrimaryBrush}" 
                                                   TextTrimming="CharacterEllipsis" 
                                                   ToolTip="{Binding FileName}" 
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Total Leads Badge -->
                        <DataGridTemplateColumn Header="TOTAL LEADS" Width="130" CanUserSort="True" SortMemberPath="TotalLeads">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#EFF6FF" 
                                            BorderBrush="#BFDBFE" 
                                            BorderThickness="1" 
                                            CornerRadius="10" 
                                            Padding="10,3" 
                                            HorizontalAlignment="Left" 
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FormattedTotalLeads}" 
                                                   FontSize="11.5" 
                                                   FontWeight="Bold" 
                                                   Foreground="#1D4ED8" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Initial Status -->
                        <DataGridTemplateColumn Header="INITIAL STATUS" Width="130" CanUserSort="True" SortMemberPath="InitialStatus">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="10" Padding="10,3" BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#EFF6FF" />
                                                <Setter Property="BorderBrush" Value="#BFDBFE" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding InitialStatus}" Value="Qualified">
                                                        <Setter Property="Background" Value="#ECFDF5" />
                                                        <Setter Property="BorderBrush" Value="#A7F3D0" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding InitialStatus}" Value="Follow-up">
                                                        <Setter Property="Background" Value="#FFFBEB" />
                                                        <Setter Property="BorderBrush" Value="#FDE68A" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding InitialStatus}" Value="Contacted">
                                                        <Setter Property="Background" Value="#F5F3FF" />
                                                        <Setter Property="BorderBrush" Value="#DDD6FE" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding InitialStatus}" FontSize="11" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#1D4ED8" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding InitialStatus}" Value="Qualified">
                                                            <Setter Property="Foreground" Value="#047857" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding InitialStatus}" Value="Follow-up">
                                                            <Setter Property="Foreground" Value="#B45309" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding InitialStatus}" Value="Contacted">
                                                            <Setter Property="Foreground" Value="#6D28D9" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Imported By -->
                        <DataGridTemplateColumn Header="IMPORTED BY" Width="160" CanUserSort="True" SortMemberPath="ImportedByUsername">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="👤 " FontSize="11" Foreground="#64748B" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding ImportedByDisplay}" 
                                                   FontSize="12" 
                                                   Foreground="{StaticResource TextSecondaryBrush}" 
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Import Date -->
                        <DataGridTemplateColumn Header="IMPORT DATE" Width="180" CanUserSort="True" SortMemberPath="CreatedAt">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding FormattedDate}" 
                                               FontSize="12" 
                                               Foreground="{StaticResource TextSecondaryBrush}" 
                                               VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Row Actions: Preview, Export Excel, Delete -->
                        <DataGridTemplateColumn Header="ACTIONS" Width="290">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                                        <!-- Preview Button -->
                                        <Button Content="👁 Preview" 
                                                Command="{Binding DataContext.PreviewBatchCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                CommandParameter="{Binding}" 
                                                Style="{StaticResource SecondaryButtonStyle}" 
                                                Padding="10,5" 
                                                FontSize="11.5" 
                                                Margin="0,0,6,0" 
                                                ToolTip="Preview all lead records in this batch" />

                                        <!-- Export Batch to Excel Button -->
                                        <Button Content="⤓ Export" 
                                                Command="{Binding DataContext.ExportBatchCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                CommandParameter="{Binding}" 
                                                Padding="10,5" 
                                                FontSize="11.5" 
                                                Margin="0,0,6,0" 
                                                ToolTip="Export this batch and its leads to an Excel (.xlsx) file" >
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Foreground" Value="#2563EB" />
                                                    <Setter Property="Background" Value="#EFF6FF" />
                                                    <Setter Property="BorderBrush" Value="#BFDBFE" />
                                                    <Setter Property="BorderThickness" Value="1" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="btnBorder" 
                                                                        Background="{TemplateBinding Background}" 
                                                                        BorderBrush="{TemplateBinding BorderBrush}" 
                                                                        BorderThickness="{TemplateBinding BorderThickness}" 
                                                                        CornerRadius="6" 
                                                                        Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="btnBorder" Property="Background" Value="#DBEAFE" />
                                                                        <Setter TargetName="btnBorder" Property="BorderBrush" Value="#60A5FA" />
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </Button.Style>
                                            </Button>

                                        <!-- Delete Batch Button -->
                                        <Button Content="🗑 Delete" 
                                                Command="{Binding DataContext.DeleteBatchCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                CommandParameter="{Binding}" 
                                                Padding="10,5" 
                                                FontSize="11.5" 
                                                Cursor="Hand"
                                                ToolTip="Delete this batch and all its leads from the database">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Foreground" Value="#DC2626" />
                                                    <Setter Property="Background" Value="#FEF2F2" />
                                                    <Setter Property="BorderBrush" Value="#FECACA" />
                                                    <Setter Property="BorderThickness" Value="1" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="btnBorder" 
                                                                        Background="{TemplateBinding Background}" 
                                                                        BorderBrush="{TemplateBinding BorderBrush}" 
                                                                        BorderThickness="{TemplateBinding BorderThickness}" 
                                                                        CornerRadius="6" 
                                                                        Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="btnBorder" Property="Background" Value="#FEE2E2" />
                                                                        <Setter TargetName="btnBorder" Property="BorderBrush" Value="#F87171" />
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- ============================================================== -->
            <!-- 2. COLLAPSIBLE PREVIEW SECTION (Visible when IsPreviewOpen)   -->
            <!-- ============================================================== -->
            <Border Grid.Row="1" 
                    Margin="0,16,0,0" 
                    MaxHeight="360" 
                    Style="{StaticResource CardBorderStyle}" 
                    Padding="0" 
                    ClipToBounds="True"
                    Visibility="{Binding IsPreviewOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- Preview Header Toolbar -->
                        <RowDefinition Height="*" />    <!-- Scrollable Leads DataGrid -->
                    </Grid.RowDefinitions>

                    <!-- Preview Header Toolbar -->
                    <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="16,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Left: Batch Title & Record Count -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📋 " FontSize="14" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding PreviewHeaderTitle}" 
                                           FontWeight="Bold" 
                                           FontSize="13.5" 
                                           Foreground="{StaticResource TextPrimaryBrush}" 
                                           VerticalAlignment="Center" />

                                <Border Background="#E0F2FE" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="10" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding PreviewRowsText}" FontSize="11" Foreground="#0284C7" FontWeight="SemiBold" />
                                </Border>
                            </StackPanel>

                            <!-- Right: Quick Actions (Export this batch & Close) -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                 

                                <!-- Close Button -->
                                <Button Content="✕ Close Preview" 
                                        Command="{Binding ClosePreviewCommand}" 
                                        Style="{StaticResource SecondaryButtonStyle}" 
                                        Padding="12,6" 
                                        FontSize="11.5" 
                                        FontWeight="SemiBold" 
                                        ToolTip="Close preview section" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Preview Leads Table (All 18 lead columns) -->
                    <DataGrid Grid.Row="1" 
                              ItemsSource="{Binding FilteredPreviewLeads}" 
                              Style="{StaticResource ModernDataGridStyle}" 
                              GridLinesVisibility="None" 
                              VerticalScrollBarVisibility="Auto" 
                              HorizontalScrollBarVisibility="Auto"
                              MinHeight="180">
                        <DataGrid.Columns>

                            <!-- Status -->
                            <DataGridTemplateColumn Header="STATUS" Width="120" CanUserSort="True" SortMemberPath="Status">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="12" Padding="10,4" BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#EFF6FF" />
                                                    <Setter Property="BorderBrush" Value="#BFDBFE" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Qualified">
                                                            <Setter Property="Background" Value="#ECFDF5" />
                                                            <Setter Property="BorderBrush" Value="#A7F3D0" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Follow-up">
                                                            <Setter Property="Background" Value="#FFFBEB" />
                                                            <Setter Property="BorderBrush" Value="#FDE68A" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Contacted">
                                                            <Setter Property="Background" Value="#F5F3FF" />
                                                            <Setter Property="BorderBrush" Value="#DDD6FE" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#1D4ED8" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Qualified">
                                                                <Setter Property="Foreground" Value="#047857" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Follow-up">
                                                                <Setter Property="Foreground" Value="#B45309" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Contacted">
                                                                <Setter Property="Foreground" Value="#6D28D9" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Business Name -->
                            <DataGridTemplateColumn Header="BUSINESS NAME" Width="220" CanUserSort="True" SortMemberPath="BusinessName">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding BusinessName}" 
                                                   FontWeight="SemiBold" 
                                                   Foreground="{StaticResource TextPrimaryBrush}" 
                                                   FontSize="12.5" 
                                                   VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Address -->
                            <DataGridTextColumn Header="ADDRESS" Binding="{Binding Address}" Width="190" CanUserSort="True" />

                            <!-- City -->
                            <DataGridTextColumn Header="CITY" Binding="{Binding City}" Width="125" CanUserSort="True" />

                            <!-- County -->
                            <DataGridTextColumn Header="COUNTY" Binding="{Binding County}" Width="125" CanUserSort="True" />

                            <!-- State -->
                            <DataGridTextColumn Header="STATE" Binding="{Binding State}" Width="75" CanUserSort="True" />

                            <!-- Zip Code -->
                            <DataGridTextColumn Header="ZIP CODE" Binding="{Binding ZipCode}" Width="95" CanUserSort="True" />

                            <!-- Cell Number -->
                            <DataGridTemplateColumn Header="CELL NUMBER" Width="140" CanUserSort="True" SortMemberPath="CellNumber">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="📞 " FontSize="10" Foreground="#64748B" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding FormattedPhone}" 
                                                       FontFamily="Consolas, Segoe UI" 
                                                       Foreground="{StaticResource TextPrimaryBrush}" 
                                                       FontSize="12" 
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- FAX -->
                            <DataGridTextColumn Header="FAX" Binding="{Binding Fax}" Width="110" CanUserSort="True" />

                            <!-- Annual Sales -->
                            <DataGridTextColumn Header="ANNUAL SALES" Binding="{Binding AnnualSales}" Width="145" CanUserSort="True" />

                            <!-- Number Of Employee -->
                            <DataGridTextColumn Header="NUMBER OF EMPLOYEE" Binding="{Binding NumberOfEmployees}" Width="165" CanUserSort="True" />

                            <!-- Title -->
                            <DataGridTextColumn Header="TITLE" Binding="{Binding Title}" Width="150" CanUserSort="True" />

                            <!-- Contact Name -->
                            <DataGridTextColumn Header="CONTACT NAME" Binding="{Binding ContactName}" Width="180" CanUserSort="True" />

                            <!-- Website -->
                            <DataGridTemplateColumn Header="WEBSITE" Width="160" CanUserSort="True" SortMemberPath="Website">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid VerticalAlignment="Center">
                                            <TextBlock x:Name="LinkBlock" FontSize="12" TextTrimming="CharacterEllipsis">
                                                <Hyperlink Foreground="#2563EB" TextDecorations="None">
                                                    <Run Text="{Binding Website}" />
                                                </Hyperlink>
                                            </TextBlock>
                                            <TextBlock x:Name="DashBlock" Text="—" Foreground="#94A3B8" FontSize="12" Visibility="Collapsed" />
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Website}" Value="">
                                                <Setter TargetName="LinkBlock" Property="Visibility" Value="Collapsed" />
                                                <Setter TargetName="DashBlock" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Website}" Value="{x:Null}">
                                                <Setter TargetName="LinkBlock" Property="Visibility" Value="Collapsed" />
                                                <Setter TargetName="DashBlock" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- SIC Code -->
                            <DataGridTextColumn Header="SIC CODE" Binding="{Binding SicCode}" Width="110" CanUserSort="True" />

                            <!-- SIC Description -->
                            <DataGridTextColumn Header="SIC DESCRIPTION" Binding="{Binding SicDescription}" Width="200" CanUserSort="True" />

                            <!-- NAICS Code -->
                            <DataGridTextColumn Header="NAICS CODE" Binding="{Binding NaicsCode}" Width="110" CanUserSort="True" />

                            <!-- NAICS Description -->
                            <DataGridTextColumn Header="NAICS DESCRIPTION" Binding="{Binding NaicsDescription}" Width="220" CanUserSort="True" />

                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</UserControl>
