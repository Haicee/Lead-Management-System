<Window x:Class="LeadManagement.Desktop.Views.ScriptViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Client Calling Script"
        Height="680" Width="800"
        MinHeight="400" MinWidth="520"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource AppFontFamily}"
        Background="#F8FAFC">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Toolbar (Font controls, Copy, Pin, Search) -->
            <RowDefinition Height="*"/>    <!-- Script Content -->
            <RowDefinition Height="Auto"/> <!-- Status Footer -->
        </Grid.RowDefinitions>

        <!-- 1. HEADER -->
        <Border Grid.Row="0" Background="#0F172A" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#1E293B" CornerRadius="8" Width="38" Height="38" Margin="0,0,12,0">
                    <TextBlock Text="📄" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtClientTitle" Text="Client Calling Script" FontSize="16" FontWeight="Bold" Foreground="White"/>
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <TextBlock x:Name="TxtFileName" Text="script.docx" FontSize="12" Foreground="#94A3B8"/>
                        <TextBlock Text=" • " FontSize="12" Foreground="#64748B" Margin="4,0"/>
                        <TextBlock x:Name="TxtFileSize" Text="12 KB" FontSize="12" Foreground="#94A3B8"/>
                        <TextBlock Text=" • " FontSize="12" Foreground="#64748B" Margin="4,0"/>
                        <TextBlock x:Name="TxtFileType" Text="DOCX" FontSize="12" Foreground="#38BDF8" FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>

                <!-- Window Actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton x:Name="BtnPinTop" Content="📌 Pin on Top"
                                  Checked="BtnPinTop_Checked" Unchecked="BtnPinTop_Unchecked"
                                  Background="#1E293B" Foreground="#E2E8F0" BorderBrush="#334155"
                                  Padding="10,6" Margin="0,0,8,0" Cursor="Hand" FontSize="12">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="bd" Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                                    CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#2563EB"/>
                                                    <Setter TargetName="bd" Property="BorderBrush" Value="#3B82F6"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. TOOLBAR -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <!-- Font Controls -->
                    <ColumnDefinition Width="Auto"/> <!-- Search Box -->
                    <ColumnDefinition Width="*"/>    <!-- Spacing -->
                    <ColumnDefinition Width="Auto"/> <!-- Action Buttons -->
                </Grid.ColumnDefinitions>

                <!-- Font size controls -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Text Size:" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Button Content="A-" Click="BtnFontDec_Click" Style="{StaticResource SecondaryButtonStyle}" Padding="8,4" FontSize="12" Margin="0,0,4,0"/>
                    <Border Background="#F1F5F9" CornerRadius="4" Padding="8,4" Margin="0,0,4,0">
                        <TextBlock x:Name="TxtFontSize" Text="14pt" FontSize="11.5" FontWeight="SemiBold" Foreground="#334155"/>
                    </Border>
                    <Button Content="A+" Click="BtnFontInc_Click" Style="{StaticResource SecondaryButtonStyle}" Padding="8,4" FontSize="12" Margin="0,0,16,0"/>
                </StackPanel>

                <!-- Quick Find -->
                <Border Grid.Column="1" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="6,2" VerticalAlignment="Center" Width="200">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🔍" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" Margin="4,0,6,0"/>
                        <TextBox Grid.Column="1" x:Name="TxtSearch" BorderThickness="0" Background="Transparent"
                                 FontSize="12" VerticalAlignment="Center" TextChanged="TxtSearch_TextChanged"/>
                        <Button Grid.Column="2" Content="✕" Click="BtnClearSearch_Click"
                                Background="Transparent" BorderThickness="0" Cursor="Hand" Foreground="#94A3B8"
                                FontSize="10" Padding="4,2"/>
                    </Grid>
                </Border>

                <!-- Action buttons -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Click="BtnCopy_Click" Style="{StaticResource SecondaryButtonStyle}" Padding="12,6" Margin="0,0,8,0" FontSize="12" ToolTip="Copy script text to clipboard">
                        <TextBlock Text="📋 Copy Script"/>
                    </Button>
                    <Button Click="BtnOpenExternal_Click" Style="{StaticResource SecondaryButtonStyle}" Padding="12,6" FontSize="12" ToolTip="Open in Word / Acrobat / Notepad if installed">
                        <TextBlock Text="📂 Open with App"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. SCRIPT VIEWER CONTENT -->
        <Border Grid.Row="2" Background="White" Margin="16,12" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1">
            <RichTextBox x:Name="TxtScriptBody"
                         IsReadOnly="True"
                         IsDocumentEnabled="True"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled"
                         FontSize="14"
                         FontFamily="Segoe UI, Inter, Arial"
                         Foreground="#0F172A"
                         Background="White"
                         BorderThickness="0"
                         Padding="24"
                         SelectionBrush="#93C5FD"/>
        </Border>

        <!-- 4. STATUS FOOTER -->
        <Border Grid.Row="3" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="16,8">
            <Grid>
                <TextBlock x:Name="TxtStatus" Text="Ready • You can resize or keep this window open while making calls."
                           FontSize="11.5" Foreground="#64748B" VerticalAlignment="Center"/>
                <Button Content="Close" Click="BtnClose_Click" Style="{StaticResource SecondaryButtonStyle}"
                        HorizontalAlignment="Right" Padding="14,4" FontSize="11.5"/>
            </Grid>
        </Border>
    </Grid>
</Window>

