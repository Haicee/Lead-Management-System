<UserControl x:Class="LeadManagement.Desktop.Views.UserManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodels="clr-namespace:LeadManagement.Desktop.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=viewmodels:UserManagementViewModel, IsDesignTimeCreatable=True}"
             d:DesignHeight="850" d:DesignWidth="1200"
             FontFamily="{StaticResource AppFontFamily}">

    <Grid Margin="24,20,24,20">
        <!-- BASE VIEWPORT -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Header & Quick Actions -->
                <RowDefinition Height="Auto" /> <!-- Status / Success Banner -->
                <RowDefinition Height="*" />    <!-- Users Table Card -->
            </Grid.RowDefinitions>

            <!-- ROW 0: HEADER & PRIMARY ACTIONS -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="User Management" 
                                   FontSize="24" 
                                   FontWeight="Bold" 
                                   Foreground="{StaticResource TextPrimaryBrush}" 
                                   VerticalAlignment="Center" />

                        <!-- Dynamic Counter Badge -->
                        <Border Background="#E0F2FE" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="10" Padding="10,3" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding UserCountText}" FontSize="11.5" Foreground="#0284C7" FontWeight="SemiBold" />
                        </Border>
                    </StackPanel>

                    <TextBlock Text="Create and manage user accounts, assign roles (Administrator or Standard Agent), and review access history." 
                               FontSize="13" 
                               Foreground="{StaticResource TextSecondaryBrush}" 
                               Margin="0,4,0,0" />
                </StackPanel>

                <!-- Actions -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="⟳ Refresh" 
                            Command="{Binding RefreshCommand}" 
                            Style="{StaticResource SecondaryButtonStyle}" 
                            Padding="14,8" 
                            Margin="0,0,10,0"
                            ToolTip="Reload user accounts from database" />

                    <Button Content="➕ Add New User" 
                            Command="{Binding OpenAddUserModalCommand}" 
                            Style="{StaticResource PrimaryButtonStyle}" 
                            Padding="16,8"
                            ToolTip="Create a new administrator or agent account" />
                </StackPanel>
            </Grid>

            <!-- ROW 1: STATUS BANNER -->
            <Border Grid.Row="1" 
                    CornerRadius="8" 
                    BorderThickness="1" 
                    Padding="16,12" 
                    Margin="0,0,0,16">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#ECFDF5" />
                        <Setter Property="BorderBrush" Value="#A7F3D0" />
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsStatusBannerVisible}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsBannerError}" Value="True">
                                <Setter Property="Background" Value="#FEF2F2" />
                                <Setter Property="BorderBrush" Value="#FECACA" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding StatusBannerMessage}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#065F46" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBannerError}" Value="True">
                                        <Setter Property="Foreground" Value="#DC2626" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Button Grid.Column="1" 
                            Content="✕" 
                            Command="{Binding DismissBannerCommand}" 
                            Background="Transparent" 
                            BorderBrush="Transparent" 
                            Foreground="#64748B" 
                            FontSize="12" 
                            FontWeight="Bold" 
                            Cursor="Hand" 
                            Padding="4,2" 
                            VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- ROW 2: USERS DATA TABLE -->
            <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="0" ClipToBounds="True">
                <DataGrid ItemsSource="{Binding Users}" 
                          Style="{StaticResource ModernDataGridStyle}"
                          GridLinesVisibility="None"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto">
                    <DataGrid.Columns>

                        <!-- Avatar / Full Name -->
                        <DataGridTemplateColumn Header="FULL NAME" Width="240" CanUserSort="True" SortMemberPath="FullName">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border CornerRadius="18" Width="32" Height="32" Background="#1E293B" Margin="0,0,10,0">
                                            <TextBlock Text="👤" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FullName}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding Username}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Username Column -->
                        <DataGridTextColumn Header="USERNAME" Binding="{Binding Username}" Width="150" CanUserSort="True" />

                        <!-- Email Column -->
                        <DataGridTextColumn Header="EMAIL ADDRESS" Binding="{Binding Email}" Width="230" CanUserSort="True" />

                        <!-- Role Badge -->
                        <DataGridTemplateColumn Header="ROLE" Width="170" CanUserSort="True" SortMemberPath="Role">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="12" Padding="10,4" BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <!-- Default for user -->
                                                <Setter Property="Background" Value="#EFF6FF" />
                                                <Setter Property="BorderBrush" Value="#BFDBFE" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAdmin}" Value="True">
                                                        <Setter Property="Background" Value="#F5F3FF" />
                                                        <Setter Property="BorderBrush" Value="#DDD6FE" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding RoleDisplay}" FontSize="11.5" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#1D4ED8" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAdmin}" Value="True">
                                                            <Setter Property="Foreground" Value="#6D28D9" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Status Badge -->
                        <DataGridTemplateColumn Header="STATUS" Width="120" CanUserSort="True" SortMemberPath="IsActive">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="10" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="● " Foreground="#059669" FontSize="10" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding StatusDisplay}" FontSize="11" FontWeight="SemiBold" Foreground="#065F46" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Last Login Date -->
                        <DataGridTemplateColumn Header="LAST LOGIN" Width="180" CanUserSort="True" SortMemberPath="LastLoginAt">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding FormattedLastLogin}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Created Date -->
                        <DataGridTemplateColumn Header="REGISTERED ON" Width="140" CanUserSort="True" SortMemberPath="CreatedAt">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding FormattedCreatedDate}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- ============================================================== -->
        <!-- MODAL DIALOG OVERLAY (Visible when IsAddUserModalOpen = True)  -->
        <!-- ============================================================== -->
        <Grid Visibility="{Binding IsAddUserModalOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
              Panel.ZIndex="100">
            <!-- Dark Backdrop -->
            <Border Background="#99000000" />

            <!-- Modal Content Card -->
            <Border Width="480" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center" 
                    Style="{StaticResource CardBorderStyle}" 
                    Padding="28" 
                    Background="White">
                <StackPanel>
                    <!-- Header -->
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Add New User Account" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="Create credentials for a team member or administrator." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0" />
                        </StackPanel>

                        <Button Grid.Column="1" 
                                Content="✕" 
                                Command="{Binding CloseAddUserModalCommand}" 
                                Background="Transparent" 
                                BorderBrush="Transparent" 
                                Foreground="#64748B" 
                                FontSize="14" 
                                FontWeight="Bold" 
                                Cursor="Hand" 
                                VerticalAlignment="Top" />
                    </Grid>

                    <!-- Error Banner -->
                    <Border Background="#FEF2F2" 
                            BorderBrush="#FECACA" 
                            BorderThickness="1" 
                            CornerRadius="6" 
                            Padding="12,8" 
                            Margin="0,0,0,16"
                            Visibility="{Binding HasFormError, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⚠" FontSize="13" Foreground="#DC2626" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding FormErrorMessage}" FontSize="12" Foreground="#DC2626" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Field 1: Full Name -->
                    <TextBlock Text="Full Name" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,5" />
                    <TextBox Text="{Binding NewFullName, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource ModernTextBoxStyle}" 
                             Margin="0,0,0,14" />

                    <!-- Field 2: Username -->
                    <TextBlock Text="Username" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,5" />
                    <TextBox Text="{Binding NewUsername, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource ModernTextBoxStyle}" 
                             Margin="0,0,0,14" />

                    <!-- Field 3: Email Address -->
                    <TextBlock Text="Email Address (Optional)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,5" />
                    <TextBox Text="{Binding NewEmail, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource ModernTextBoxStyle}" 
                             Margin="0,0,0,14" />

                    <!-- Field 4: Password -->
                    <TextBlock Text="Password" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,5" />
                    <TextBox Text="{Binding NewPassword, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource ModernTextBoxStyle}" 
                             Margin="0,0,0,14" />

                    <!-- Field 5: Role Picker -->
                    <TextBlock Text="Account Role" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,5" />
                    <ComboBox ItemsSource="{Binding AvailableRoles}" 
                              SelectedItem="{Binding NewRole}" 
                              Style="{StaticResource ModernComboBoxStyle}" 
                              Height="40" 
                              Margin="0,0,0,24" />

                    <!-- Modal Actions -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="1" 
                                Content="Cancel" 
                                Command="{Binding CloseAddUserModalCommand}" 
                                Style="{StaticResource SecondaryButtonStyle}" 
                                Padding="16,9" 
                                Margin="0,0,10,0" />

                        <Button Grid.Column="2" 
                                Content="{Binding SaveButtonText}" 
                                Command="{Binding CreateUserCommand}" 
                                Style="{StaticResource PrimaryButtonStyle}" 
                                Padding="20,9" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>

