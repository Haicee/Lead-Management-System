<UserControl x:Class="LeadManagement.Desktop.Controls.MultiSelectDropdown"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="36" d:DesignWidth="200">

    <Grid>
        <!-- Toggle Button: shows summary text and opens/closes the popup -->
        <ToggleButton x:Name="PART_ToggleButton"
                      IsChecked="{Binding IsDropdownOpen, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                      Height="36"
                      HorizontalContentAlignment="Stretch"
                      Padding="10,0"
                      Cursor="Hand">
            <ToggleButton.Style>
                <Style TargetType="ToggleButton">
                    <Setter Property="Background" Value="White" />
                    <Setter Property="BorderBrush" Value="#CBD5E1" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="6"
                                        Padding="{TemplateBinding Padding}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ContentPresenter Grid.Column="0"
                                                          HorizontalAlignment="Left"
                                                          VerticalAlignment="Center" />
                                        <!-- Chevron arrow -->
                                        <TextBlock Grid.Column="1"
                                                   Text="▾"
                                                   FontSize="10"
                                                   Foreground="#64748B"
                                                   VerticalAlignment="Center"
                                                   Margin="6,0,0,0" />
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="BorderBrush" Value="#94A3B8" />
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter Property="BorderBrush" Value="#2563EB" />
                                        <Setter Property="Background" Value="#EFF6FF" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ToggleButton.Style>

            <!-- Summary text shown on the button face -->
            <TextBlock x:Name="PART_SummaryText"
                       Text="{Binding SummaryText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       FontSize="13"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#64748B" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasSelection, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                <Setter Property="Foreground" Value="#1D4ED8" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </ToggleButton>

        <!-- Dropdown Popup -->
        <Popup x:Name="PART_Popup"
               IsOpen="{Binding IsDropdownOpen, RelativeSource={RelativeSource AncestorType=UserControl}}"
               PlacementTarget="{Binding ElementName=PART_ToggleButton}"
               Placement="Bottom"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade"
               MinWidth="{Binding ActualWidth, ElementName=PART_ToggleButton}"
               Opened="PART_Popup_Opened">

            <Border Background="White"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1"
                    CornerRadius="6"
                    Margin="0,2,0,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.12" Color="#000000" />
                </Border.Effect>

                <StackPanel>

                    <!-- Search Bar inside popup -->
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="8,7">
                        <Grid>
                            <!-- Search icon -->
                            <TextBlock Text="🔍"
                                       FontSize="11"
                                       Foreground="#94A3B8"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Left"
                                       Margin="6,0,0,0"
                                       IsHitTestVisible="False" />
                            <!-- Search TextBox -->
                            <TextBox x:Name="PART_SearchBox"
                                     Text="{Binding SearchText, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="8,6,8,6"
                                     FontSize="12.5"
                                     BorderBrush="#CBD5E1"
                                     BorderThickness="1"
                                     Background="White"
                                     Foreground="#1E293B">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="TextBox">
                                                    <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="5">
                                                        <ScrollViewer x:Name="PART_ContentHost"
                                                                      Margin="{TemplateBinding Padding}" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                            <!-- Ghost placeholder for search box -->
                            <TextBlock Text="Search..."
                                       Foreground="#94A3B8"
                                       FontSize="12.5"
                                       VerticalAlignment="Center"
                                       Margin="16,0,0,0"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SearchText, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SearchText, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <!-- Select All / Clear All toolbar -->
                    <Border Background="#FAFAFA" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="10,5">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="All" Click="SelectAll_Click"
                                    FontSize="11" Padding="6,2" Margin="0,0,6,0"
                                    Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#E2E8F0" />
                                        <Setter Property="Foreground" Value="#374151" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#CBD5E1" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="Clear" Click="ClearAll_Click"
                                    FontSize="11" Padding="6,2"
                                    Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#E2E8F0" />
                                        <Setter Property="Foreground" Value="#374151" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#CBD5E1" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <!-- Filtered count badge -->
                            <TextBlock x:Name="PART_FilteredCount"
                                       Text="{Binding FilteredCountText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                       FontSize="10.5"
                                       Foreground="#64748B"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Scrollable checklist (bound to filtered view) -->
                    <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="PART_ItemsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10,5" Background="Transparent" Cursor="Hand">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#F1F5F9" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  Content="{Binding Name}"
                                                  FontSize="12.5"
                                                  Foreground="#1E293B"
                                                  Cursor="Hand">
                                            <CheckBox.Style>
                                                <Style TargetType="CheckBox">
                                                    <Setter Property="Margin" Value="0" />
                                                </Style>
                                            </CheckBox.Style>
                                        </CheckBox>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Empty state: shown when search yields no results -->
                    <Border x:Name="PART_EmptyState" Padding="10,14" Visibility="Collapsed">
                        <TextBlock Text="No matches found"
                                   FontSize="12"
                                   Foreground="#94A3B8"
                                   HorizontalAlignment="Center" />
                    </Border>

                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
